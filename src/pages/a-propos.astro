---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const title = "À propos | Epicentre Séminaires";
const description = "Epicentre, agence événementielle dans la Plaine de l'Ain : production technique d'événements d'entreprise, héritée des grandes scènes lyonnaises.";

const breadcrumb = [
  { name: 'Accueil', url: '/' },
  { name: 'À propos' },
];
---

<Base title={title} description={description} zone="plaine">
  <section class="bg-plaine-deep text-bone py-24 md:py-32">
    <div class="container-wide">
      <Breadcrumb items={breadcrumb} variant="dark" />
      <h1 class="h1-hero-lg mt-6 max-w-4xl">
        Une agence, un territoire.
      </h1>
      <p class="mt-8 text-xl text-bone/70 max-w-2xl leading-relaxed">
        Epicentre est l'agence événementielle de la Plaine de l'Ain. Production technique pour les entreprises du bassin, du conseil au pilotage complet.
      </p>
    </div>
  </section>

  <!-- POSITIONNEMENT -->
  <section class="py-24 md:py-32 bg-bone">
    <div class="container-wide grid md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <p class="eyebrow">Le projet</p>
        <h2 class="h2-section-sm mt-6">
          Un acteur local capable de produire au niveau des plus grandes scènes.
        </h2>
      </div>
      <div class="md:col-span-7 md:col-start-6 space-y-8 text-lg leading-relaxed">
        <p>
          Epicentre est une agence événementielle ancrée dans la <strong>Plaine de l'Ain</strong>, entre Lyon et Genève. L'agence accompagne les entreprises du bassin sur leurs plénières, conventions, galas, lancements et congrès, en mobilisant la culture technique des grandes scènes lyonnaises du sport et du spectacle.
        </p>
        <p>
          La promesse tient en une phrase : un événement n'est jamais qu'un programme. C'est un dispositif technique vivant, où chaque détail compte. Un câble, un timing, une captation. C'est cette exigence qu'Epicentre apporte à chaque mission.
        </p>
      </div>
    </div>
  </section>

  <!-- ORIGINE -->
  <section class="bg-bone-soft py-24 md:py-32">
    <div class="container-wide grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <p class="eyebrow">L'origine</p>
        <h2 class="h2-section-sm mt-6">
          Des grandes scènes lyonnaises à votre événement local.
        </h2>
      </div>
      <div class="md:col-span-7 md:col-start-6 space-y-6 text-lg leading-relaxed">
        <p>
          Epicentre est née d'un constat de terrain : beaucoup d'entreprises de la Plaine de l'Ain et de l'est lyonnais font produire leurs événements par des agences extérieures, qui ne connaissent pas le bassin ni ses contraintes.
        </p>
        <p>
          L'idée : devenir l'acteur local capable de piloter ces productions à hauteur des standards techniques pratiqués sur les plus grandes scènes événementielles de l'agglomération lyonnaise, tout en restant ancré sur le territoire.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-plaine text-bone py-24 md:py-32">
    <div class="container-wide text-center max-w-3xl mx-auto">
      <h2 class="h2-section">
        Vous avez un événement à produire ?
      </h2>
      <p class="mt-8 text-bone/75 max-w-xl mx-auto leading-relaxed">
        Décrivez-nous votre projet : format, jauge, date pressentie. Nous revenons vers vous pour cadrer un échange.
      </p>
      <a href="/contact/" class="btn-bone mt-10 inline-flex">
        Demander un devis
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
