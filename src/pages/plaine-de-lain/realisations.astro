---
import Base from '@/layouts/Base.astro';

const title = "Notre approche | Epicentre Plaine de l'Ain";
const description = "Notre approche de la production événementielle : pilotage technique direct, scénographie sur-mesure, captation. Références sur demande.";

const cover = 'https://images.unsplash.com/photo-1530819568329-97653eafbbfa?w=2400&q=85&auto=format&fit=crop';

const typologies = [
  {
    type: 'Plénière & convention',
    description: 'Conventions internes, conventions commerciales, séminaires d\'intégration grand format avec scénographie complète.',
    chiffres: [
      { v: 'Scéno', l: 'sur-mesure' },
      { v: 'Multicam', l: 'captation + diffusion' },
      { v: 'Régie', l: 'pilotage direct' },
    ],
    img: 'https://images.unsplash.com/photo-1568084680786-a84f91d1153c?w=1600&q=85&auto=format&fit=crop',
  },
  {
    type: 'Gala & remise de prix',
    description: 'Cérémonies internes, remises de prix, dîners de gala scénographiés avec mise en lumière et show.',
    chiffres: [
      { v: 'Mise', l: 'en lumière' },
      { v: 'Show', l: 'intervention scénique' },
      { v: 'Captation', l: 'multicam HD/4K' },
    ],
    img: 'https://images.unsplash.com/photo-1559523182-a284c3fb7cff?w=1600&q=85&auto=format&fit=crop',
  },
  {
    type: 'Lancement de produit',
    description: 'Reveal scénographié, dispositif scénique sur-mesure, gestion presse, captation, diffusion live.',
    chiffres: [
      { v: 'Reveal', l: 'mise en scène produit' },
      { v: 'Presse', l: 'régionale & spécialisée' },
      { v: 'Live', l: 'streaming + replay' },
    ],
    img: 'https://images.unsplash.com/photo-1505236858219-8359eb29e329?w=1600&q=85&auto=format&fit=crop',
  },
  {
    type: 'Inauguration & événement institutionnel',
    description: 'Ouverture de site, livraison de bâtiment, événement institutionnel avec discours officiels.',
    chiffres: [
      { v: 'Officiel', l: 'protocole & presse' },
      { v: 'Captation', l: 'archive corporate' },
      { v: 'Cocktail', l: 'production complète' },
    ],
    img: 'https://images.unsplash.com/photo-1551038247-3d9af20df552?w=1600&q=85&auto=format&fit=crop',
  },
];
---

<Base title={title} description={description} zone="plaine">
  <section class="relative h-[55vh] min-h-[380px] overflow-hidden bg-plaine-deep">
    <img src={cover} alt="Production événementielle - plénière, scène, gala" class="absolute inset-0 w-full h-full object-cover opacity-50" />
    <div class="absolute inset-0 bg-gradient-to-b from-plaine-deep/30 to-plaine-deep"></div>
    <div class="relative z-10 h-full container-wide flex flex-col justify-end pb-16 text-bone">
      <p class="eyebrow text-bone/70 mb-4">Notre approche</p>
      <h1 class="text-4xl md:text-6xl max-w-4xl">Quatre typologies, une exigence.</h1>
    </div>
  </section>

  <section class="py-16 bg-bone">
    <div class="container-wide">
      <p class="text-ink/65 max-w-3xl text-lg leading-relaxed">
        Nous concentrons notre expertise sur quatre typologies de productions événementielles. Pour chacune, le même niveau d'exigence technique : issu d'un parcours sur les grandes scènes du sport et du spectacle français.
      </p>
      <p class="text-ink/50 max-w-3xl text-sm mt-6 italic">
        Nos références clients détaillées sont communiquées sur demande, dans le respect des accords de confidentialité signés avec chacun.
      </p>
    </div>
  </section>

  <section class="bg-bone-soft pb-24">
    <div class="container-wide space-y-12">
      {typologies.map((t, i) => (
        <article class={`grid md:grid-cols-12 gap-8 items-stretch bg-bone ${i % 2 ? 'md:[&>*:first-child]:order-2' : ''}`}>
          <div class="md:col-span-7 relative aspect-[16/10] md:aspect-auto overflow-hidden">
            <img src={t.img} alt={t.type} class="absolute inset-0 w-full h-full object-cover" />
          </div>
          <div class="md:col-span-5 p-8 md:p-10 flex flex-col justify-center">
            <p class="eyebrow">Typologie</p>
            <h2 class="text-3xl md:text-4xl mt-4 leading-tight">{t.type}</h2>
            <p class="mt-6 text-ink/70 leading-relaxed">{t.description}</p>
            <div class="mt-8 grid grid-cols-3 gap-4 border-t border-ink/10 pt-6">
              {t.chiffres.map((m) => (
                <div>
                  <p class="text-xl md:text-2xl font-semibold tracking-tight">{m.v}</p>
                  <p class="text-xs text-ink/50 mt-1">{m.l}</p>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-plaine text-bone py-24">
    <div class="container-wide text-center">
      <h2 class="text-4xl md:text-5xl">Vous reconnaissez votre projet dans une de ces typologies ?</h2>
      <p class="mt-6 text-bone/70 max-w-xl mx-auto">Échangeons sur votre format précis : nous vous transmettons des références similaires sous accord de confidentialité.</p>
      <a href="/plaine-de-lain/contact/" class="btn-bone mt-10 inline-flex">Demander un devis</a>
    </div>
  </section>
</Base>
