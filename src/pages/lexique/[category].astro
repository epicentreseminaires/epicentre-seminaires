---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { lexique, lexiqueCategories, slugify } from '@/data/lexique';

export async function getStaticPaths() {
  return lexiqueCategories.map((cat) => ({
    params: { category: slugify(cat) },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const entries = lexique.filter((l) => l.category === category);
const total = entries.length;

// Suggestion de catégories liées (3 voisines)
const otherCats = lexiqueCategories.filter((c) => c !== category).slice(0, 3);

const title = `Lexique ${category} événementiel FR / EN | ${total} termes | Epicentre`;
const description = `Lexique ${category.toLowerCase()} événementiel : ${total} termes bilingues français-anglais avec définitions. Référence du métier pour ${category.toLowerCase()} d'événement d'entreprise.`;

// Schema.org DefinedTermSet : tous les termes de la catégorie avec leur définition
const siteUrl = 'https://epicentre-seminaires.fr';
const pageUrl = `${siteUrl}/lexique/${slugify(category)}/`;
const definedTermSet = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': pageUrl,
  name: `Lexique ${category} événementiel`,
  description,
  url: pageUrl,
  inLanguage: ['fr', 'en'],
  hasDefinedTerm: entries.map((l) => ({
    '@type': 'DefinedTerm',
    '@id': `${pageUrl}#${slugify(l.fr)}`,
    name: l.fr,
    alternateName: l.en,
    description: l.definition,
    termCode: slugify(l.fr),
    inDefinedTermSet: pageUrl,
  })),
};
---
<Base title={title} description={description} zone="plaine" theme="light">
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSet)} />

  <div class="container-wide pt-28 md:pt-32 pb-2">
    <Breadcrumb
      items={[
        { name: 'Accueil', url: '/' },
        { name: 'Lexique', url: '/lexique/' },
        { name: category },
      ]}
      variant="light"
    />
  </div>

  <!-- HERO -->
  <section class="bg-bone pt-6 md:pt-8 pb-12 md:pb-16">
    <div class="container-wide max-w-4xl">
      <p class="eyebrow">Lexique · {category}</p>
      <h1 class="h1-hero">
        Lexique {category.toLowerCase()} <span class="text-gradient">événementiel.</span>
      </h1>
      <p class="mt-8 lead max-w-2xl">
        {total} termes bilingues français-anglais en {category.toLowerCase()}, avec définitions précises pour lire un devis et parler le métier.
      </p>
      <p class="mt-6 text-sm text-ink/55">
        {total} termes · catégorie {category} · ressource gratuite
      </p>
    </div>
  </section>

  <!-- BARRE DE RECHERCHE LOCALE -->
  <section class="sticky top-[72px] md:top-[80px] z-30 bg-bone-soft/95 backdrop-blur-md border-y border-ink/10">
    <div class="container-wide py-4 flex flex-col md:flex-row md:items-center gap-3">
      <div class="relative flex-1">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-4 top-1/2 -translate-y-1/2 text-ink/45">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.35-4.35" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          id="catSearch"
          placeholder={`Filtrer dans la catégorie ${category}…`}
          class="w-full pl-12 pr-4 py-3 bg-bone border border-ink/15 focus:outline-none focus:border-accent text-base transition-colors"
        />
      </div>
      <a href="/lexique/" class="text-xs uppercase tracking-[0.18em] text-ink/55 hover:text-accent whitespace-nowrap">
        ← Toutes les catégories
      </a>
    </div>
  </section>

  <!-- LISTE DES TERMES (avec ancres ID) -->
  <section class="bg-bone py-12 md:py-16">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-ink/10" id="catGrid">
        {entries.map((entry) => (
          <article
            id={slugify(entry.fr)}
            class="catEntry bg-bone p-6 md:p-7 scroll-mt-32"
            data-search={`${entry.fr.toLowerCase()} ${(entry.en ?? '').toLowerCase()} ${entry.definition.toLowerCase()}`}
          >
            <div class="flex items-baseline gap-3 flex-wrap">
              <h2 class="font-display text-xl md:text-2xl text-ink leading-tight tracking-tight">{entry.fr}</h2>
              {entry.en && <span class="text-sm text-ink/45 font-mono">/ {entry.en}</span>}
            </div>
            <p class="mt-4 text-sm text-ink/70 leading-relaxed">{entry.definition}</p>
            <a href={`#${slugify(entry.fr)}`} class="mt-4 inline-flex items-center gap-1 text-[0.65rem] uppercase tracking-[0.2em] text-ink/40 hover:text-accent transition-colors">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M10 14a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M14 10a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Lien direct
            </a>
          </article>
        ))}
      </div>

      <div id="catEmpty" class="hidden text-center py-24">
        <p class="text-ink/55">Aucun terme ne correspond à votre recherche.</p>
      </div>
    </div>
  </section>

  <!-- AUTRES CATÉGORIES (maillage interne fort) -->
  <section class="bg-bone-soft py-20 md:py-24 border-t border-ink/10">
    <div class="container-wide max-w-5xl">
      <p class="eyebrow">Continuer la lecture</p>
      <h2 class="h2-section-sm mt-6">
        Autres catégories du <span class="text-gradient">lexique.</span>
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-px bg-ink/10 mt-10">
        {lexiqueCategories.filter((c) => c !== category).map((cat) => {
          const count = lexique.filter((l) => l.category === cat).length;
          return (
            <a href={`/lexique/${slugify(cat)}/`} class="group bg-bone-soft hover:bg-bone p-5 md:p-6 transition-colors flex flex-col gap-2">
              <p class="text-sm md:text-base font-semibold text-ink">{cat}</p>
              <p class="text-xs text-ink/55">{count} termes</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-forest-gradient text-bone py-24 md:py-28">
    <div class="container-wide text-center max-w-3xl mx-auto">
      <p class="eyebrow text-bone/55">Production scénique</p>
      <h2 class="h2-section mt-6 text-bone">
        Vous parlez le {category.toLowerCase()} ?<br /><span class="text-gradient">On le produit.</span>
      </h2>
      <p class="mt-8 text-base text-bone/70 leading-relaxed">
        Notre métier : la production technique d'événements à enjeu. Plénière, gala, lancement, captation. Décrivez votre projet.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/construire-mon-projet/" class="btn-bone">Construire mon projet</a>
        <a href="/conseiller/" class="btn-outline border-bone/30 text-bone hover:bg-bone hover:text-ink">Voir le carnet d'adresses</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const search = document.getElementById('catSearch') as HTMLInputElement;
  const grid = document.getElementById('catGrid');
  const empty = document.getElementById('catEmpty');
  const entries = document.querySelectorAll<HTMLElement>('.catEntry');

  search?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    let visible = 0;
    entries.forEach((el) => {
      const match = !q || (el.dataset.search ?? '').includes(q);
      el.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (empty && grid) {
      empty.classList.toggle('hidden', visible > 0);
      grid.classList.toggle('hidden', visible === 0);
    }
  });
</script>
