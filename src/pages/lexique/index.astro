---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { lexique, lexiqueCategories, slugify } from '@/data/lexique';

const title = "Lexique événementiel FR / EN | 2000+ termes | Epicentre Séminaires";
const description = "Lexique événementiel français-anglais : 2000+ termes en régie, audio, lumière, vidéo, structure, sécurité, catering, mariage, streaming. Référence du métier.";

const total = lexique.length;

const countByCategory = lexiqueCategories.reduce((acc, cat) => {
  acc[cat] = lexique.filter((l) => l.category === cat).length;
  return acc;
}, {} as Record<string, number>);

// Schema.org DefinedTermSet : signal explicite à Google que c'est un glossaire.
// On ne peut pas embarquer 2000 termes sans alourdir le HTML, on en met 50
// représentatifs et chaque page catégorie embarque les siens.
const siteUrl = 'https://epicentre-seminaires.fr';
const definedTermSet = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${siteUrl}/lexique/`,
  name: 'Lexique événementiel FR / EN',
  description: '2000+ termes du métier événementiel en français et anglais.',
  url: `${siteUrl}/lexique/`,
  inLanguage: ['fr', 'en'],
  hasDefinedTerm: lexique.slice(0, 50).map((l) => ({
    '@type': 'DefinedTerm',
    name: l.fr,
    alternateName: l.en,
    description: l.definition,
    inDefinedTermSet: `${siteUrl}/lexique/`,
  })),
};
---
<Base title={title} description={description} zone="plaine" theme="light">
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSet)} />

  <div class="container-wide pt-28 md:pt-32 pb-2">
    <Breadcrumb items={[{ name: 'Accueil', url: '/' }, { name: 'Lexique événementiel' }]} variant="light" />
  </div>

  <!-- HERO -->
  <section class="bg-bone pt-6 md:pt-8 pb-12 md:pb-16">
    <div class="container-wide max-w-4xl">
      <p class="eyebrow">Ressource · Lexique</p>
      <h1 class="h1-hero-lg mt-6">
        Le vocabulaire<br /><span class="text-gradient">qui change un devis.</span>
      </h1>
      <p class="mt-8 lead max-w-2xl">
        Le métier événementiel a son langage. Connaître les bons mots permet de lire un devis, repérer les approximations, dimensionner ses besoins. {total} termes bilingues français-anglais, organisés en {lexiqueCategories.length} catégories.
      </p>
      <p class="mt-6 text-sm text-ink/55">
        {total} termes · {lexiqueCategories.length} catégories · ressource gratuite
      </p>
    </div>
  </section>

  <!-- BENTO CATÉGORIES (porte d'entrée principale, SEO-friendly) -->
  <section class="bg-bone-soft py-16 md:py-24 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-10 md:mb-14">
        <p class="eyebrow">Explorer par catégorie</p>
        <h2 class="h2-section mt-6">
          {lexiqueCategories.length} catégories. <span class="text-gradient">Le métier complet.</span>
        </h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-px bg-ink/10">
        {lexiqueCategories.map((cat) => (
          <a href={`/lexique/${slugify(cat)}/`} class="group bg-bone-soft hover:bg-bone p-6 md:p-7 transition-all duration-300 flex flex-col gap-3">
            <p class="text-base md:text-lg font-semibold text-ink leading-tight">{cat}</p>
            <p class="text-xs text-ink/55">{countByCategory[cat]} termes</p>
            <span class="mt-auto text-xs text-accent font-medium flex items-center gap-1.5 opacity-70 group-hover:opacity-100 transition-opacity">
              Voir la catégorie
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BARRE DE RECHERCHE STICKY -->
  <section class="sticky top-[72px] md:top-[80px] z-30 bg-bone-soft/95 backdrop-blur-md border-y border-ink/10">
    <div class="container-wide py-5">
      <div class="flex flex-col md:flex-row gap-4">
        <div class="relative flex-1">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-4 top-1/2 -translate-y-1/2 text-ink/45">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.35-4.35" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            id="lexSearch"
            placeholder="Rechercher dans 2000+ termes (FR ou EN)…"
            class="w-full pl-12 pr-4 py-3.5 bg-bone border border-ink/15 focus:outline-none focus:border-accent text-base transition-colors"
          />
        </div>
        <div class="flex gap-2 flex-wrap" id="lexFilters">
          <button type="button" data-cat="all" class="lexFilterBtn px-4 py-2 text-xs uppercase tracking-[0.18em] border border-ink/15 hover:border-ink/40 transition-colors data-[active=true]:bg-forest-deep data-[active=true]:text-bone data-[active=true]:border-forest-deep" data-active="true">
            Tout
          </button>
          {lexiqueCategories.map((cat) => (
            <button type="button" data-cat={cat} class="lexFilterBtn px-4 py-2 text-xs uppercase tracking-[0.18em] border border-ink/15 hover:border-ink/40 transition-colors data-[active=true]:bg-forest-deep data-[active=true]:text-bone data-[active=true]:border-forest-deep">
              {cat}
            </button>
          ))}
        </div>
      </div>
      <p class="mt-4 text-xs text-ink/50" id="lexCount">{total} termes</p>
    </div>
  </section>

  <!-- LISTE COMPLÈTE (toutes catégories, ancres ID, badges cat cliquables) -->
  <section class="bg-bone py-12 md:py-16">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-ink/10" id="lexGrid">
        {lexique.map((entry) => (
          <article
            id={slugify(entry.fr)}
            class="lexEntry bg-bone p-6 md:p-7 transition-opacity scroll-mt-32"
            data-cat={entry.category}
            data-search={`${entry.fr.toLowerCase()} ${(entry.en ?? '').toLowerCase()} ${entry.definition.toLowerCase()}`}
          >
            <div class="flex items-baseline gap-3 flex-wrap">
              <h3 class="font-display text-xl md:text-2xl text-ink leading-tight tracking-tight">{entry.fr}</h3>
              {entry.en && <span class="text-sm text-ink/45 font-mono">/ {entry.en}</span>}
            </div>
            <a href={`/lexique/${slugify(entry.category)}/#${slugify(entry.fr)}`} class="mt-1 inline-block text-[0.65rem] uppercase tracking-[0.2em] text-accent font-medium hover:underline">
              {entry.category}
            </a>
            <p class="mt-4 text-sm text-ink/70 leading-relaxed">{entry.definition}</p>
          </article>
        ))}
      </div>

      <div id="lexEmpty" class="hidden text-center py-24">
        <p class="text-ink/55">Aucun terme ne correspond à votre recherche.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-forest-gradient text-bone py-24 md:py-28">
    <div class="container-wide text-center max-w-3xl mx-auto">
      <p class="eyebrow text-bone/55">Aller plus loin</p>
      <h2 class="h2-section mt-6 text-bone">
        Un mot vous échappe ?<br /><span class="text-gradient">Posez la question.</span>
      </h2>
      <p class="mt-8 text-base text-bone/70 leading-relaxed">
        Le lexique évolue avec les retours. Suggérez un terme manquant, on l'ajoute.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/contact/" class="btn-bone">Suggérer un terme</a>
        <a href="/conseiller/" class="btn-outline border-bone/30 text-bone hover:bg-bone hover:text-ink">Voir le carnet d'adresses</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const search = document.getElementById('lexSearch') as HTMLInputElement;
  const grid = document.getElementById('lexGrid');
  const empty = document.getElementById('lexEmpty');
  const count = document.getElementById('lexCount');
  const entries = document.querySelectorAll<HTMLElement>('.lexEntry');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.lexFilterBtn');

  let activeCat = 'all';
  let activeQuery = '';

  const apply = () => {
    let visible = 0;
    entries.forEach((el) => {
      const matchCat = activeCat === 'all' || el.dataset.cat === activeCat;
      const matchSearch = !activeQuery || (el.dataset.search ?? '').includes(activeQuery);
      const show = matchCat && matchSearch;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (count) count.textContent = `${visible} terme${visible > 1 ? 's' : ''}`;
    if (empty && grid) {
      empty.classList.toggle('hidden', visible > 0);
      grid.classList.toggle('hidden', visible === 0);
    }
  };

  search?.addEventListener('input', () => {
    activeQuery = search.value.toLowerCase().trim();
    apply();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => (b.dataset.active = 'false'));
      btn.dataset.active = 'true';
      activeCat = btn.dataset.cat ?? 'all';
      apply();
    });
  });
</script>
