---
import Base from '@/layouts/Base.astro';
import { FORMSUBMIT_ENDPOINT, SITE_URL, CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

const title = "Contact direct : Agence événementielle Plaine de l'Ain | Epicentre";
const description = "Écrire à Epicentre Séminaires : message libre court, téléphone direct, email. Pour un brief complet, utilisez 'Construire mon projet'.";
---

<Base title={title} description={description} zone="plaine">
  <section class="relative bg-forest-gradient text-bone min-h-screen pt-32 md:pt-36 pb-20 md:pb-28 overflow-hidden">
    <!-- Halos brand pour profondeur -->
    <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-[radial-gradient(circle,rgba(245,241,234,0.06)_0%,transparent_60%)] pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] rounded-full bg-[radial-gradient(circle,rgba(0,73,27,0.4)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="container-wide relative z-10">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <!-- COLONNE GAUCHE : carte de visite Epicentre -->
        <div class="lg:col-span-5">
          <p class="eyebrow text-bone/60">Contact direct</p>
          <h1 class="font-display text-3xl md:text-5xl font-semibold mt-4 leading-tight !text-bone">
            On répond, sans intermédiaire.
          </h1>
          <p class="mt-7 text-lg text-bone/75 leading-relaxed max-w-md">
            Pour un échange rapide ou une question simple. Pour un vrai brief de projet, passez par <a href="/construire-mon-projet/" class="text-bone underline underline-offset-4 hover:text-bone/80">Construire mon projet</a> : on vous propose une réponse cadrée.
          </p>

          <!-- Contact direct -->
          <div class="mt-12 space-y-7">
            <a href={CONTACT_PHONE_HREF} class="flex items-start gap-4 group">
              <span class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-full bg-bone/10 group-hover:bg-bone/15 transition-colors">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-bone">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <p class="text-[0.65rem] uppercase tracking-[0.22em] text-bone/55 font-medium">Téléphone</p>
                <p class="mt-1 text-xl font-semibold text-bone group-hover:text-bone/80 transition-colors">{CONTACT_PHONE_DISPLAY}</p>
                <p class="mt-1 text-xs text-bone/50">Lundi à vendredi, 9h-18h</p>
              </div>
            </a>

            <a href="mailto:contact@epicentre-seminaires.fr" class="flex items-start gap-4 group">
              <span class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-full bg-bone/10 group-hover:bg-bone/15 transition-colors">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-bone">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke-linecap="round" stroke-linejoin="round" />
                  <polyline points="22,6 12,13 2,6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <p class="text-[0.65rem] uppercase tracking-[0.22em] text-bone/55 font-medium">Email</p>
                <p class="mt-1 text-base font-semibold text-bone group-hover:text-bone/80 transition-colors break-all">contact@epicentre-seminaires.fr</p>
                <p class="mt-1 text-xs text-bone/50">Réponse sous 24h ouvrées</p>
              </div>
            </a>

            <div class="flex items-start gap-4">
              <span class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-full bg-bone/10">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-bone">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="12" cy="10" r="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <p class="text-[0.65rem] uppercase tracking-[0.22em] text-bone/55 font-medium">Bureau</p>
                <p class="mt-1 text-base font-semibold text-bone">Meximieux, Plaine de l'Ain</p>
                <p class="mt-1 text-xs text-bone/50">Entre Lyon et Genève</p>
              </div>
            </div>
          </div>
        </div>

        <!-- COLONNE DROITE : formulaire minimal -->
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="bg-bone/[0.04] border border-bone/15 rounded-sm p-7 md:p-9 backdrop-blur-sm">
            <p class="eyebrow text-bone/55">Message rapide</p>
            <h2 class="font-display text-2xl md:text-3xl font-semibold mt-3 leading-tight !text-bone">
              Une question ? Un mot ?
            </h2>
            <p class="mt-3 text-sm text-bone/65 leading-relaxed">
              Trois champs, c'est suffisant pour démarrer.
            </p>

            <form action={FORMSUBMIT_ENDPOINT} method="POST" class="mt-8 space-y-5">
              <input type="hidden" name="_subject" value="Message rapide - Epicentre" />
              <input type="hidden" name="_next" value={`${SITE_URL}/merci/`} />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="zone" value="Plaine de l'Ain" />
              <input type="hidden" name="canal" value="Contact rapide" />
              <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

              <label class="block">
                <span class="text-[0.65rem] uppercase tracking-[0.22em] text-bone/55 font-medium">Nom et entreprise</span>
                <input
                  type="text"
                  name="identite"
                  required
                  placeholder="ex : Marie Durand, Acme SA"
                  class="mt-2 w-full bg-transparent border-b border-bone/25 py-3 text-bone placeholder:text-bone/35 focus:outline-none focus:border-bone transition-colors"
                />
              </label>

              <label class="block">
                <span class="text-[0.65rem] uppercase tracking-[0.22em] text-bone/55 font-medium">Email ou téléphone</span>
                <input
                  type="text"
                  name="contact"
                  required
                  placeholder="ex : marie@acme.fr ou 06 ..."
                  class="mt-2 w-full bg-transparent border-b border-bone/25 py-3 text-bone placeholder:text-bone/35 focus:outline-none focus:border-bone transition-colors"
                />
              </label>

              <label class="block">
                <span class="text-[0.65rem] uppercase tracking-[0.22em] text-bone/55 font-medium">Votre message</span>
                <textarea
                  name="message"
                  required
                  rows="5"
                  placeholder="Posez votre question, décrivez en deux lignes, on vous répond."
                  class="mt-2 w-full bg-transparent border-b border-bone/25 py-3 text-bone placeholder:text-bone/35 focus:outline-none focus:border-bone transition-colors resize-none"
                ></textarea>
              </label>

              <div class="pt-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <p class="text-xs text-bone/45 leading-relaxed">
                  En envoyant, vous acceptez d'être recontacté. Données utilisées uniquement pour la prise de contact.
                </p>
                <button type="submit" class="contact-submit shrink-0">
                  Envoyer
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>
            </form>
          </div>

          <!-- Pont vers le brief complet -->
          <div class="mt-6 p-5 border border-bone/10 rounded-sm flex items-start gap-4">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-bone/55 mt-0.5">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" stroke-linecap="round" />
              <line x1="12" y1="16" x2="12.01" y2="16" stroke-linecap="round" />
            </svg>
            <div class="flex-1">
              <p class="text-sm font-semibold text-bone">Vous avez un projet précis en tête ?</p>
              <p class="text-xs text-bone/65 leading-relaxed mt-1">
                Le brief complet en 7 questions vous garantit une réponse cadrée plutôt qu'un échange standard.
              </p>
              <a href="/construire-mon-projet/" class="mt-3 inline-flex items-center gap-1.5 text-xs text-bone font-semibold underline underline-offset-4 hover:text-bone/80 transition-colors">
                Construire mon projet
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .contact-submit {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1.75rem;
      background: #F5F1EA;
      color: #003707;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: -0.005em;
      border-radius: 999px;
      transition: all 0.2s ease;
      cursor: pointer;
      box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.4);
    }
    .contact-submit:hover {
      background: #FFFFFF;
      transform: translateY(-1px);
      box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.5);
    }
  </style>
</Base>
