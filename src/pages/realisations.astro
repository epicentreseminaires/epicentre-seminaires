---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';

const title = "Réalisations | Epicentre Séminaires";
const description = "Études de cas d'événements pilotés par Epicentre dans la Plaine de l'Ain. Plénières, galas, conventions, lancements. Références anonymisées sous NDA.";

const breadcrumb = [
  { name: 'Accueil', url: '/' },
  { name: 'Réalisations' },
];
---

<Base title={title} description={description} zone="plaine">
  <section class="bg-plaine-deep text-bone py-24 md:py-32">
    <div class="container-wide">
      <Breadcrumb items={breadcrumb} variant="dark" />
      <h1 class="font-display text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.04em] max-w-4xl">
        Nos réalisations.
      </h1>
      <p class="mt-8 text-xl text-bone/70 max-w-2xl leading-relaxed">
        Etudes de cas anonymisées d'événements pilotés par Epicentre. La majorité de nos clients sont sous accord de confidentialité : les références détaillées se transmettent en RDV, sur demande, sous NDA réciproque.
      </p>
    </div>
  </section>

  <section class="bg-bone py-28 md:py-36">
    <div class="container-wide">
      <div class="max-w-3xl mb-16">
        <p class="eyebrow">Études de cas</p>
        <h2 class="text-3xl md:text-5xl mt-6 leading-tight tracking-[-0.03em]">
          En cours de publication.
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/70">
          Les premières études de cas détaillées seront publiées progressivement, avec l'accord écrit des entreprises concernées. Pas de témoignages anonymes, pas de chiffres invérifiables : seulement ce qui peut être documenté précisément.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-ink/10">
        <div class="bg-bone p-10 md:p-12">
          <p class="eyebrow text-ink/55">Format type</p>
          <h3 class="text-2xl md:text-3xl mt-4 leading-tight">Convention annuelle 500 personnes</h3>
          <p class="mt-5 text-ink/65 leading-relaxed">
            Plénière scénographiée, captation multicam, ateliers thématiques, dîner gala. Production complète sur lieu industriel privatisé, dans la Plaine de l'Ain.
          </p>
          <p class="mt-6 text-sm text-ink/50">Étude de cas détaillée disponible en RDV.</p>
        </div>
        <div class="bg-bone p-10 md:p-12">
          <p class="eyebrow text-ink/55">Format type</p>
          <h3 class="text-2xl md:text-3xl mt-4 leading-tight">Lancement produit B2B 200 invités</h3>
          <p class="mt-5 text-ink/65 leading-relaxed">
            Reveal scénographié avec scénographie 3D immersive, dispositif scénique sur-mesure, captation diffusable, gestion presse régionale. Production technique complète.
          </p>
          <p class="mt-6 text-sm text-ink/50">Étude de cas détaillée disponible en RDV.</p>
        </div>
        <div class="bg-bone p-10 md:p-12">
          <p class="eyebrow text-ink/55">Format type</p>
          <h3 class="text-2xl md:text-3xl mt-4 leading-tight">Inauguration de site industriel</h3>
          <p class="mt-5 text-ink/65 leading-relaxed">
            Moment institutionnel : élus locaux, presse régionale, équipes. Plan de prévention industriel, scénographie sobre, captation pour archive corporate, cocktail.
          </p>
          <p class="mt-6 text-sm text-ink/50">Étude de cas détaillée disponible en RDV.</p>
        </div>
        <div class="bg-bone p-10 md:p-12">
          <p class="eyebrow text-ink/55">Format type</p>
          <h3 class="text-2xl md:text-3xl mt-4 leading-tight">Anniversaire d'entreprise</h3>
          <p class="mt-5 text-ink/65 leading-relaxed">
            Gala scénographié pour célébrer un cap symbolique. Dîner assis, intervention show, mise en lumière sur-mesure, captation pour archive long terme.
          </p>
          <p class="mt-6 text-sm text-ink/50">Étude de cas détaillée disponible en RDV.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-bone-soft py-28 md:py-36">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Références sous NDA</p>
      <h2 class="text-3xl md:text-5xl mt-6 leading-tight tracking-[-0.03em]">
        Demandez les références qui correspondent à votre projet.
      </h2>
      <p class="mt-8 text-lg leading-relaxed text-ink/70">
        Les références client précises (noms, formats, jauges, budgets, photos) sont communiquées en RDV après signature d'un NDA réciproque, dans le respect des accords passés avec nos clients. Décrivez votre projet : nous vous transmettons des cas similaires en taille et en enjeu.
      </p>
      <a href="/contact/" class="btn-accent mt-10 inline-flex">
        Demander un RDV
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
