---
import Base from '@/layouts/Base.astro';

const title = "L'agence : Production événementielle Plaine de l'Ain | Epicentre";
const description = "Agence de production événementielle dans la Plaine de l'Ain. Notre méthode : pilotage technique direct, sans intermédiaire, hérité des grandes scènes du sport et du spectacle français.";

const cover = 'https://images.unsplash.com/photo-1431540015161-0bf868a2d407?w=2400&q=85&auto=format&fit=crop';
---

<Base title={title} description={description} zone="plaine">
  <section class="relative h-[55vh] min-h-[380px] overflow-hidden bg-plaine-deep">
    <img src={cover} alt="Agence événementielle Plaine de l'Ain" class="absolute inset-0 w-full h-full object-cover opacity-60" />
    <div class="absolute inset-0 bg-gradient-to-b from-plaine-deep/30 to-plaine-deep"></div>
    <div class="relative z-10 h-full container-wide flex flex-col justify-end pb-16 text-bone">
      <p class="eyebrow text-bone/70 mb-4">L'agence</p>
      <h1 class="font-display text-4xl md:text-6xl max-w-4xl">Production événementielle, sans intermédiaire.</h1>
    </div>
  </section>

  <section class="py-24 bg-bone">
    <div class="container-wide grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <p class="eyebrow">Notre méthode</p>
        <h2 class="font-display text-3xl md:text-4xl mt-6 leading-tight">
          Le pilotage technique d'une grande scène, à votre échelle.
        </h2>
      </div>
      <div class="md:col-span-7 md:col-start-6 space-y-6 text-lg leading-relaxed">
        <p>
          Epicentre n'est pas une agence "concept-board" qui sous-traite la production. L'agence <strong>pilote techniquement</strong> chaque événement de bout en bout : scénographie, scène, son, lumière, vidéo, captation, régie.
        </p>
        <p>
          Cette logique vient des productions menées sur les plus grandes scènes du sport et du spectacle français. Aucun rouage technique n'est délégué à un inconnu, parce qu'aucun ne peut l'être quand l'enjeu compte.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ink text-bone py-24">
    <div class="container-wide">
      <p class="eyebrow text-bone/50">Trois principes</p>
      <h2 class="font-display text-4xl md:text-5xl mt-6 leading-tight max-w-3xl">
        Comment on travaille.
      </h2>

      <div class="grid md:grid-cols-3 gap-6 mt-12">
        {[
          {
            n: '01',
            t: 'Direct.',
            d: 'Vous parlez à celui qui pilote la production. Pas d\'intermédiaire commercial entre vous et l\'opérationnel.',
          },
          {
            n: '02',
            t: 'Précis.',
            d: 'Devis ligne à ligne, équipement nommé, rétroplanning détaillé, équipe identifiée. Pas de poste vague ni de forfait opaque.',
          },
          {
            n: '03',
            t: 'Local.',
            d: 'Basés dans la Plaine de l\'Ain, nous connaissons les lieux du bassin et les prestataires fiables sur place.',
          },
        ].map((p) => (
          <div class="border border-bone/10 p-8">
            <p class="eyebrow text-accent">{p.n}</p>
            <h3 class="font-display text-3xl mt-4">{p.t}</h3>
            <p class="mt-4 text-bone/60 text-sm leading-relaxed">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-plaine text-bone py-24">
    <div class="container-wide text-center">
      <h2 class="font-display text-4xl md:text-5xl">On étudie votre projet ?</h2>
      <a href="/contact/" class="btn-bone mt-10 inline-flex">Demander un devis</a>
    </div>
  </section>
</Base>
