---
import Base from '@/layouts/Base.astro';
import { FORMSUBMIT_ENDPOINT, SITE_URL } from '@/config';

const title = "Construire mon projet | Epicentre Séminaires";
const description = "Cadrez votre événement d'entreprise en 7 questions. Format, jauge, lieu, besoins. Réponse personnalisée et orientation prestataire ou production complète.";
---
<Base title={title} description={description} zone="plaine" theme="light" noindex={false}>
  <section class="min-h-screen bg-bone flex flex-col pt-24 md:pt-28">
    <!-- Barre de progression -->
    <div class="container-wide pt-8 pb-6">
      <div class="flex items-center justify-between mb-3">
        <p class="eyebrow text-ink/55">Construire mon projet</p>
        <p class="text-xs text-ink/55 tabular-nums" id="qStepLabel">Étape 1 / 7</p>
      </div>
      <div class="h-px bg-ink/10 relative overflow-hidden">
        <div class="absolute inset-y-0 left-0 bg-accent transition-all duration-500" id="qProgress" style="width: 14.3%"></div>
      </div>
    </div>

    <form
      action={FORMSUBMIT_ENDPOINT}
      method="POST"
      id="qForm"
      class="container-wide flex-1 flex items-center justify-center py-12 md:py-16"
    >
      <input type="hidden" name="_subject" value="Nouveau projet - Construire mon projet" />
      <input type="hidden" name="_next" value={`${SITE_URL}/merci/`} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="canal" value="construire-mon-projet" />
      <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

      <div class="w-full max-w-3xl">
        <!-- ÉTAPE 1 : Format -->
        <fieldset class="qStep" data-step="1">
          <legend class="block">
            <p class="eyebrow text-accent">Question 1 sur 7</p>
            <h2 class="font-display text-3xl md:text-5xl lg:text-6xl mt-4 leading-[1.05] tracking-[-0.035em] text-ink">
              Quel est le format de l'événement ?
            </h2>
          </legend>
          <div class="mt-10 grid sm:grid-cols-2 gap-3">
            {[
              'Plénière, convention',
              'Gala, dîner assis',
              'Lancement de produit',
              'Inauguration, AG',
              'Captation vidéo',
              'Je ne sais pas encore',
            ].map((opt) => (
              <label class="qOption block group cursor-pointer">
                <input type="radio" name="format" value={opt} class="peer sr-only" required />
                <div class="px-6 py-5 border border-ink/15 peer-checked:border-accent peer-checked:bg-bone-soft peer-checked:ring-1 peer-checked:ring-accent transition-all duration-200 hover:border-ink/40 flex items-center justify-between">
                  <span class="text-base md:text-lg text-ink/85 peer-checked:text-ink">{opt}</span>
                  <span class="w-2 h-2 rounded-full bg-ink/15 group-has-[input:checked]:bg-accent transition-colors"></span>
                </div>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- ÉTAPE 2 : Jauge -->
        <fieldset class="qStep hidden" data-step="2">
          <legend class="block">
            <p class="eyebrow text-accent">Question 2 sur 7</p>
            <h2 class="font-display text-3xl md:text-5xl lg:text-6xl mt-4 leading-[1.05] tracking-[-0.035em] text-ink">
              Combien de personnes attendues ?
            </h2>
          </legend>
          <div class="mt-10 grid sm:grid-cols-2 gap-3">
            {[
              'Moins de 100 personnes',
              '100 à 300 personnes',
              '300 à 600 personnes',
              '600 à 1 000 personnes',
              'Plus de 1 000 personnes',
              'Pas encore arbitré',
            ].map((opt) => (
              <label class="qOption block group cursor-pointer">
                <input type="radio" name="jauge" value={opt} class="peer sr-only" required />
                <div class="px-6 py-5 border border-ink/15 peer-checked:border-accent peer-checked:bg-bone-soft peer-checked:ring-1 peer-checked:ring-accent transition-all duration-200 hover:border-ink/40 flex items-center justify-between">
                  <span class="text-base md:text-lg text-ink/85 peer-checked:text-ink">{opt}</span>
                  <span class="w-2 h-2 rounded-full bg-ink/15 group-has-[input:checked]:bg-accent transition-colors"></span>
                </div>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- ÉTAPE 3 : Date -->
        <fieldset class="qStep hidden" data-step="3">
          <legend class="block">
            <p class="eyebrow text-accent">Question 3 sur 7</p>
            <h2 class="font-display text-3xl md:text-5xl lg:text-6xl mt-4 leading-[1.05] tracking-[-0.035em] text-ink">
              À quelle échéance ?
            </h2>
          </legend>
          <div class="mt-10 grid sm:grid-cols-2 gap-3">
            {[
              'Dans moins de 2 mois',
              '2 à 4 mois',
              '4 à 8 mois',
              '8 à 12 mois',
              'Plus de 12 mois',
              'Date à définir',
            ].map((opt) => (
              <label class="qOption block group cursor-pointer">
                <input type="radio" name="echeance" value={opt} class="peer sr-only" required />
                <div class="px-6 py-5 border border-ink/15 peer-checked:border-accent peer-checked:bg-bone-soft peer-checked:ring-1 peer-checked:ring-accent transition-all duration-200 hover:border-ink/40 flex items-center justify-between">
                  <span class="text-base md:text-lg text-ink/85 peer-checked:text-ink">{opt}</span>
                  <span class="w-2 h-2 rounded-full bg-ink/15 group-has-[input:checked]:bg-accent transition-colors"></span>
                </div>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- ÉTAPE 4 : Lieu -->
        <fieldset class="qStep hidden" data-step="4">
          <legend class="block">
            <p class="eyebrow text-accent">Question 4 sur 7</p>
            <h2 class="font-display text-3xl md:text-5xl lg:text-6xl mt-4 leading-[1.05] tracking-[-0.035em] text-ink">
              Le lieu, c'est où ?
            </h2>
          </legend>
          <div class="mt-10 grid sm:grid-cols-2 gap-3">
            {[
              'Sur notre site (entreprise)',
              'À la Plaine de l\'Ain',
              'À Lyon ou Lyon est',
              'Genève, Pays de Gex',
              'Pas encore arbitré',
              'Autre',
            ].map((opt) => (
              <label class="qOption block group cursor-pointer">
                <input type="radio" name="lieu" value={opt} class="peer sr-only" required />
                <div class="px-6 py-5 border border-ink/15 peer-checked:border-accent peer-checked:bg-bone-soft peer-checked:ring-1 peer-checked:ring-accent transition-all duration-200 hover:border-ink/40 flex items-center justify-between">
                  <span class="text-base md:text-lg text-ink/85 peer-checked:text-ink">{opt}</span>
                  <span class="w-2 h-2 rounded-full bg-ink/15 group-has-[input:checked]:bg-accent transition-colors"></span>
                </div>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- ÉTAPE 5 : Ce que vous cherchez -->
        <fieldset class="qStep hidden" data-step="5">
          <legend class="block">
            <p class="eyebrow text-accent">Question 5 sur 7</p>
            <h2 class="font-display text-3xl md:text-5xl lg:text-6xl mt-4 leading-[1.05] tracking-[-0.035em] text-ink">
              Vous cherchez quoi exactement ?
            </h2>
          </legend>
          <div class="mt-10 grid gap-3">
            {[
              { v: 'production-complete', t: 'Une production clé en main', d: 'Vous nous confiez l\'orchestration : scénographie, prestataires, pilotage, jour J.' },
              { v: 'prestataire', t: 'La recommandation d\'un prestataire', d: 'Vous gérez le projet, vous voulez juste le bon contact dans une catégorie.' },
              { v: 'conseil', t: 'Un conseil ou un avis', d: 'Vous voulez parler de votre projet à quelqu\'un qui connaît le métier, sans engagement.' },
              { v: 'devis-multiples', t: 'Plusieurs devis comparés', d: 'Vous avez déjà des propositions et vous voulez qu\'on aide à les lire.' },
            ].map((opt) => (
              <label class="qOption block group cursor-pointer">
                <input type="radio" name="besoin" value={opt.v} class="peer sr-only" required />
                <div class="px-6 py-5 border border-ink/15 peer-checked:border-accent peer-checked:bg-bone-soft peer-checked:ring-1 peer-checked:ring-accent transition-all duration-200 hover:border-ink/40">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1">
                      <p class="text-base md:text-lg text-ink/85 peer-checked:text-ink font-medium">{opt.t}</p>
                      <p class="text-sm text-ink/55 mt-1.5 leading-snug">{opt.d}</p>
                    </div>
                    <span class="mt-1.5 w-2 h-2 rounded-full bg-ink/15 group-has-[input:checked]:bg-accent transition-colors shrink-0"></span>
                  </div>
                </div>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- ÉTAPE 6 : Budget -->
        <fieldset class="qStep hidden" data-step="6">
          <legend class="block">
            <p class="eyebrow text-accent">Question 6 sur 7</p>
            <h2 class="font-display text-3xl md:text-5xl lg:text-6xl mt-4 leading-[1.05] tracking-[-0.035em] text-ink">
              Une enveloppe en tête ?
            </h2>
            <p class="mt-5 text-base text-ink/55 leading-relaxed max-w-xl">
              Indication utile pour calibrer la proposition. Sans engagement.
            </p>
          </legend>
          <div class="mt-10 grid sm:grid-cols-2 gap-3">
            {[
              'Moins de 10 000 €',
              '10 000 à 30 000 €',
              '30 000 à 80 000 €',
              '80 000 à 150 000 €',
              'Plus de 150 000 €',
              'À cadrer ensemble',
            ].map((opt) => (
              <label class="qOption block group cursor-pointer">
                <input type="radio" name="budget" value={opt} class="peer sr-only" required />
                <div class="px-6 py-5 border border-ink/15 peer-checked:border-accent peer-checked:bg-bone-soft peer-checked:ring-1 peer-checked:ring-accent transition-all duration-200 hover:border-ink/40 flex items-center justify-between">
                  <span class="text-base md:text-lg text-ink/85 peer-checked:text-ink">{opt}</span>
                  <span class="w-2 h-2 rounded-full bg-ink/15 group-has-[input:checked]:bg-accent transition-colors"></span>
                </div>
              </label>
            ))}
          </div>
        </fieldset>

        <!-- ÉTAPE 7 : Coordonnées -->
        <fieldset class="qStep hidden" data-step="7">
          <legend class="block">
            <p class="eyebrow text-accent">Dernière étape</p>
            <h2 class="font-display text-3xl md:text-5xl lg:text-6xl mt-4 leading-[1.05] tracking-[-0.035em] text-ink">
              Comment vous joindre ?
            </h2>
          </legend>

          <div class="mt-10 grid gap-6">
            <div class="grid md:grid-cols-2 gap-4">
              <label class="block">
                <span class="eyebrow">Prénom *</span>
                <input type="text" name="firstname" required class="mt-2 w-full bg-transparent border-b border-ink/20 py-3 text-lg focus:outline-none focus:border-accent transition-colors" />
              </label>
              <label class="block">
                <span class="eyebrow">Nom *</span>
                <input type="text" name="lastname" required class="mt-2 w-full bg-transparent border-b border-ink/20 py-3 text-lg focus:outline-none focus:border-accent transition-colors" />
              </label>
            </div>

            <label class="block">
              <span class="eyebrow">Entreprise *</span>
              <input type="text" name="company" required class="mt-2 w-full bg-transparent border-b border-ink/20 py-3 text-lg focus:outline-none focus:border-accent transition-colors" />
            </label>

            <div class="grid md:grid-cols-2 gap-4">
              <label class="block">
                <span class="eyebrow">Email *</span>
                <input type="email" name="email" required class="mt-2 w-full bg-transparent border-b border-ink/20 py-3 text-lg focus:outline-none focus:border-accent transition-colors" />
              </label>
              <label class="block">
                <span class="eyebrow">Téléphone *</span>
                <input type="tel" name="phone" required class="mt-2 w-full bg-transparent border-b border-ink/20 py-3 text-lg focus:outline-none focus:border-accent transition-colors" />
              </label>
            </div>

            <label class="block">
              <span class="eyebrow">Un mot sur le projet (optionnel)</span>
              <textarea name="message" rows="3" placeholder="Contexte, objectif principal, contraintes…" class="mt-2 w-full bg-transparent border-b border-ink/20 py-3 text-base focus:outline-none focus:border-accent transition-colors resize-none"></textarea>
            </label>

            <p class="text-xs text-ink/45 leading-relaxed mt-2">
              En envoyant ce formulaire, vous acceptez d'être recontacté par Epicentre Séminaires. Vos données ne sont utilisées que pour la prise de contact.
            </p>
          </div>
        </fieldset>

        <!-- NAVIGATION -->
        <div class="mt-12 flex items-center justify-between">
          <button type="button" id="qPrev" class="text-sm text-ink/55 hover:text-ink flex items-center gap-2 transition-colors disabled:opacity-30 disabled:pointer-events-none">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M11 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Précédent
          </button>
          <button type="button" id="qNext" class="btn-accent text-sm px-7 py-3.5 disabled:opacity-40 disabled:pointer-events-none">
            Continuer
            <span aria-hidden="true">→</span>
          </button>
          <button type="submit" id="qSubmit" class="btn-accent text-sm px-7 py-3.5 hidden">
            Envoyer
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </form>
  </section>
</Base>

<script>
  const TOTAL = 7;
  let current = 1;

  const form = document.getElementById('qForm') as HTMLFormElement;
  const stepLabel = document.getElementById('qStepLabel');
  const progress = document.getElementById('qProgress');
  const prevBtn = document.getElementById('qPrev') as HTMLButtonElement;
  const nextBtn = document.getElementById('qNext') as HTMLButtonElement;
  const submitBtn = document.getElementById('qSubmit') as HTMLButtonElement;

  const showStep = (n: number) => {
    document.querySelectorAll<HTMLElement>('.qStep').forEach((el) => {
      const step = Number(el.dataset.step);
      if (step === n) {
        el.classList.remove('hidden');
        el.style.opacity = '0';
        el.style.transform = 'translateY(8px)';
        requestAnimationFrame(() => {
          el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        });
      } else {
        el.classList.add('hidden');
      }
    });

    if (stepLabel) stepLabel.textContent = `Étape ${n} / ${TOTAL}`;
    if (progress) progress.style.width = `${(n / TOTAL) * 100}%`;

    prevBtn.disabled = n === 1;

    if (n === TOTAL) {
      nextBtn.classList.add('hidden');
      submitBtn.classList.remove('hidden');
    } else {
      nextBtn.classList.remove('hidden');
      submitBtn.classList.add('hidden');
    }

    // Focus sur le 1er champ visible (input radio ou text)
    const visible = document.querySelector<HTMLElement>(`.qStep[data-step="${n}"] input, .qStep[data-step="${n}"] select`);
    visible?.focus();
  };

  const validateStep = (n: number) => {
    const fieldset = document.querySelector<HTMLElement>(`.qStep[data-step="${n}"]`);
    if (!fieldset) return false;

    const radios = fieldset.querySelectorAll<HTMLInputElement>('input[type="radio"]');
    if (radios.length > 0) {
      const checked = Array.from(radios).some((r) => r.checked);
      return checked;
    }

    const requireds = fieldset.querySelectorAll<HTMLInputElement>('input[required], select[required]');
    return Array.from(requireds).every((el) => el.checkValidity());
  };

  nextBtn?.addEventListener('click', () => {
    if (!validateStep(current)) {
      // Highlight les options
      const fieldset = document.querySelector<HTMLElement>(`.qStep[data-step="${current}"]`);
      fieldset?.classList.add('shake');
      setTimeout(() => fieldset?.classList.remove('shake'), 400);
      return;
    }
    if (current < TOTAL) {
      current++;
      showStep(current);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  prevBtn?.addEventListener('click', () => {
    if (current > 1) {
      current--;
      showStep(current);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Auto-advance sur les radios (UX Apple)
  document.querySelectorAll<HTMLInputElement>('.qStep input[type="radio"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      if (current < TOTAL) {
        setTimeout(() => {
          current++;
          showStep(current);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, 350);
      }
    });
  });

  showStep(1);
</script>

<style>
  .shake {
    animation: shake 0.4s ease;
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }
  .qStep input[type="radio"]:checked + div { /* Firefox fallback */ }
</style>
