---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Prose from '@/components/Prose.astro';

export async function getStaticPaths() {
  const articles = await getCollection('journal');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const siteUrl = 'https://epicentre-seminaires.fr';
const articleUrl = `${siteUrl}/journal/${article.id}/`;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${articleUrl}#article`,
  headline: article.data.title,
  description: article.data.description,
  url: articleUrl,
  ...(article.data.cover && { image: article.data.cover }),
  datePublished: article.data.publishedAt.toISOString(),
  ...(article.data.updatedAt && { dateModified: article.data.updatedAt.toISOString() }),
  author: {
    '@type': 'Organization',
    name: 'Epicentre Séminaires',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Epicentre Séminaires',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/logo-epicentre-black.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  ...(article.data.tags && article.data.tags.length > 0 && { keywords: article.data.tags.join(', ') }),
};
---

<Base title={`${article.data.title} | Journal Epicentre`} description={article.data.description} image={article.data.cover} zone="brand">
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <article>
    {article.data.cover && (
      <section class="relative h-[55vh] min-h-[380px] overflow-hidden bg-ink">
        <img src={article.data.cover} alt={article.data.title} class="absolute inset-0 w-full h-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-gradient-to-b from-ink/30 to-ink"></div>
        <div class="relative z-10 h-full container-wide flex flex-col justify-end pb-16 text-bone">
          <p class="eyebrow text-bone/60 mb-4">Journal</p>
          <h1 class="text-3xl md:text-5xl lg:text-6xl max-w-4xl leading-tight">
            {article.data.title}
          </h1>
          <div class="mt-6 flex items-center gap-3 text-sm text-bone/60">
            <time datetime={article.data.publishedAt.toISOString()}>
              {formatDate(article.data.publishedAt)}
            </time>
            {article.data.readingTime && (
              <>
                <span class="text-bone/30">·</span>
                <span>{article.data.readingTime} de lecture</span>
              </>
            )}
          </div>
        </div>
      </section>
    )}

    <section class="py-20 md:py-28 bg-bone">
      <div class="container-wide">
        <Prose>
          <Content />
        </Prose>
      </div>
    </section>

    <section class="bg-ink text-bone py-24">
      <div class="container-wide text-center max-w-3xl mx-auto">
        <p class="eyebrow text-bone/50">Vous travaillez sur un projet ?</p>
        <h2 class="text-3xl md:text-5xl mt-6 leading-tight">
          Discutons-en directement.
        </h2>
        <p class="mt-6 text-bone/70">
          Plénière, gala, lancement, captation : décrivez-nous votre format en quelques lignes, on vous rappelle dans la journée.
        </p>
        <a href="/contact/" class="btn-accent mt-10 inline-flex">
          Demander un devis
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </article>
</Base>
