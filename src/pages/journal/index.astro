---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('journal')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const title = "Journal : Production événementielle, plénières, séminaires | Epicentre";
const description = "Le journal Epicentre : guides pour choisir une agence événementielle, comprendre les coûts d'une plénière, anticiper les bonnes décisions techniques.";

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
---

<Base title={title} description={description} zone="brand">
  <section class="bg-forest-gradient text-bone py-32 md:py-40">
    <div class="container-wide">
      <p class="eyebrow text-bone/50">Le journal</p>
      <h1 class="display-lg mt-6 max-w-4xl">
        Comprendre, choisir,<br />produire <span class="text-gradient">en grand.</span>
      </h1>
      <p class="mt-8 text-xl text-bone/70 max-w-2xl">
        Le journal d'une agence de production événementielle. Articles techniques, méthodes, et avis tranchés sur ce qui fait un événement réussi.
      </p>
    </div>
  </section>

  <section class="py-20 bg-bone">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 gap-x-8 gap-y-16">
        {articles.map((article) => (
          <a href={`/journal/${article.id}/`} class="group block">
            {article.data.cover && (
              <div class="relative aspect-[16/10] overflow-hidden bg-bone-soft">
                <img
                  src={article.data.cover}
                  alt={article.data.title}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                />
              </div>
            )}
            <div class="mt-6">
              <div class="flex items-center gap-3 text-xs text-ink/50">
                <time datetime={article.data.publishedAt.toISOString()}>
                  {formatDate(article.data.publishedAt)}
                </time>
                {article.data.readingTime && (
                  <>
                    <span class="text-ink/20">·</span>
                    <span>{article.data.readingTime} de lecture</span>
                  </>
                )}
              </div>
              <h2 class="mt-3 text-2xl md:text-3xl leading-tight group-hover:text-accent-dark transition-colors">
                {article.data.title}
              </h2>
              <p class="mt-3 text-ink/65 leading-relaxed">{article.data.description}</p>
              {article.data.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {article.data.tags.map((tag) => (
                    <span class="text-[0.7rem] uppercase tracking-wider text-ink/40 border border-ink/15 px-2 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      {articles.length === 0 && (
        <p class="text-center text-ink/50 py-20">Premiers articles en cours de rédaction.</p>
      )}
    </div>
  </section>
</Base>
