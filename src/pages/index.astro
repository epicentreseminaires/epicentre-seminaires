---
import Base from '@/layouts/Base.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import CarnetIcon from '@/components/CarnetIcon.astro';
import { carnet } from '@/data/carnet';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

const title = "Agence événementielle Plaine de l'Ain | Epicentre Séminaires";
const description = "Agence événementielle dans la Plaine de l'Ain. Production clé en main + carnet d'adresses curaté (lieu, traiteur, son, scène, captation). On vous conseille les bons interlocuteurs.";

const heroImg = 'https://enjoylife.b-cdn.net/Epicentre/epicentre_hero.jpg';
---
<Base title={title} description={description} zone="plaine" theme="dark" transparentTop>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ink text-bone min-h-[88vh] flex items-center pt-30 md:pt-32 pb-20">
    <!-- Image plein cadre HD avec Ken Burns + grade cinéma (grain film + vignette) -->
    <div class="absolute inset-0 pointer-events-none cinema-grade" aria-hidden="true">
      <img
        src={heroImg}
        alt=""
        class="absolute inset-0 w-full h-full object-cover hero-img"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Dégradés : couche sombre côté gauche pour ancrer le texte, plus douce côté droit pour préserver la scène -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/30 to-transparent z-[3]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/30 z-[3]"></div>
    </div>

    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="hero-eyebrow hero-fade" style="animation-delay:0ms">
          <span class="block w-10 h-px bg-bone/55"></span>
          <span>Plaine de l'Ain · Entre Lyon et Genève</span>
        </p>

        <h1 class="hero-title !text-bone hero-fade mt-7 md:mt-9" style="animation-delay:100ms">
          Le bon contact,<br />
          <span class="text-gradient-bone">ou tout l'événement.</span>
        </h1>

        <p class="hero-lead hero-fade mt-7 md:mt-9 max-w-xl" style="animation-delay:250ms">
          Agence événementielle dans la Plaine de l'Ain. Vous choisissez le mode : un nom à appeler, ou une production complète clé en main.
        </p>

        <div class="hero-actions hero-fade mt-9 md:mt-11" style="animation-delay:400ms">
          <a href="/construire-mon-projet/" class="hero-btn-primary">
            <span>Construire mon projet</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#carnet" class="hero-btn-ghost">
            <span>Voir le carnet d'adresses</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Indicateur de scroll discret -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-10 pointer-events-none hero-fade" style="animation-delay:700ms" aria-hidden="true">
      <div class="flex flex-col items-center gap-1.5 text-bone/55">
        <span class="text-[0.6rem] uppercase tracking-[0.3em] font-medium">Découvrir</span>
        <span class="scroll-cue-line"></span>
      </div>
    </div>
  </section>

  <style>
    /* Eyebrow */
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.875rem;
      color: rgba(245, 241, 234, 0.75);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    /* Titre : taille raisonnable mais avec présence */
    .hero-title {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      font-weight: 600;
      font-size: clamp(2.75rem, 6.5vw, 5.25rem);
      letter-spacing: -0.04em;
      line-height: 0.98;
    }
    /* Lead court, calé sur la même grille typographique */
    .hero-lead {
      font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
      line-height: 1.55;
      color: rgba(245, 241, 234, 0.82);
    }
    /* Container de boutons */
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
    }
    /* Bouton primaire : crème plein, avec flèche qui glisse au hover */
    .hero-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      padding: 1rem 1.75rem;
      background: #F5F1EA;
      color: #003707;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: -0.005em;
      border-radius: 999px;
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.55);
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.2s ease;
    }
    .hero-btn-primary:hover {
      background: #FFFFFF;
      transform: translateY(-1px);
      box-shadow: 0 24px 50px -22px rgba(0, 0, 0, 0.6);
    }
    .hero-btn-primary svg {
      transition: transform 0.25s ease;
    }
    .hero-btn-primary:hover svg {
      transform: translateX(3px);
    }
    /* Bouton secondaire : outline crème transparent */
    .hero-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 1.5rem;
      color: rgba(245, 241, 234, 0.95);
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: -0.005em;
      border-radius: 999px;
      border: 1px solid rgba(245, 241, 234, 0.28);
      background: rgba(245, 241, 234, 0.04);
      backdrop-filter: blur(6px);
      transition: background 0.25s ease, border-color 0.25s ease, color 0.2s ease;
    }
    .hero-btn-ghost:hover {
      background: rgba(245, 241, 234, 0.10);
      border-color: rgba(245, 241, 234, 0.5);
      color: #F5F1EA;
    }
    /* Animations */
    @keyframes heroKenBurns {
      0%   { transform: scale(1.04); }
      100% { transform: scale(1.14); }
    }
    .hero-img { animation: heroKenBurns 24s ease-out forwards; }
    @keyframes heroFade {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero-fade {
      animation: heroFade 0.8s cubic-bezier(0.22,1,0.36,1) both;
    }
    /* Indicateur scroll : ligne fine animée bas vers haut */
    .scroll-cue-line {
      display: block;
      width: 1px;
      height: 36px;
      background: linear-gradient(to bottom, rgba(245,241,234,0) 0%, rgba(245,241,234,0.6) 50%, rgba(245,241,234,0) 100%);
      transform-origin: top;
      animation: scrollCue 2.4s ease-in-out infinite;
    }
    @keyframes scrollCue {
      0%   { transform: scaleY(0.4) translateY(-30%); opacity: 0.25; }
      50%  { transform: scaleY(1) translateY(0); opacity: 0.9; }
      100% { transform: scaleY(0.4) translateY(30%); opacity: 0.25; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-img, .hero-fade, .hero-btn-primary, .hero-btn-primary svg, .hero-btn-ghost, .scroll-cue-line { animation: none !important; transition: none !important; }
      .hero-fade { opacity: 1; transform: none; }
    }
  </style>

  <TrustStrip variant="dark" />

  <!-- TROIS PORTES D'ENTRÉE : DISPOSITIF DE DÉCOUVERTE PRINCIPAL -->
  <section class="bg-bone-soft pt-12 md:pt-16 pb-20 md:pb-28 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-10 md:mb-14">
        <p class="eyebrow">Par où commencer</p>
        <h2 class="h2-hero mt-6">
          Trois portes d'entrée.<br /><span class="text-gradient">Vous choisissez la vôtre.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-ink/10">
        <!-- PORTE 1 : CARNET -->
        <a href="#carnet" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">01</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je cherche un prestataire</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Lieu, traiteur, son, scène, captation, photobooth… 12 catégories de prestataires sur lesquels on vous conseille les bons interlocuteurs locaux.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Voir le carnet
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- PORTE 2 : CLÉ EN MAIN -->
        <a href="/construire-mon-projet/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">02</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je veux un projet clé en main</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Vous nous confiez l'orchestration complète : scénographie, prestataires, pilotage, jour J. Un seul interlocuteur, une production rodée sur les grandes scènes.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Construire mon projet
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- PORTE 3 : ÉCHANGE DIRECT -->
        <a href="/contact/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">03</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je veux juste en parler</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Format, budget, prestataires fiables, lieux disponibles à votre date. On répond, sans engagement, sans intermédiaire commercial.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Demander un échange
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ANCRAGE GÉOGRAPHIQUE : ON EST LÀ, EN VRAI -->
  <section class="bg-bone py-20 md:py-28 border-t border-ink/10">
    <div class="container-wide">
      <!-- Header -->
      <div class="max-w-3xl mb-12 md:mb-14">
        <p class="eyebrow">Notre point d'ancrage</p>
        <h2 class="h2-hero mt-6">
          Basés à Meximieux,<br /><span class="text-gradient">au cœur de la Plaine de l'Ain.</span>
        </h2>
        <p class="mt-8 text-base md:text-lg leading-relaxed text-ink/70 max-w-2xl">
          Pas une boîte aux lettres. Un bureau, une vue, un ancrage local. Entre Lyon et Genève, à portée immédiate des sites industriels du PIPA et des grands groupes du bassin.
        </p>
      </div>

      <!-- KPI distances : 3 pills prominent en haut -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-ink/10 mb-10 md:mb-12">
        <div class="bg-bone-soft p-6 md:p-7 flex flex-col gap-1">
          <p class="text-[0.65rem] uppercase tracking-[0.22em] text-ink/55 font-medium">Lyon</p>
          <p class="mt-1 font-display text-2xl md:text-3xl font-semibold text-ink leading-none">45 km</p>
          <p class="text-sm text-ink/55">35 min via A42</p>
        </div>
        <div class="bg-bone-soft p-6 md:p-7 flex flex-col gap-1">
          <p class="text-[0.65rem] uppercase tracking-[0.22em] text-ink/55 font-medium">Bourg-en-Bresse</p>
          <p class="mt-1 font-display text-2xl md:text-3xl font-semibold text-ink leading-none">35 km</p>
          <p class="text-sm text-ink/55">30 min via A40</p>
        </div>
        <div class="bg-bone-soft p-6 md:p-7 flex flex-col gap-1">
          <p class="text-[0.65rem] uppercase tracking-[0.22em] text-ink/55 font-medium">Genève</p>
          <p class="mt-1 font-display text-2xl md:text-3xl font-semibold text-ink leading-none">90 km</p>
          <p class="text-sm text-ink/55">1 h 15 via A40</p>
        </div>
      </div>

      <!-- Bloc principal : photo + carte mieux liées dans un cadre commun -->
      <div class="bg-bone-soft border border-ink/10 overflow-hidden">
        <div class="grid lg:grid-cols-12">
          <!-- Photo vue bureau -->
          <div class="lg:col-span-4 relative aspect-[4/5] lg:aspect-auto cinema-grade">
            <img
              src="https://enjoylife.b-cdn.net/Epicentre/meximieux.jpg"
              alt="Vue depuis nos bureaux à Meximieux, Plaine de l'Ain"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent z-[3]"></div>
            <div class="absolute bottom-6 left-6 right-6 z-[4] text-bone">
              <p class="text-[0.6rem] uppercase tracking-[0.22em] text-bone/70 font-medium">Vue depuis nos bureaux</p>
              <p class="mt-2 text-lg md:text-xl font-semibold leading-tight">Meximieux<br /><span class="text-bone/70 font-normal text-sm md:text-base">45.91° N · 5.20° E</span></p>
            </div>
          </div>

          <!-- Carte géographique refondue (composition resserrée) -->
          <div class="lg:col-span-8 p-5 md:p-7 lg:p-8 flex flex-col gap-6">
            <div class="relative w-full">
              <svg viewBox="0 0 900 540" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Carte de la Plaine de l'Ain entre Lyon, Bourg-en-Bresse et Genève">
                <defs>
                  <radialGradient id="plaineFill2" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#00491b" stop-opacity="0.28" />
                    <stop offset="70%" stop-color="#00491b" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="#003707" stop-opacity="0.10" />
                  </radialGradient>
                  <pattern id="bugeyHillshade2" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line x1="0" y1="0" x2="0" y2="5" stroke="#003707" stroke-opacity="0.16" stroke-width="0.9" />
                  </pattern>
                  <radialGradient id="mexHalo2" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#00491b" stop-opacity="0.55" />
                    <stop offset="50%" stop-color="#00491b" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="#00491b" stop-opacity="0" />
                  </radialGradient>
                  <filter id="cityShadow2" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur in="SourceAlpha" stdDeviation="0.5" />
                    <feOffset dx="0" dy="0.5" result="offsetblur" />
                    <feFlood flood-color="#003707" flood-opacity="0.3" />
                    <feComposite in2="offsetblur" operator="in" />
                    <feMerge>
                      <feMergeNode />
                      <feMergeNode in="SourceGraphic" />
                    </feMerge>
                  </filter>
                </defs>

                <!-- Fond carte -->
                <rect width="900" height="540" fill="#EFEAE0" />

                <!-- Lac Léman (référence Genève) -->
                <path d="M 760 100 Q 805 88 840 105 Q 858 120 845 142 Q 815 156 775 148 Q 745 130 760 100 Z" fill="#003707" fill-opacity="0.25" />
                <text x="800" y="172" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#003707" fill-opacity="0.5" font-style="italic">lac Léman</text>

                <!-- Massif du Bugey (hachure relief) -->
                <path d="M 530 245 Q 600 230 670 250 Q 730 275 760 320 Q 780 370 770 415 Q 745 460 685 470 Q 615 470 555 445 Q 510 415 495 370 Q 490 305 530 245 Z" fill="url(#bugeyHillshade2)" />
                <text x="640" y="385" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#003707" fill-opacity="0.5" font-style="italic" letter-spacing="0.05em">massif du Bugey</text>

                <!-- Plaine de l'Ain (zone focale, plus grande et centrée) -->
                <ellipse cx="430" cy="320" rx="150" ry="105" fill="url(#plaineFill2)" stroke="#00491b" stroke-opacity="0.55" stroke-width="2" />
                <text x="430" y="225" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#003707" fill-opacity="0.55" font-style="italic" letter-spacing="0.08em">PLAINE DE L'AIN</text>

                <!-- Rhône (sud, courbe propre) -->
                <path d="M 800 430 Q 700 450 600 460 Q 480 465 380 455 Q 280 445 180 455 Q 110 460 70 470" stroke="#003707" stroke-opacity="0.45" stroke-width="2.8" fill="none" stroke-linecap="round" />
                <text x="490" y="485" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#003707" fill-opacity="0.55" font-style="italic">le Rhône</text>

                <!-- Rivière Ain -->
                <path d="M 425 110 Q 420 165 415 220 Q 415 275 410 330 Q 408 380 395 430" stroke="#003707" stroke-opacity="0.4" stroke-width="2" fill="none" stroke-linecap="round" />
                <text x="392" y="195" text-anchor="end" font-family="Inter, sans-serif" font-size="11" fill="#003707" fill-opacity="0.5" font-style="italic">l'Ain</text>

                <!-- Routes : A42 (Lyon ↔ Plaine ↔ Genève) -->
                <path d="M 90 460 Q 220 425 350 395 Q 480 365 600 320 Q 700 280 770 235 Q 800 215 815 195" stroke="#003707" stroke-opacity="0.32" stroke-width="1.4" fill="none" stroke-dasharray="6 4" />
                <text x="680" y="285" font-family="Inter, sans-serif" font-size="11" fill="#003707" fill-opacity="0.5" font-weight="700" letter-spacing="0.04em">A42</text>

                <!-- A40 (Bourg → Genève) -->
                <path d="M 425 105 Q 540 130 660 155 Q 740 175 800 165" stroke="#003707" stroke-opacity="0.28" stroke-width="1.4" fill="none" stroke-dasharray="6 4" />
                <text x="600" y="148" font-family="Inter, sans-serif" font-size="11" fill="#003707" fill-opacity="0.45" font-weight="700" letter-spacing="0.04em">A40</text>

                <!-- LYON (gros point + distance pill) -->
                <g filter="url(#cityShadow2)">
                  <circle cx="80" cy="450" r="8" fill="#003707" fill-opacity="0.7" />
                  <circle cx="80" cy="450" r="3.5" fill="#003707" />
                </g>
                <text x="80" y="478" text-anchor="middle" font-family="Inter, sans-serif" font-size="16" fill="#003707" font-weight="800" letter-spacing="-0.01em">Lyon</text>
                <g transform="translate(80, 495)">
                  <rect x="-44" y="-9" width="88" height="18" rx="9" fill="#F5F1EA" stroke="#003707" stroke-opacity="0.25" stroke-width="0.8" />
                  <text x="0" y="3" text-anchor="middle" font-family="Inter, sans-serif" font-size="9.5" fill="#003707" font-weight="600" letter-spacing="0.02em">45 km · 35 min</text>
                </g>

                <!-- BOURG-EN-BRESSE -->
                <g filter="url(#cityShadow2)">
                  <circle cx="425" cy="100" r="7" fill="#003707" fill-opacity="0.65" />
                  <circle cx="425" cy="100" r="3" fill="#003707" />
                </g>
                <text x="425" y="80" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" fill="#003707" font-weight="700">Bourg-en-Bresse</text>
                <g transform="translate(425, 60)">
                  <rect x="-42" y="-9" width="84" height="18" rx="9" fill="#F5F1EA" stroke="#003707" stroke-opacity="0.25" stroke-width="0.8" />
                  <text x="0" y="3" text-anchor="middle" font-family="Inter, sans-serif" font-size="9.5" fill="#003707" font-weight="600" letter-spacing="0.02em">35 km · 30 min</text>
                </g>

                <!-- GENÈVE -->
                <g filter="url(#cityShadow2)">
                  <circle cx="800" cy="155" r="8" fill="#003707" fill-opacity="0.7" />
                  <circle cx="800" cy="155" r="3.5" fill="#003707" />
                </g>
                <text x="800" y="200" text-anchor="middle" font-family="Inter, sans-serif" font-size="16" fill="#003707" font-weight="800" letter-spacing="-0.01em">Genève</text>
                <g transform="translate(800, 218)">
                  <rect x="-44" y="-9" width="88" height="18" rx="9" fill="#F5F1EA" stroke="#003707" stroke-opacity="0.25" stroke-width="0.8" />
                  <text x="0" y="3" text-anchor="middle" font-family="Inter, sans-serif" font-size="9.5" fill="#003707" font-weight="600" letter-spacing="0.02em">90 km · 1h15</text>
                </g>

                <!-- Villes Plaine -->
                <!-- PEROUGES -->
                <circle cx="335" cy="290" r="4.5" fill="#003707" />
                <text x="320" y="282" text-anchor="end" font-family="Inter, sans-serif" font-size="12" fill="#003707" font-weight="600">Pérouges</text>

                <!-- AMBERIEU-EN-BUGEY -->
                <circle cx="500" cy="270" r="4.5" fill="#003707" />
                <text x="515" y="265" text-anchor="start" font-family="Inter, sans-serif" font-size="12" fill="#003707" font-weight="600">Ambérieu-en-Bugey</text>

                <!-- LAGNIEU -->
                <circle cx="510" cy="345" r="4.5" fill="#003707" />
                <text x="525" y="350" text-anchor="start" font-family="Inter, sans-serif" font-size="12" fill="#003707" font-weight="600">Lagnieu</text>

                <!-- SAINT-VULBAS / PIPA -->
                <circle cx="445" cy="395" r="4.5" fill="#003707" />
                <text x="445" y="416" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#003707" font-weight="600">Saint-Vulbas</text>
                <text x="445" y="430" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#003707" fill-opacity="0.6" letter-spacing="0.12em" font-weight="800">PIPA</text>

                <!-- MEXIMIEUX (focal, gros halo + pin distinctif) -->
                <circle cx="395" cy="320" r="62" fill="url(#mexHalo2)" />
                <circle cx="395" cy="320" r="16" fill="#00491b" />
                <circle cx="395" cy="320" r="8.5" fill="#F5F1EA" />
                <circle cx="395" cy="320" r="3.5" fill="#003707" />
                <text x="395" y="298" text-anchor="middle" font-family="Inter, sans-serif" font-size="15" fill="#003707" font-weight="800" letter-spacing="-0.01em">Meximieux</text>
