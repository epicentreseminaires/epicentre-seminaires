---
import Base from '@/layouts/Base.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import CarnetIcon from '@/components/CarnetIcon.astro';
import { carnet } from '@/data/carnet';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

const title = "Agence événementielle Plaine de l'Ain | Epicentre Séminaires";
const description = "Agence événementielle dans la Plaine de l'Ain. Production clé en main + carnet d'adresses curaté (lieu, traiteur, son, scène, captation). On vous conseille les bons interlocuteurs.";

const heroImg = 'https://enjoylife.b-cdn.net/Epicentre/epicentre_hero.jpg';
---
<Base title={title} description={description} zone="plaine" theme="dark" transparentTop>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ink text-bone min-h-[88vh] flex items-center pt-30 md:pt-32 pb-20">
    <!-- Image plein cadre HD avec Ken Burns + grade cinéma (grain film + vignette) -->
    <div class="absolute inset-0 pointer-events-none cinema-grade" aria-hidden="true">
      <img
        src={heroImg}
        alt=""
        class="absolute inset-0 w-full h-full object-cover hero-img"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Dégradés : couche sombre côté gauche pour ancrer le texte, plus douce côté droit pour préserver la scène -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/30 to-transparent z-[3]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/30 z-[3]"></div>
    </div>

    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="hero-eyebrow hero-fade" style="animation-delay:0ms">
          <span class="block w-10 h-px bg-bone/55"></span>
          <span>Plaine de l'Ain · Entre Lyon et Genève</span>
        </p>

        <h1 class="hero-title !text-bone hero-fade mt-7 md:mt-9" style="animation-delay:100ms">
          Le bon contact,<br />
          <span class="text-gradient-bone">ou tout l'événement.</span>
        </h1>

        <p class="hero-lead hero-fade mt-7 md:mt-9 max-w-xl" style="animation-delay:250ms">
          Agence événementielle dans la Plaine de l'Ain. Vous choisissez le mode : un nom à appeler, ou une production complète clé en main.
        </p>

        <div class="hero-actions hero-fade mt-9 md:mt-11" style="animation-delay:400ms">
          <a href="/construire-mon-projet/" class="hero-btn-primary">
            <span>Construire mon projet</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#carnet" class="hero-btn-ghost">
            <span>Voir le carnet d'adresses</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Indicateur de scroll discret -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-10 pointer-events-none hero-fade" style="animation-delay:700ms" aria-hidden="true">
      <div class="flex flex-col items-center gap-1.5 text-bone/55">
        <span class="text-[0.6rem] uppercase tracking-[0.3em] font-medium">Découvrir</span>
        <span class="scroll-cue-line"></span>
      </div>
    </div>
  </section>

  <style>
    /* Eyebrow */
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.875rem;
      color: rgba(245, 241, 234, 0.75);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    /* Titre : taille raisonnable mais avec présence */
    .hero-title {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      font-weight: 600;
      font-size: clamp(2.75rem, 6.5vw, 5.25rem);
      letter-spacing: -0.04em;
      line-height: 0.98;
    }
    /* Lead court, calé sur la même grille typographique */
    .hero-lead {
      font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
      line-height: 1.55;
      color: rgba(245, 241, 234, 0.82);
    }
    /* Container de boutons */
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
    }
    /* Bouton primaire : crème plein, avec flèche qui glisse au hover */
    .hero-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      padding: 1rem 1.75rem;
      background: #F5F1EA;
      color: #003707;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: -0.005em;
      border-radius: 999px;
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.55);
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.2s ease;
    }
    .hero-btn-primary:hover {
      background: #FFFFFF;
      transform: translateY(-1px);
      box-shadow: 0 24px 50px -22px rgba(0, 0, 0, 0.6);
    }
    .hero-btn-primary svg {
      transition: transform 0.25s ease;
    }
    .hero-btn-primary:hover svg {
      transform: translateX(3px);
    }
    /* Bouton secondaire : outline crème transparent */
    .hero-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 1.5rem;
      color: rgba(245, 241, 234, 0.95);
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: -0.005em;
      border-radius: 999px;
      border: 1px solid rgba(245, 241, 234, 0.28);
      background: rgba(245, 241, 234, 0.04);
      backdrop-filter: blur(6px);
      transition: background 0.25s ease, border-color 0.25s ease, color 0.2s ease;
    }
    .hero-btn-ghost:hover {
      background: rgba(245, 241, 234, 0.10);
      border-color: rgba(245, 241, 234, 0.5);
      color: #F5F1EA;
    }
    /* Animations */
    @keyframes heroKenBurns {
      0%   { transform: scale(1.04); }
      100% { transform: scale(1.14); }
    }
    .hero-img { animation: heroKenBurns 24s ease-out forwards; }
    @keyframes heroFade {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero-fade {
      animation: heroFade 0.8s cubic-bezier(0.22,1,0.36,1) both;
    }
    /* Indicateur scroll : ligne fine animée bas vers haut */
    .scroll-cue-line {
      display: block;
      width: 1px;
      height: 36px;
      background: linear-gradient(to bottom, rgba(245,241,234,0) 0%, rgba(245,241,234,0.6) 50%, rgba(245,241,234,0) 100%);
      transform-origin: top;
      animation: scrollCue 2.4s ease-in-out infinite;
    }
    @keyframes scrollCue {
      0%   { transform: scaleY(0.4) translateY(-30%); opacity: 0.25; }
      50%  { transform: scaleY(1) translateY(0); opacity: 0.9; }
      100% { transform: scaleY(0.4) translateY(30%); opacity: 0.25; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-img, .hero-fade, .hero-btn-primary, .hero-btn-primary svg, .hero-btn-ghost, .scroll-cue-line { animation: none !important; transition: none !important; }
      .hero-fade { opacity: 1; transform: none; }
    }
  </style>

  <TrustStrip variant="dark" />

  <!-- TROIS PORTES D'ENTRÉE : DISPOSITIF DE DÉCOUVERTE PRINCIPAL -->
  <section class="bg-bone-soft pt-12 md:pt-16 pb-20 md:pb-28 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-10 md:mb-14">
        <p class="eyebrow">Par où commencer</p>
        <h2 class="h2-hero mt-6">
          Trois portes d'entrée.<br /><span class="text-gradient">Vous choisissez la vôtre.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-ink/10">
        <!-- PORTE 1 : CARNET -->
        <a href="#carnet" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">01</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je cherche un prestataire</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Lieu, traiteur, son, scène, captation, photobooth… 12 catégories de prestataires sur lesquels on vous conseille les bons interlocuteurs locaux.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Voir le carnet
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- PORTE 2 : CLÉ EN MAIN -->
        <a href="/construire-mon-projet/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">02</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je veux un projet clé en main</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Vous nous confiez l'orchestration complète : scénographie, prestataires, pilotage, jour J. Un seul interlocuteur, une production rodée sur les grandes scènes.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Construire mon projet
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- PORTE 3 : ÉCHANGE DIRECT -->
        <a href="/contact/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">03</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je veux juste en parler</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Format, budget, prestataires fiables, lieux disponibles à votre date. On répond, sans engagement, sans intermédiaire commercial.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Demander un échange
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ANCRAGE GÉOGRAPHIQUE : ON EST LÀ, EN VRAI -->
  <section class="bg-bone py-20 md:py-28 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow">Notre point d'ancrage</p>
        <h2 class="h2-hero mt-6">
          Basés à Meximieux,<br /><span class="text-gradient">au cœur de la Plaine de l'Ain.</span>
        </h2>
        <p class="mt-8 text-base md:text-lg leading-relaxed text-ink/70 max-w-2xl">
          Pas une boîte aux lettres. Un bureau, une vue, un ancrage local. Entre Lyon et Genève, à 30 minutes des deux, à portée des sites industriels du PIPA et des grands groupes du bassin.
        </p>
      </div>

      <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
        <!-- IMAGE VUE BUREAU (portrait, plus compacte) -->
        <div class="lg:col-span-4">
          <div class="relative overflow-hidden rounded-sm aspect-[3/4] cinema-grade">
            <img
              src="https://enjoylife.b-cdn.net/Epicentre/meximieux.jpg"
              alt="Vue depuis nos bureaux à Meximieux, Plaine de l'Ain"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent z-[3]"></div>
            <div class="absolute bottom-5 left-5 right-5 z-[4] text-bone">
              <p class="text-[0.6rem] uppercase tracking-[0.22em] text-bone/70 font-medium">Vue bureau</p>
              <p class="mt-1.5 text-sm md:text-base font-semibold leading-tight">Meximieux,<br />Plaine de l'Ain</p>
            </div>
          </div>
        </div>

        <!-- CARTE GÉOGRAPHIQUE RÉELLE + INFOS -->
        <div class="lg:col-span-8 flex flex-col">
          <div class="bg-bone-soft p-6 md:p-8 flex-1 flex flex-col gap-6">
            <!-- Carte géographique stylisée -->
            <div class="relative w-full">
              <svg viewBox="0 0 800 500" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Carte géographique de la Plaine de l'Ain entre Lyon, Bourg-en-Bresse et Genève">
                <defs>
                  <linearGradient id="brandGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#003707" />
                    <stop offset="100%" stop-color="#00491b" />
                  </linearGradient>
                  <pattern id="hillshade" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line x1="0" y1="0" x2="0" y2="6" stroke="#003707" stroke-opacity="0.18" stroke-width="1" />
                  </pattern>
                  <radialGradient id="meximieuxGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#00491b" stop-opacity="0.55" />
                    <stop offset="60%" stop-color="#00491b" stop-opacity="0.10" />
                    <stop offset="100%" stop-color="#00491b" stop-opacity="0" />
                  </radialGradient>
                </defs>

                <!-- Fond clair -->
                <rect width="800" height="500" fill="#EFEAE0" />

                <!-- Lac Léman au coin nord-est (référence Genève) -->
                <path d="M 720 60 Q 745 50 770 65 Q 780 75 770 90 Q 750 100 730 95 Q 715 85 720 60 Z" fill="#003707" fill-opacity="0.18" />
                <text x="745" y="115" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.45" font-style="italic">lac Léman</text>

                <!-- Bugey foothills (relief, hachure SE de la Plaine) -->
                <path d="M 360 200 Q 410 180 470 195 Q 540 210 600 240 Q 660 280 690 340 Q 700 400 660 440 Q 600 460 530 440 Q 460 420 400 380 Q 360 320 360 200 Z" fill="url(#hillshade)" fill-opacity="0.55" />
                <text x="540" y="370" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#003707" fill-opacity="0.5" font-style="italic" letter-spacing="0.05em">massif du Bugey</text>

                <!-- Région Plaine de l'Ain (polygone réaliste) -->
                <path d="M 200 200 Q 230 180 290 185 Q 340 195 360 240 Q 365 295 340 340 Q 310 380 260 380 Q 215 375 195 340 Q 175 290 200 200 Z"
                      fill="url(#brandGrad2)" fill-opacity="0.14" stroke="#00491b" stroke-opacity="0.45" stroke-width="1.5" />

                <!-- Rhône (rivière, courbe sud-est → sud-ouest, contourne Lyon) -->
                <path d="M 700 360 Q 620 380 540 410 Q 460 430 380 415 Q 320 405 280 395 Q 230 385 180 400 Q 130 415 90 440"
                      stroke="#00491b" stroke-opacity="0.45" stroke-width="2.5" fill="none" stroke-linecap="round" />
                <text x="500" y="445" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#00491b" fill-opacity="0.55" font-style="italic">le Rhône</text>

                <!-- Rivière Ain (du nord vers Rhône) -->
                <path d="M 280 80 Q 270 130 265 180 Q 260 230 270 280 Q 275 330 260 380"
                      stroke="#00491b" stroke-opacity="0.4" stroke-width="1.8" fill="none" stroke-linecap="round" />
                <text x="240" y="150" text-anchor="end" font-family="Inter, sans-serif" font-size="9" fill="#00491b" fill-opacity="0.5" font-style="italic">l'Ain</text>

                <!-- Autoroute A42 (Lyon → Plaine → Genève) -->
                <path d="M 90 380 Q 200 360 290 350 Q 380 340 480 320 Q 570 300 660 250 Q 720 200 740 150"
                      stroke="#003707" stroke-opacity="0.35" stroke-width="1.2" fill="none" stroke-dasharray="6 4" />
                <text x="630" y="290" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.45" font-weight="500">A42</text>

                <!-- LYON (référence ouest, gros point) -->
                <circle cx="80" cy="395" r="6" fill="#003707" fill-opacity="0.6" />
                <circle cx="80" cy="395" r="3" fill="#003707" />
                <text x="80" y="425" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" fill="#003707" font-weight="700" letter-spacing="-0.01em">Lyon</text>
                <text x="80" y="442" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#003707" fill-opacity="0.55">45 km · 35 min</text>

                <!-- BOURG-EN-BRESSE (nord) -->
                <circle cx="290" cy="80" r="5" fill="#003707" fill-opacity="0.55" />
                <circle cx="290" cy="80" r="2.5" fill="#003707" />
                <text x="290" y="65" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" fill="#003707" font-weight="600">Bourg-en-Bresse</text>
                <text x="290" y="50" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.55">35 km · 30 min</text>

                <!-- GENÈVE (référence est) -->
                <circle cx="745" cy="105" r="6" fill="#003707" fill-opacity="0.6" />
                <circle cx="745" cy="105" r="3" fill="#003707" />
                <text x="745" y="135" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" fill="#003707" font-weight="700" letter-spacing="-0.01em">Genève</text>
                <text x="745" y="152" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#003707" fill-opacity="0.55">90 km · 1h15</text>

                <!-- Villes Plaine de l'Ain : PEROUGES -->
                <circle cx="225" cy="265" r="3.5" fill="#003707" />
                <text x="225" y="252" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#003707" font-weight="500">Pérouges</text>

                <!-- AMBERIEU -->
                <circle cx="335" cy="225" r="3.5" fill="#003707" />
                <text x="335" y="212" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#003707" font-weight="500">Ambérieu</text>

                <!-- LAGNIEU -->
                <circle cx="345" cy="305" r="3.5" fill="#003707" />
                <text x="362" y="310" text-anchor="start" font-family="Inter, sans-serif" font-size="11" fill="#003707" font-weight="500">Lagnieu</text>

                <!-- SAINT-VULBAS (PIPA) -->
                <circle cx="290" cy="365" r="3.5" fill="#003707" />
                <text x="290" y="383" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#003707" font-weight="500">Saint-Vulbas</text>
                <text x="290" y="397" text-anchor="middle" font-family="Inter, sans-serif" font-size="8.5" fill="#003707" fill-opacity="0.55" letter-spacing="0.06em">PIPA</text>

                <!-- POINT MEXIMIEUX (mis en avant, halo + pin) -->
                <circle cx="265" cy="295" r="42" fill="url(#meximieuxGlow)" />
                <circle cx="265" cy="295" r="11" fill="url(#brandGrad2)" />
                <circle cx="265" cy="295" r="4" fill="#F5F1EA" />
                <text x="265" y="278" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" fill="#003707" font-weight="800" letter-spacing="-0.01em">Meximieux</text>
                <text x="265" y="320" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" font-weight="600" letter-spacing="0.12em">NOTRE BUREAU</text>

                <!-- Compass rose -->
                <g transform="translate(750, 460)">
                  <circle r="14" fill="#EFEAE0" stroke="#003707" stroke-opacity="0.4" stroke-width="1" />
                  <path d="M 0 -10 L 3 0 L 0 10 L -3 0 Z" fill="#003707" fill-opacity="0.55" />
                  <text y="-18" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" font-weight="700">N</text>
                </g>

                <!-- Échelle -->
                <g transform="translate(40, 470)">
                  <line x1="0" y1="0" x2="60" y2="0" stroke="#003707" stroke-opacity="0.55" stroke-width="2" />
                  <line x1="0" y1="-3" x2="0" y2="3" stroke="#003707" stroke-opacity="0.55" stroke-width="2" />
                  <line x1="60" y1="-3" x2="60" y2="3" stroke="#003707" stroke-opacity="0.55" stroke-width="2" />
                  <text x="30" y="16" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.6">10 km</text>
                </g>
              </svg>
            </div>

            <!-- Liste villes -->
            <div class="border-t border-ink/10 pt-5">
              <p class="eyebrow text-ink/55 mb-4">Bassin d'intervention</p>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-2 text-sm">
                <a href="/seminaire-meximieux/" class="text-ink/75 hover:text-accent transition-colors">Meximieux</a>
                <a href="/seminaire-amberieu-en-bugey/" class="text-ink/75 hover:text-accent transition-colors">Ambérieu</a>
                <a href="/seminaire-perouges/" class="text-ink/75 hover:text-accent transition-colors">Pérouges</a>
                <a href="/seminaire-lagnieu/" class="text-ink/75 hover:text-accent transition-colors">Lagnieu</a>
                <a href="/seminaire-saint-vulbas/" class="text-ink/75 hover:text-accent transition-colors">Saint-Vulbas</a>
                <a href="/agence-evenementielle-lyon/" class="text-ink/55 hover:text-accent transition-colors">Lyon est</a>
                <a href="/agence-evenementielle-bourg-en-bresse/" class="text-ink/55 hover:text-accent transition-colors">Bourg-en-Bresse</a>
                <a href="/agence-evenementielle-geneve/" class="text-ink/55 hover:text-accent transition-colors">Pays de Gex</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CARNET D'ADRESSES : BENTO GRID -->
  <section id="carnet" class="bg-bone py-24 md:py-32 border-t border-ink/10 scroll-mt-20">
    <div class="container-wide">
      <div class="max-w-3xl mb-12 md:mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="eyebrow">Le carnet d'adresses</p>
          <h2 class="h2-hero mt-6">
            On vous conseille,<br /><span class="text-gradient">jamais on impose.</span>
          </h2>
        </div>
        <a href="/conseiller/" class="text-sm text-accent font-medium flex items-center gap-2 hover:gap-3 transition-all whitespace-nowrap">
          Voir l'introduction du carnet
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
