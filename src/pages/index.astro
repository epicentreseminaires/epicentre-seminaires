---
import Base from '@/layouts/Base.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import ClientsLogos from '@/components/ClientsLogos.astro';
import Testimonials from '@/components/Testimonials.astro';
import FAQ from '@/components/FAQ.astro';
import StickyCTA from '@/components/StickyCTA.astro';

const title = "Epicentre Séminaires : Agence événementielle Plaine de l'Ain";
const description = "Agence de production événementielle pour les entreprises de la Plaine de l'Ain. Plénières, galas, congrès, lancements, captation vidéo. Renseignement, organisation, conseil de lieu. Lieu partenaire en Bourgogne pour les projets résidentiels.";

const heroImg = 'https://images.unsplash.com/photo-1442115597578-2d0fb2413734?w=2400&q=85&auto=format&fit=crop';
const epinacImg = 'https://images.unsplash.com/photo-1564540586988-aa4e53c3d799?w=1600&q=85&auto=format&fit=crop';
---

<Base title={title} description={description} zone="brand">
  <!-- HERO : pure agence Plaine de l'Ain -->
  <section class="relative min-h-screen overflow-hidden bg-ink flex flex-col">
    <img
      src={heroImg}
      alt="Plénière d'entreprise avec scénographie lumière"
      class="absolute inset-0 w-full h-full object-cover opacity-50"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/30 via-ink/40 to-ink"></div>

    <div class="relative z-10 flex-1 container-wide flex flex-col justify-end pb-20 md:pb-28 pt-32">
      <p class="eyebrow text-bone/60 mb-8">Agence événementielle · Plaine de l'Ain</p>
      <h1 class="text-bone display-xl max-w-6xl">
        Votre agence<br />événementielle<br /><span class="text-accent">dans la Plaine de l'Ain.</span>
      </h1>
      <p class="text-bone/70 max-w-2xl mt-10 text-lg md:text-xl leading-relaxed">
        Vous êtes une entreprise du bassin (industrie, énergie, aéronautique, services) ? Nous prenons en charge vos plénières, galas, congrès, lancements, captations. Sur la Plaine, à Lyon, où votre projet a le plus de sens.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="/contact/" class="btn-accent text-base px-8 py-4">
          Demander un devis
          <span aria-hidden="true">→</span>
        </a>
        <a href="#services" class="text-bone/80 hover:text-bone text-sm flex items-center gap-2 transition-colors">
          Voir nos services
        </a>
      </div>
    </div>

    <a href="#services" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-bone/50 text-[0.7rem] uppercase tracking-[0.2em] z-10 flex flex-col items-center gap-2">
      Découvrir
      <span class="block w-px h-8 bg-bone/40"></span>
    </a>
  </section>

  <TrustStrip variant="light" />

  <!-- 3 SERVICES -->
  <section id="services" class="bg-ink text-bone py-32">
    <div class="container-wide">
      <div class="max-w-3xl mb-20">
        <p class="eyebrow text-bone/50">Nos services</p>
        <h2 class="text-5xl md:text-7xl mt-6 leading-tight">
          Trois façons de<br />travailler avec nous.
        </h2>
        <p class="mt-8 text-bone/70 text-xl max-w-2xl">
          Selon votre besoin, nous intervenons au bon niveau. Du conseil ponctuel à la production complète.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-bone/10">
        <div class="bg-ink p-10 hover:bg-ink-soft transition-colors duration-500">
          <p class="text-accent font-display text-2xl">01</p>
          <h3 class="text-2xl md:text-3xl mt-4">Renseignement</h3>
          <p class="mt-4 text-bone/65 leading-relaxed">
            Vous avez un projet d'événement et vous voulez en parler à quelqu'un qui connaît le métier. Format, budget, prestataires fiables, lieux disponibles. On répond, on partage notre expérience. Sans engagement.
          </p>
        </div>
        <div class="bg-ink p-10 hover:bg-ink-soft transition-colors duration-500">
          <p class="text-accent font-display text-2xl">02</p>
          <h3 class="text-2xl md:text-3xl mt-4">Organisation</h3>
          <p class="mt-4 text-bone/65 leading-relaxed">
            Vous nous confiez la production complète : scénographie, scène, son, lumière, vidéo, captation, régie, coordination des prestataires. Un événement piloté de bout en bout, sans intermédiaire.
          </p>
        </div>
        <div class="bg-ink p-10 hover:bg-ink-soft transition-colors duration-500">
          <p class="text-accent font-display text-2xl">03</p>
          <h3 class="text-2xl md:text-3xl mt-4">Conseil de lieu</h3>
          <p class="mt-4 text-bone/65 leading-relaxed">
            Vous cherchez le bon lieu pour votre événement : à Ambérieu, dans la Plaine, à Pérouges, à Lyon ou ailleurs. On connaît les lieux du bassin et au-delà. Sourcing gratuit en amont du cadrage.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ClientsLogos />

  <!-- RÉASSURANCE / CHIFFRES -->
  <section class="py-32 bg-bone-soft">
    <div class="container-wide grid md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-5">
        <p class="eyebrow">L'expérience</p>
        <h2 class="text-5xl md:text-6xl mt-6">
          Une production rodée sur les plus grandes scènes.
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/75">
          Avant de fonder Epicentre, nous avons piloté des productions sur certaines des plus grandes scènes du sport et du spectacle français : devant des jauges de plusieurs milliers de spectateurs.
          Cette exigence opérationnelle, nous l'apportons aujourd'hui à chaque événement d'entreprise, qu'il s'agisse d'une plénière de 100 personnes ou d'une convention de 1 500.
        </p>
        <a href="/a-propos/" class="btn-outline mt-10">Notre histoire</a>
      </div>

      <div class="md:col-span-6 md:col-start-7 grid grid-cols-2 gap-4">
        <div class="bg-ink text-bone p-8 aspect-square flex flex-col justify-between">
          <p class="eyebrow text-bone/50">Productions</p>
          <p class="text-6xl font-semibold tracking-tightest">+150</p>
          <p class="text-sm text-bone/70">événements pilotés en propre ou en co-production</p>
        </div>
        <div class="bg-ink text-bone p-8 aspect-square flex flex-col justify-between mt-12">
          <p class="eyebrow text-bone/50">Capacité</p>
          <p class="text-6xl font-semibold tracking-tightest">1 500<span class="text-3xl">+</span></p>
          <p class="text-sm text-bone/70">spectateurs sur des plénières et galas grand format</p>
        </div>
        <div class="bg-bone p-8 aspect-square flex flex-col justify-between border border-ink/10">
          <p class="eyebrow">Captation</p>
          <p class="text-6xl font-semibold tracking-tightest">4K</p>
          <p class="text-sm text-ink/70">multicam, régie son lumière, diffusion live</p>
        </div>
        <div class="bg-bone p-8 aspect-square flex flex-col justify-between mt-12 border border-ink/10">
          <p class="eyebrow">Domaine partenaire</p>
          <p class="text-6xl font-semibold tracking-tightest">9 000<span class="text-3xl"> m²</span></p>
          <p class="text-sm text-ink/70">de parc privatisé en Bourgogne, à Épinac</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SAVOIR-FAIRE -->
  <section id="savoir-faire" class="bg-ink text-bone py-32">
    <div class="container-wide">
      <div class="max-w-3xl">
        <p class="eyebrow text-bone/50">Savoir-faire</p>
        <h2 class="text-5xl md:text-7xl mt-6">
          Ce que nous produisons.
        </h2>
        <p class="mt-8 text-bone/70 text-xl max-w-2xl">
          Notre niche : la production technique d'événements à enjeu. Scène, son, lumière, vidéo, captation. Pas d'animations gadgets, ni de salons.
        </p>
      </div>

      <div class="mt-20 grid md:grid-cols-3 gap-px bg-bone/10">
        {[
          { t: 'Plénières & conventions', d: 'Scénographie, mise en scène, captation multicam.' },
          { t: 'Galas & remises de prix', d: 'Dîner assis, scène, show, mise en lumière.' },
          { t: 'Lancements de produits', d: 'Reveal scénographié, presse, captation, diffusion.' },
          { t: 'Congrès & assemblées générales', d: 'Plénière, ateliers, restauration, retransmission.' },
          { t: 'Inaugurations', d: 'Discours officiel, scénographie, presse.' },
          { t: 'Concerts & shows d\'entreprise', d: 'Production technique son, lumière, vidéo, régie.' },
        ].map((item) => (
          <div class="bg-ink p-10 hover:bg-ink-soft transition-colors duration-500">
            <h3 class="text-2xl">{item.t}</h3>
            <p class="mt-3 text-bone/55 text-sm leading-relaxed">{item.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIEU PARTENAIRE EN BOURGOGNE -->
  <section class="bg-bone py-32">
    <div class="container-wide grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="relative aspect-[4/5] md:aspect-[3/4] overflow-hidden order-2 md:order-1">
        <img src={epinacImg} alt="Domaine partenaire en Bourgogne, à Épinac" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="order-1 md:order-2">
        <p class="eyebrow">Pour les projets ambitieux</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-tight">
          Un lieu partenaire,<br />en Bourgogne.
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/75">
          À <strong>Épinac, en Saône-et-Loire</strong>, un domaine familial partenaire offre 9 000 m² de parc privatisé pour les entreprises qui cherchent un cadre rare et un format résidentiel.
        </p>
        <p class="mt-6 text-lg leading-relaxed text-ink/75">
          Sur ce terrain, tout reste à imaginer : <strong>chapiteau cristal</strong>, <strong>plénière en plein air</strong>, <strong>salle modulaire sous les arbres</strong>, <strong>dîner gala dans le parc</strong>, <strong>dégustation de vin animée par un sommelier</strong>. Un cadre pensé pour les projets ambitieux, à 1h15 de Lyon, 2h30 de Paris.
        </p>
        <a href="/epinac/" class="btn-outline mt-10">Découvrir le domaine d'Épinac</a>
      </div>
    </div>
  </section>

  <Testimonials />

  <FAQ />

  <!-- CTA FINAL -->
  <section class="bg-ink text-bone py-32">
    <div class="container-wide text-center">
      <p class="eyebrow text-bone/50">Parlons de votre projet</p>
      <h2 class="text-5xl md:text-7xl max-w-4xl mx-auto mt-6">
        Un événement à produire ?<br /><span class="text-accent">On l'étudie sous 24 h.</span>
      </h2>
      <p class="mt-10 text-lg text-bone/70 max-w-xl mx-auto">
        Décrivez-nous votre projet en deux lignes. On vous rappelle dans la journée, sans engagement.
      </p>
      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a href="/contact/" class="btn-accent text-base px-8 py-4">
          Demander un devis
          <span aria-hidden="true">→</span>
        </a>
        <a href="tel:+33744980015" class="btn-outline border-bone/40 text-bone hover:bg-bone hover:text-ink">
          07 44 98 00 15
        </a>
      </div>
    </div>
  </section>

  <StickyCTA />
</Base>
