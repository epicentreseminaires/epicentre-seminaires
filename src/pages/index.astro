---
import Base from '@/layouts/Base.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import CarnetIcon from '@/components/CarnetIcon.astro';
import { carnet } from '@/data/carnet';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

const title = "Agence événementielle Plaine de l'Ain | Epicentre Séminaires";
const description = "Agence événementielle à Meximieux, Plaine de l'Ain. Modélisation 3D, production complète : plénière, inauguration PIPA, gala, convention. CEPA, Amblamex, Ain.";

const heroImg = 'https://enjoylife.b-cdn.net/Epicentre/epicentre_hero.jpg';
---
<Base title={title} description={description} zone="plaine" theme="dark" transparentTop>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ink text-bone min-h-[88vh] flex items-center pt-30 md:pt-32 pb-20">
    <!-- Image plein cadre HD avec Ken Burns + grade cinéma (grain film + vignette) -->
    <div class="absolute inset-0 pointer-events-none cinema-grade" aria-hidden="true">
      <img
        src={heroImg}
        alt=""
        class="absolute inset-0 w-full h-full object-cover hero-img"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Dégradés : couche sombre côté gauche pour ancrer le texte, plus douce côté droit pour préserver la scène -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/30 to-transparent z-[3]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/30 z-[3]"></div>
    </div>

    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="hero-eyebrow hero-fade" style="animation-delay:0ms">
          <span class="block w-10 h-px bg-bone/55"></span>
          <span>Plaine de l'Ain · Entre Lyon et Genève</span>
        </p>

        <h1 class="hero-title !text-bone hero-fade mt-7 md:mt-9" style="animation-delay:100ms">
          Vous voyez l'événement<br />
          <span class="text-gradient-bone">avant de le produire.</span>
        </h1>

        <p class="hero-lead hero-fade mt-7 md:mt-9 max-w-xl" style="animation-delay:250ms">
          Ingénierie de production événementielle dans la Plaine de l'Ain. Vous choisissez : un nom à appeler, ou une production intégrale de A à Z.
        </p>

        <div class="hero-actions hero-fade mt-9 md:mt-11" style="animation-delay:400ms">
          <a href="/construire-mon-projet/" class="hero-btn-primary">
            <span>Construire mon projet</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#carnet" class="hero-btn-ghost">
            <span>Voir le carnet d'adresses</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Indicateur de scroll discret -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-10 pointer-events-none hero-fade" style="animation-delay:700ms" aria-hidden="true">
      <div class="flex flex-col items-center gap-1.5 text-bone/55">
        <span class="text-[0.6rem] uppercase tracking-[0.3em] font-medium">Découvrir</span>
        <span class="scroll-cue-line"></span>
      </div>
    </div>
  </section>

  <style>
    /* Eyebrow */
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.875rem;
      color: rgba(245, 241, 234, 0.75);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    /* Titre : taille raisonnable mais avec présence */
    .hero-title {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      font-weight: 600;
      font-size: clamp(2.75rem, 6.5vw, 5.25rem);
      letter-spacing: -0.04em;
      line-height: 0.98;
    }
    /* Lead court, calé sur la même grille typographique */
    .hero-lead {
      font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
      line-height: 1.55;
      color: rgba(245, 241, 234, 0.82);
    }
    /* Container de boutons */
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
    }
    /* Bouton primaire : crème plein, avec flèche qui glisse au hover */
    .hero-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      padding: 1rem 1.75rem;
      background: #F5F1EA;
      color: #003707;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: -0.005em;
      border-radius: 999px;
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.55);
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.2s ease;
    }
    .hero-btn-primary:hover {
      background: #FFFFFF;
      transform: translateY(-1px);
      box-shadow: 0 24px 50px -22px rgba(0, 0, 0, 0.6);
    }
    .hero-btn-primary svg {
      transition: transform 0.25s ease;
    }
    .hero-btn-primary:hover svg {
      transform: translateX(3px);
    }
    /* Bouton secondaire : outline crème transparent */
    .hero-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 1.5rem;
      color: rgba(245, 241, 234, 0.95);
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: -0.005em;
      border-radius: 999px;
      border: 1px solid rgba(245, 241, 234, 0.28);
      background: rgba(245, 241, 234, 0.04);
      backdrop-filter: blur(6px);
      transition: background 0.25s ease, border-color 0.25s ease, color 0.2s ease;
    }
    .hero-btn-ghost:hover {
      background: rgba(245, 241, 234, 0.10);
      border-color: rgba(245, 241, 234, 0.5);
      color: #F5F1EA;
    }
    /* Animations */
    @keyframes heroKenBurns {
      0%   { transform: scale(1.04); }
      100% { transform: scale(1.14); }
    }
    .hero-img { animation: heroKenBurns 24s ease-out forwards; }
    @keyframes heroFade {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero-fade {
      animation: heroFade 0.8s cubic-bezier(0.22,1,0.36,1) both;
    }
    /* Indicateur scroll : ligne fine animée bas vers haut */
    .scroll-cue-line {
      display: block;
      width: 1px;
      height: 36px;
      background: linear-gradient(to bottom, rgba(245,241,234,0) 0%, rgba(245,241,234,0.6) 50%, rgba(245,241,234,0) 100%);
      transform-origin: top;
      animation: scrollCue 2.4s ease-in-out infinite;
    }
    @keyframes scrollCue {
      0%   { transform: scaleY(0.4) translateY(-30%); opacity: 0.25; }
      50%  { transform: scaleY(1) translateY(0); opacity: 0.9; }
      100% { transform: scaleY(0.4) translateY(30%); opacity: 0.25; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-img, .hero-fade, .hero-btn-primary, .hero-btn-primary svg, .hero-btn-ghost, .scroll-cue-line { animation: none !important; transition: none !important; }
      .hero-fade { opacity: 1; transform: none; }
    }
  </style>

  <TrustStrip variant="dark" />

  <!-- TROIS PORTES D'ENTRÉE : DISPOSITIF DE DÉCOUVERTE PRINCIPAL -->
  <section class="bg-bone-soft pt-12 md:pt-16 pb-20 md:pb-28 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-10 md:mb-14">
        <p class="eyebrow">Par où commencer</p>
        <h2 class="h2-hero mt-6">
          Trois portes d'entrée.<br /><span class="text-gradient">Vous choisissez la vôtre.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-ink/10">
        <!-- PORTE 1 : PRODUCTION -->
        <a href="/construire-mon-projet/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">01</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je veux confier mon projet</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Scénographie, prestataires, pilotage, modélisation 3D, régie jour J. Un seul interlocuteur, une production complète de A à Z.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Construire mon projet
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- PORTE 2 : ÉCHANGE DIRECT -->
        <a href="/contact/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">02</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je veux juste en parler</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Format, budget, lieu, date. On répond, sans engagement, sans intermédiaire commercial. Une conversation directe pour cadrer ce qui est possible.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Décrire mon besoin
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- PORTE 3 : CARNET -->
        <a href="/conseiller/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">03</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je cherche un prestataire</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Lieu, traiteur, son, scène, captation. On vous oriente vers les bons interlocuteurs locaux : critères, questions à poser, signaux d'alerte.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Voir le carnet d'adresses
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- MÉTHODE DIFFÉRENCIANTE : MODÉLISATION 3D -->
  <section class="bg-bone py-20 md:py-28 border-t border-ink/10">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
        <div>
          <p class="eyebrow">Notre méthode</p>
          <h2 class="h2-hero mt-6">
            Vous voyez l'événement<br /><span class="text-gradient">avant de le produire.</span>
          </h2>
          <p class="mt-8 text-base md:text-lg leading-relaxed text-ink/70">
            Avant de commander une heure de matériel, nous modélisons votre événement en 3D dans votre espace réel. Position de scène, son, lumière, flux d'accueil : vous validez le rendu. La production qui suit est l'exécution d'un plan déjà approuvé.
          </p>
          <p class="mt-4 text-base md:text-lg leading-relaxed text-ink/70">
            Pour un DG, un DRH ou un responsable de site, c'est la garantie de savoir ce qu'on achète avant de s'engager. Pas de description. Pas de promesse. Un rendu.
          </p>
          <a href="/journal/modelisation-3d-evenement-entreprise/" class="mt-8 inline-flex items-center gap-2 text-sm text-accent font-medium hover:gap-3 transition-all">
            Comprendre la méthode 3D
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>

        <div class="flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-bone-soft border border-ink/10 p-6 flex flex-col gap-2">
              <p class="text-[0.6rem] uppercase tracking-[0.22em] text-ink/45 font-medium">Format minimal</p>
              <p class="font-display text-3xl font-semibold text-ink leading-none">5</p>
              <p class="text-sm text-ink/60 leading-snug">personnes, comité de direction confidentiel</p>
            </div>
            <div class="bg-bone-soft border border-ink/10 p-6 flex flex-col gap-2">
              <p class="text-[0.6rem] uppercase tracking-[0.22em] text-ink/45 font-medium">Format maximal</p>
              <p class="font-display text-3xl font-semibold text-ink leading-none">5 000+</p>
              <p class="text-sm text-ink/60 leading-snug">personnes, plénière ou inauguration industrielle</p>
            </div>
          </div>
          <div class="bg-ink text-bone p-6 flex flex-col gap-4">
            <p class="text-[0.6rem] uppercase tracking-[0.22em] text-bone/45 font-medium">Territoire et institutions</p>
            <div class="flex flex-wrap gap-2">
              {['PIPA Saint-Vulbas', 'CEPA', 'Amblamex', 'CCPA', 'Ekinox Bourg', 'LDLC Arena', 'Groupama Stadium', 'Valexpo Oyonnax'].map(tag => (
                <span class="text-xs text-bone/70 border border-bone/20 px-2.5 py-1 rounded-full">{tag}</span>
              ))}
            </div>
            <p class="text-sm text-bone/60 leading-relaxed">Entreprises du PIPA, membres de la CEPA ou d'Amblamex : nous sommes votre agence de production locale.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ANCRAGE GÉOGRAPHIQUE : ON EST LÀ, EN VRAI -->
  <section class="bg-bone py-20 md:py-28 border-t border-ink/10">
    <div class="container-wide">
      <!-- Header -->
      <div class="max-w-3xl mb-12 md:mb-14">
        <p class="eyebrow">Notre point d'ancrage</p>
        <h2 class="h2-hero mt-6">
          Basés à Meximieux,<br /><span class="text-gradient">au cœur de la Plaine de l'Ain.</span>
        </h2>
        <p class="mt-8 text-base md:text-lg leading-relaxed text-ink/70 max-w-2xl">
          Pas une boîte aux lettres. Un bureau, une vue, un ancrage dans l'Ain. Nous travaillons avec les entreprises du PIPA, les membres de la CEPA, d'Amblamex et de la CCPA. Notre périmètre couvre tout le bassin : Montluel, Miribel, Ambérieu-en-Bugey, Lagnieu, Saint-Vulbas, Pérouges, Oyonnax et au-delà, entre Lyon et Genève.
        </p>
      </div>

      <!-- KPI distances : 3 pills prominent en haut -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-ink/10 mb-10 md:mb-12">
        <div class="bg-bone-soft p-6 md:p-7 flex flex-col gap-1">
          <p class="text-[0.65rem] uppercase tracking-[0.22em] text-ink/55 font-medium">Lyon</p>
          <p class="mt-1 font-display text-2xl md:text-3xl font-semibold text-ink leading-none">45 km</p>
          <p class="text-sm text-ink/55">35 min via A42</p>
        </div>
        <div class="bg-bone-soft p-6 md:p-7 flex flex-col gap-1">
          <p class="text-[0.65rem] uppercase tracking-[0.22em] text-ink/55 font-medium">Bourg-en-Bresse</p>
          <p class="mt-1 font-display text-2xl md:text-3xl font-semibold text-ink leading-none">35 km</p>
          <p class="text-sm text-ink/55">30 min via A40</p>
        </div>
        <div class="bg-bone-soft p-6 md:p-7 flex flex-col gap-1">
          <p class="text-[0.65rem] uppercase tracking-[0.22em] text-ink/55 font-medium">Genève</p>
          <p class="mt-1 font-display text-2xl md:text-3xl font-semibold text-ink leading-none">90 km</p>
          <p class="text-sm text-ink/55">1 h 15 via A40</p>
        </div>
      </div>

      <!-- Bloc principal : photo + carte mieux liées dans un cadre commun -->
      <div class="bg-bone-soft border border-ink/10 overflow-hidden">
        <div class="grid lg:grid-cols-12">
          <!-- Photo vue bureau -->
          <div class="lg:col-span-4 relative aspect-[4/5] lg:aspect-auto cinema-grade">
            <img
              src="https://enjoylife.b-cdn.net/Epicentre/meximieux.jpg"
              alt="Vue depuis nos bureaux à Meximieux, Plaine de l'Ain"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent z-[3]"></div>
            <div class="absolute bottom-6 left-6 right-6 z-[4] text-bone">
              <p class="text-[0.6rem] uppercase tracking-[0.22em] text-bone/70 font-medium">Vue depuis nos bureaux</p>
              <p class="mt-2 text-lg md:text-xl font-semibold leading-tight">Meximieux<br /><span class="text-bone/70 font-normal text-sm md:text-base">45.91° N · 5.20° E</span></p>
            </div>
          </div>

          <!-- Carte géographique refondue (composition resserrée) -->
          <div class="lg:col-span-8 p-5 md:p-7 lg:p-8 flex flex-col gap-6">
            <div class="relative w-full">
              <svg viewBox="0 0 900 540" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Carte de la Plaine de l'Ain entre Lyon, Bourg-en-Bresse et Genève">
                <defs>
                  <radialGradient id="gBugey" cx="45%" cy="50%" r="55%">
                    <stop offset="0%" stop-color="#B8CCBA" stop-opacity="0.85"/>
                    <stop offset="100%" stop-color="#B8CCBA" stop-opacity="0.08"/>
                  </radialGradient>
                  <radialGradient id="gPlaine" cx="50%" cy="50%" r="55%">
                    <stop offset="0%" stop-color="#00491b" stop-opacity="0.10"/>
                    <stop offset="100%" stop-color="#003707" stop-opacity="0.02"/>
                  </radialGradient>
                  <radialGradient id="gMex" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#00491b" stop-opacity="0.20"/>
                    <stop offset="100%" stop-color="#003707" stop-opacity="0"/>
                  </radialGradient>
                </defs>

                <!-- Fond -->
                <rect width="900" height="540" fill="#EBE5D9"/>

                <!-- Bugey — dégradé sage, plus de hachures -->
                <path d="M 535 238 Q 595 216 668 240 Q 742 266 772 320 Q 792 370 778 426 Q 750 472 684 480 Q 612 482 552 452 Q 504 420 494 368 Q 486 300 535 238 Z" fill="url(#gBugey)"/>
                <text x="634" y="384" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="#3C5C3C" fill-opacity="0.42" font-style="italic" letter-spacing="0.04em">Bugey</text>

                <!-- Lac Léman — bleu -->
                <path d="M 762 94 Q 806 80 844 100 Q 864 118 851 142 Q 821 158 779 148 Q 746 130 762 94 Z" fill="#86B5CF" fill-opacity="0.58"/>
                <text x="806" y="168" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" fill="#3A5E78" fill-opacity="0.62" font-style="italic">lac Léman</text>

                <!-- Rhône — bleu -->
                <path d="M 820 448 Q 718 460 608 462 Q 476 462 365 456 Q 252 448 145 456 Q 88 460 46 468" stroke="#86B5CF" stroke-opacity="0.72" stroke-width="3.5" fill="none" stroke-linecap="round"/>
                <text x="210" y="480" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" fill="#3A5E78" fill-opacity="0.52" font-style="italic">Rhône</text>

                <!-- Rivière Ain — bleu -->
                <path d="M 414 88 Q 411 152 407 218 Q 405 278 400 338 Q 396 388 383 448" stroke="#86B5CF" stroke-opacity="0.65" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <text x="390" y="166" text-anchor="end" font-family="Inter,sans-serif" font-size="9" fill="#3A5E78" fill-opacity="0.52" font-style="italic">l'Ain</text>

                <!-- A42 — guide discret -->
                <path d="M 100 450 Q 222 424 350 396 Q 476 368 594 326 Q 694 290 762 252 Q 793 234 812 216" stroke="#003707" stroke-opacity="0.12" stroke-width="2" fill="none" stroke-dasharray="8 5"/>
                <text x="682" y="287" font-family="Inter,sans-serif" font-size="9" fill="#003707" fill-opacity="0.32" font-weight="700" letter-spacing="0.08em">A42</text>

                <!-- A40 -->
                <path d="M 428 92 Q 546 118 664 148 Q 745 168 808 160" stroke="#003707" stroke-opacity="0.12" stroke-width="2" fill="none" stroke-dasharray="8 5"/>
                <text x="606" y="140" font-family="Inter,sans-serif" font-size="9" fill="#003707" fill-opacity="0.32" font-weight="700" letter-spacing="0.08em">A40</text>

                <!-- Zone Plaine de l'Ain — très subtile -->
                <ellipse cx="418" cy="318" rx="148" ry="100" fill="url(#gPlaine)" stroke="#00491b" stroke-opacity="0.15" stroke-width="1.5" stroke-dasharray="5 4"/>
                <text x="418" y="228" text-anchor="middle" font-family="Inter,sans-serif" font-size="8" fill="#003707" fill-opacity="0.38" letter-spacing="0.2em" font-weight="700">PLAINE DE L'AIN</text>

                <!-- Villes secondaires -->
                <circle cx="328" cy="286" r="3.5" fill="#003707" fill-opacity="0.52"/>
                <text x="316" y="280" text-anchor="end" font-family="Inter,sans-serif" font-size="11.5" fill="#003707" fill-opacity="0.80" font-weight="500">Pérouges</text>

                <circle cx="492" cy="262" r="3.5" fill="#003707" fill-opacity="0.52"/>
                <text x="502" y="257" text-anchor="start" font-family="Inter,sans-serif" font-size="11.5" fill="#003707" fill-opacity="0.80" font-weight="500">Ambérieu</text>

                <circle cx="512" cy="342" r="3.5" fill="#003707" fill-opacity="0.52"/>
                <text x="522" y="347" text-anchor="start" font-family="Inter,sans-serif" font-size="11.5" fill="#003707" fill-opacity="0.80" font-weight="500">Lagnieu</text>

                <circle cx="448" cy="388" r="3.5" fill="#003707" fill-opacity="0.52"/>
                <text x="448" y="404" text-anchor="middle" font-family="Inter,sans-serif" font-size="11.5" fill="#003707" fill-opacity="0.80" font-weight="500">Saint-Vulbas</text>
                <rect x="424" y="408" width="48" height="13" rx="6.5" fill="#003707" fill-opacity="0.09"/>
                <text x="448" y="418" text-anchor="middle" font-family="Inter,sans-serif" font-size="8" fill="#003707" fill-opacity="0.58" font-weight="700" letter-spacing="0.1em">PIPA</text>

                <!-- LYON -->
                <circle cx="82" cy="445" r="11" fill="#003707" fill-opacity="0.09" stroke="#003707" stroke-opacity="0.28" stroke-width="1.5"/>
                <circle cx="82" cy="445" r="5.5" fill="#003707" fill-opacity="0.62"/>
