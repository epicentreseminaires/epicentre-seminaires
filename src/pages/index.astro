---
import Base from '@/layouts/Base.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import FAQ from '@/components/FAQ.astro';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

const title = "Agence événementielle Plaine de l'Ain | Epicentre Séminaires";
const description = "Agence événementielle dans la Plaine de l'Ain. Plénières, galas, congrès, lancements, captation pour les entreprises du bassin (Ambérieu, PIPA, Pérouges).";

// Visuel hero : scène événementielle abstraite (lumière, fumée), sobre, premium.
const heroImg = 'https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=2000&q=85&auto=format&fit=crop';
---

<Base title={title} description={description} zone="brand" theme="light">
  <!-- HERO clair premium : container centré, typo dominante, image en deuxième temps -->
  <section class="bg-bone pt-32 md:pt-40 pb-20 md:pb-28 relative overflow-hidden">
    <div class="container-wide">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7 relative z-10">
          <div class="flex items-center gap-3 mb-8">
            <span class="block w-8 h-px bg-ink/30"></span>
            <p class="text-[0.7rem] uppercase tracking-[0.22em] text-ink/55 font-medium">
              Plaine de l'Ain · Entre Lyon et Genève
            </p>
          </div>

          <h1 class="font-display font-semibold text-ink text-[2.75rem] sm:text-5xl md:text-6xl lg:text-[4.5rem] leading-[0.96] tracking-[-0.04em]">
            Votre agence événementielle dans la Plaine de l'Ain.
          </h1>

          <p class="mt-8 text-lg md:text-xl leading-relaxed text-ink/70 max-w-xl">
            Un acteur local capable de produire votre événement au niveau des plus grandes scènes. Plénières, conventions, galas, lancements, captation vidéo.
          </p>

          <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="/plaine-de-lain/contact/" class="btn-accent text-sm px-7 py-4">
              Demander un devis
              <span aria-hidden="true">→</span>
            </a>
            <a href={CONTACT_PHONE_HREF} class="text-ink/85 hover:text-ink text-sm font-semibold flex items-center gap-2 transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{CONTACT_PHONE_DISPLAY}</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative aspect-[4/5] overflow-hidden bg-ink-soft rounded-sm">
            <img
              src={heroImg}
              alt="Scène événementielle, mise en lumière et atmosphère technique"
              class="absolute inset-0 w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip variant="light" />

  <!-- MÉTHODE 3D : l'angle différenciant -->
  <section class="py-28 md:py-36 bg-bone-soft">
    <div class="container-wide">
      <div class="max-w-3xl mb-20">
        <p class="eyebrow">Notre méthode</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.03em]">
          Vous voyez votre événement<br /><span class="text-accent">avant qu'il ait lieu.</span>
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/70 max-w-2xl">
          Avant le devis, avant le brief technique, le pilotage commence par la modélisation 3D. Une représentation à l'échelle du dispositif, des espaces, des flux et des points de scène. Tout le monde voit la même chose, à la même seconde.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-ink/10">
        <div class="bg-bone-soft p-10">
          <p class="text-accent font-display text-2xl">01</p>
          <h3 class="text-2xl mt-5 leading-tight">Validation client</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Le client voit son événement avant de signer : implantation, scène, jauge, parcours invité. Plus besoin de projeter dans le vide. Les arbitrages se font sur du concret, pas sur des descriptions.
          </p>
        </div>
        <div class="bg-bone-soft p-10">
          <p class="text-accent font-display text-2xl">02</p>
          <h3 class="text-2xl mt-5 leading-tight">Brief des prestataires</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Régie son, lumière, structure, traiteur, sécurité : chacun reçoit un référentiel partagé, à l'échelle, en cotes. Les briefs sont traduits en plans techniques, pas en mots qui se perdent.
          </p>
        </div>
        <div class="bg-bone-soft p-10">
          <p class="text-accent font-display text-2xl">03</p>
          <h3 class="text-2xl mt-5 leading-tight">Coordination des équipes</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Logistique, technique, accueil : la 3D devient le langage commun de la production. Le jour J, plus personne ne découvre le dispositif. Tout a été vu, validé, ajusté en amont.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TROIS SERVICES -->
  <section id="services" class="bg-bone py-28 md:py-36">
    <div class="container-wide">
      <div class="max-w-3xl mb-20">
        <p class="eyebrow">Nos services</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.03em]">
          Trois façons<br />de travailler ensemble.
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/70 max-w-2xl">
          Selon votre besoin, l'agence intervient au bon niveau. Du conseil ponctuel à la production complète, sans intermédiaire commercial.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-ink/10">
        <div class="bg-bone p-10 hover:bg-bone-soft transition-colors duration-300">
          <p class="text-accent font-display text-2xl">01</p>
          <h3 class="text-2xl mt-5 leading-tight">Conseil</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Vous avez un projet d'événement et vous voulez en parler à quelqu'un qui connaît le métier. Format, budget, prestataires, lieux disponibles. Premier échange sans engagement.
          </p>
        </div>
        <div class="bg-bone p-10 hover:bg-bone-soft transition-colors duration-300">
          <p class="text-accent font-display text-2xl">02</p>
          <h3 class="text-2xl mt-5 leading-tight">Production complète</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Vous confiez la production de bout en bout : scénographie 3D, scène, son, lumière, vidéo, captation, régie, coordination des prestataires. Un événement piloté, sans intermédiaire.
          </p>
        </div>
        <div class="bg-bone p-10 hover:bg-bone-soft transition-colors duration-300">
          <p class="text-accent font-display text-2xl">03</p>
          <h3 class="text-2xl mt-5 leading-tight">Sourcing de lieu</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Vous cherchez le bon lieu pour votre événement : dans la Plaine de l'Ain, à Ambérieu, à Pérouges, à Lyon. Sourcing en amont du cadrage, sur la base d'une connaissance fine du territoire.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- QUEL FORMAT POUR QUEL ENJEU -->
  <section class="bg-bone-soft py-28 md:py-36">
    <div class="container-wide">
      <div class="max-w-3xl mb-20">
        <p class="eyebrow">Quel format pour quel enjeu</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.03em]">
          Vous savez ce que vous voulez dire.<br /><span class="text-accent">Le format suit l'objectif.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-ink/10">
        {[
          {
            enjeu: "Convention annuelle, séminaire d'intégration",
            format: 'Plénière scénographiée, ateliers, dîner gala',
            d: "Aligner les équipes, transmettre la stratégie, créer du lien. Scène, captation multicam, mise en lumière, animation des moments forts. Format 1 à 2 jours.",
          },
          {
            enjeu: 'Lancement de produit ou de gamme',
            format: 'Reveal scénographié, presse, soirée privée',
            d: "Marquer un moment vis-à-vis du marché, de la presse, de la distribution et des équipes internes. Mise en scène du produit, dispositif sur-mesure, captation diffusable.",
          },
          {
            enjeu: "Anniversaire d'entreprise (5, 10, 25 ans)",
            format: 'Gala scénographié, show, archive corporate',
            d: "Célébrer, fédérer, marquer durablement. Dîner assis ou cocktail haut de gamme, intervention show ou musicale, captation pour archive corporate sur le long terme.",
          },
          {
            enjeu: 'Inauguration, livraison de bâtiment, AG',
            format: 'Discours officiels, scénographie sobre, presse',
            d: "Moment institutionnel : élus locaux, presse régionale, partenaires, équipes. Plan de prévention industriel, scénographie précise, captation pour archive corporate.",
          },
        ].map((item) => (
          <div class="bg-bone-soft p-10 hover:bg-bone transition-colors duration-300">
            <p class="eyebrow text-ink/55">{item.enjeu}</p>
            <h3 class="text-xl md:text-2xl mt-5 leading-snug">{item.format}</h3>
            <p class="mt-4 text-ink/65 text-sm leading-relaxed">{item.d}</p>
          </div>
        ))}
      </div>

      <div class="mt-16 max-w-3xl text-ink/65 text-base leading-relaxed">
        <p>
          Vous ne reconnaissez pas votre enjeu dans cette liste ? <a href="/plaine-de-lain/contact/" class="text-accent hover:underline underline-offset-4">Décrivez-nous votre projet</a>. Cadrer le bon format à partir de l'objectif réel, c'est précisément le rôle d'une session de conseil en amont.
        </p>
      </div>
    </div>
  </section>

  <!-- EXPÉRIENCE : section sombre pour le contraste -->
  <section class="bg-ink text-bone py-28 md:py-36">
    <div class="container-wide grid md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-6">
        <p class="eyebrow text-bone/55">L'expérience</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.03em]">
          Une production rodée<br /><span class="text-accent">sur les plus grandes scènes.</span>
        </h2>
      </div>
      <div class="md:col-span-6 space-y-6 text-lg leading-relaxed text-bone/75">
        <p>
          Epicentre apporte aux entreprises de la Plaine de l'Ain une culture de production technique forgée sur les plus grandes scènes lyonnaises du sport et du spectacle.
        </p>
        <p>
          La même exigence opérationnelle : doublage des éléments critiques, plans de prévention écrits, rétroplanning calé, équipe sur place. Un événement n'est jamais qu'un programme : c'est un dispositif technique vivant, où chaque détail compte.
        </p>
        <a href="/a-propos/" class="btn-outline border-bone/30 text-bone hover:bg-bone hover:text-ink mt-4 inline-flex">
          Notre histoire
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <FAQ />

  <!-- CTA FINAL -->
  <section class="bg-bone py-28 md:py-36">
    <div class="container-wide text-center max-w-3xl mx-auto">
      <p class="eyebrow">Parlons de votre projet</p>
      <h2 class="text-4xl md:text-6xl lg:text-7xl max-w-4xl mx-auto mt-6 leading-[1] tracking-[-0.04em]">
        Un événement à produire ?<br /><span class="text-accent">Décrivez-le nous.</span>
      </h2>
      <p class="mt-10 text-lg text-ink/70 max-w-xl mx-auto leading-relaxed">
        Quelques lignes sur votre projet, votre format, votre jauge, votre date. Nous revenons vers vous, sans engagement.
      </p>
      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a href="/plaine-de-lain/contact/" class="btn-accent text-base px-8 py-4">
          Demander un devis
          <span aria-hidden="true">→</span>
        </a>
        <a href={CONTACT_PHONE_HREF} class="btn-outline">
          {CONTACT_PHONE_DISPLAY}
        </a>
      </div>
    </div>
  </section>
</Base>
