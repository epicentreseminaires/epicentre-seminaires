---
import Base from '@/layouts/Base.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import CarnetIcon from '@/components/CarnetIcon.astro';
import { carnet } from '@/data/carnet';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

const title = "Agence événementielle Plaine de l'Ain | Epicentre Séminaires";
const description = "Agence événementielle dans la Plaine de l'Ain. Production clé en main + carnet d'adresses curaté (lieu, traiteur, son, scène, captation). On vous conseille les bons interlocuteurs.";

const heroImg = 'https://enjoylife.b-cdn.net/Epicentre/epicentre_hero.jpg';
---
<Base title={title} description={description} zone="plaine" theme="dark" transparentTop>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-ink text-bone min-h-[82vh] flex items-center pt-28 md:pt-32 pb-16">
    <!-- Image plein cadre HD avec Ken Burns + grade cinéma (grain film + vignette) -->
    <div class="absolute inset-0 pointer-events-none cinema-grade" aria-hidden="true">
      <img
        src={heroImg}
        alt=""
        class="absolute inset-0 w-full h-full object-cover hero-img"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Dégradés : couche sombre côté gauche pour ancrer le texte, plus douce côté droit pour préserver la scène -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/30 to-transparent z-[3]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/30 z-[3]"></div>
    </div>

    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <p class="hero-eyebrow hero-fade" style="animation-delay:0ms">
          <span class="block w-10 h-px bg-bone/55"></span>
          <span>Plaine de l'Ain · Entre Lyon et Genève</span>
        </p>

        <h1 class="hero-title !text-bone hero-fade mt-7 md:mt-9" style="animation-delay:100ms">
          Le bon contact,<br />
          <span class="text-gradient-bone">ou tout l'événement.</span>
        </h1>

        <p class="hero-lead hero-fade mt-7 md:mt-9 max-w-xl" style="animation-delay:250ms">
          Agence événementielle dans la Plaine de l'Ain. Vous choisissez le mode : un nom à appeler, ou une production complète clé en main.
        </p>

        <div class="hero-actions hero-fade mt-9 md:mt-11" style="animation-delay:400ms">
          <a href="/construire-mon-projet/" class="hero-btn-primary">
            <span>Construire mon projet</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#carnet" class="hero-btn-ghost">
            <span>Voir le carnet d'adresses</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Eyebrow */
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.875rem;
      color: rgba(245, 241, 234, 0.75);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    /* Titre : taille raisonnable mais avec présence */
    .hero-title {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      font-weight: 600;
      font-size: clamp(2.75rem, 6.5vw, 5.25rem);
      letter-spacing: -0.04em;
      line-height: 0.98;
    }
    /* Lead court, calé sur la même grille typographique */
    .hero-lead {
      font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
      line-height: 1.55;
      color: rgba(245, 241, 234, 0.82);
    }
    /* Container de boutons */
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
    }
    /* Bouton primaire : crème plein, avec flèche qui glisse au hover */
    .hero-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      padding: 1rem 1.75rem;
      background: #F5F1EA;
      color: #003707;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: -0.005em;
      border-radius: 999px;
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.55);
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.2s ease;
    }
    .hero-btn-primary:hover {
      background: #FFFFFF;
      transform: translateY(-1px);
      box-shadow: 0 24px 50px -22px rgba(0, 0, 0, 0.6);
    }
    .hero-btn-primary svg {
      transition: transform 0.25s ease;
    }
    .hero-btn-primary:hover svg {
      transform: translateX(3px);
    }
    /* Bouton secondaire : outline crème transparent */
    .hero-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 1.5rem;
      color: rgba(245, 241, 234, 0.95);
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: -0.005em;
      border-radius: 999px;
      border: 1px solid rgba(245, 241, 234, 0.28);
      background: rgba(245, 241, 234, 0.04);
      backdrop-filter: blur(6px);
      transition: background 0.25s ease, border-color 0.25s ease, color 0.2s ease;
    }
    .hero-btn-ghost:hover {
      background: rgba(245, 241, 234, 0.10);
      border-color: rgba(245, 241, 234, 0.5);
      color: #F5F1EA;
    }
    /* Animations */
    @keyframes heroKenBurns {
      0%   { transform: scale(1.04); }
      100% { transform: scale(1.14); }
    }
    .hero-img { animation: heroKenBurns 24s ease-out forwards; }
    @keyframes heroFade {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero-fade {
      animation: heroFade 0.8s cubic-bezier(0.22,1,0.36,1) both;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-img, .hero-fade, .hero-btn-primary, .hero-btn-primary svg, .hero-btn-ghost { animation: none !important; transition: none !important; }
      .hero-fade { opacity: 1; transform: none; }
    }
  </style>

  <TrustStrip variant="dark" />

  <!-- TROIS PORTES D'ENTRÉE : DISPOSITIF DE DÉCOUVERTE PRINCIPAL -->
  <section class="bg-bone-soft py-20 md:py-28 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow">Par où commencer</p>
        <h2 class="h2-hero mt-6">
          Trois portes d'entrée.<br /><span class="text-gradient">Vous choisissez la vôtre.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-ink/10">
        <!-- PORTE 1 : CARNET -->
        <a href="#carnet" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">01</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je cherche un prestataire</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Lieu, traiteur, son, scène, captation, photobooth… 12 catégories de prestataires sur lesquels on vous conseille les bons interlocuteurs locaux.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Voir le carnet
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- PORTE 2 : CLÉ EN MAIN -->
        <a href="/construire-mon-projet/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">02</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je veux un projet clé en main</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Vous nous confiez l'orchestration complète : scénographie, prestataires, pilotage, jour J. Un seul interlocuteur, une production rodée sur les grandes scènes.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Construire mon projet
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>

        <!-- PORTE 3 : ÉCHANGE DIRECT -->
        <a href="/contact/" class="group bg-bone-soft hover:bg-bone p-8 md:p-10 transition-colors duration-300 flex flex-col">
          <p class="text-accent font-display text-2xl">03</p>
          <h3 class="text-2xl mt-5 leading-tight font-semibold">Je veux juste en parler</h3>
          <p class="mt-4 text-ink/65 leading-relaxed flex-1">
            Format, budget, prestataires fiables, lieux disponibles à votre date. On répond, sans engagement, sans intermédiaire commercial.
          </p>
          <span class="mt-8 text-sm text-accent font-medium flex items-center gap-2 group-hover:gap-3 transition-all">
            Demander un échange
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ANCRAGE GÉOGRAPHIQUE : ON EST LÀ, EN VRAI -->
  <section class="bg-bone py-20 md:py-28 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow">Notre point d'ancrage</p>
        <h2 class="h2-hero mt-6">
          Basés à Meximieux,<br /><span class="text-gradient">au cœur de la Plaine de l'Ain.</span>
        </h2>
        <p class="mt-8 text-base md:text-lg leading-relaxed text-ink/70 max-w-2xl">
          Pas une boîte aux lettres. Un bureau, une vue, un ancrage local. Entre Lyon et Genève, à 30 minutes des deux, à portée des sites industriels du PIPA et des grands groupes du bassin.
        </p>
      </div>

      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
        <!-- IMAGE VUE BUREAU -->
        <div class="lg:col-span-7 relative overflow-hidden rounded-sm">
          <div class="relative aspect-[4/3] cinema-grade">
            <img
              src="https://enjoylife.b-cdn.net/Epicentre/meximieux.jpg"
              alt="Vue depuis nos bureaux à Meximieux, Plaine de l'Ain"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-[3]"></div>
            <div class="absolute bottom-5 left-5 right-5 z-[4] text-bone">
              <p class="text-[0.65rem] uppercase tracking-[0.22em] text-bone/70 font-medium">Vue depuis nos bureaux</p>
              <p class="mt-1.5 text-sm md:text-base font-semibold">Meximieux, Plaine de l'Ain</p>
            </div>
          </div>
        </div>

        <!-- CARTE STYLISÉE + INFOS -->
        <div class="lg:col-span-5 flex flex-col">
          <div class="bg-bone-soft p-7 md:p-8 flex-1 flex flex-col justify-between gap-8">
            <!-- Carte SVG stylisée -->
            <div class="relative">
              <svg viewBox="0 0 400 240" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Carte de la Plaine de l'Ain entre Lyon et Genève">
                <!-- Fond pointillé subtil -->
                <defs>
                  <pattern id="dots" width="14" height="14" patternUnits="userSpaceOnUse">
                    <circle cx="2" cy="2" r="0.7" fill="#003707" fill-opacity="0.10" />
                  </pattern>
                  <linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#003707" />
                    <stop offset="100%" stop-color="#00491b" />
                  </linearGradient>
                </defs>
                <rect width="400" height="240" fill="url(#dots)" />

                <!-- Fleuve / axe Rhône stylisé (horizontal léger) -->
                <path d="M 0 145 Q 100 130 200 140 T 400 130" stroke="#00491b" stroke-opacity="0.18" stroke-width="1.2" fill="none" stroke-dasharray="3 3" />

                <!-- Région Plaine de l'Ain (forme organique abstraite) -->
                <path d="M 130 105 Q 165 90 215 95 Q 255 100 270 130 Q 265 165 220 175 Q 175 180 145 165 Q 120 145 130 105 Z"
                      fill="url(#brandGrad)" fill-opacity="0.10" stroke="#00491b" stroke-opacity="0.3" stroke-width="1" />

                <!-- Ville LYON (référence ouest) -->
                <circle cx="50" cy="155" r="3.5" fill="#00491b" fill-opacity="0.4" />
                <text x="50" y="175" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#00491b" fill-opacity="0.55" font-weight="500">Lyon</text>
                <text x="50" y="188" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.4">45 km · 35 min</text>

                <!-- Ville BOURG-EN-BRESSE -->
                <circle cx="135" cy="55" r="3" fill="#00491b" fill-opacity="0.4" />
                <text x="135" y="44" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="#00491b" fill-opacity="0.55" font-weight="500">Bourg-en-Bresse</text>

                <!-- Ville PEROUGES -->
                <circle cx="155" cy="120" r="2.5" fill="#003707" fill-opacity="0.5" />
                <text x="155" y="111" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.55">Pérouges</text>

                <!-- Ville AMBERIEU -->
                <circle cx="220" cy="115" r="2.5" fill="#003707" fill-opacity="0.5" />
                <text x="220" y="106" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.55">Ambérieu</text>

                <!-- Ville LAGNIEU -->
                <circle cx="240" cy="155" r="2.5" fill="#003707" fill-opacity="0.5" />
                <text x="245" y="167" text-anchor="start" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.55">Lagnieu</text>

                <!-- Ville SAINT-VULBAS (PIPA) -->
                <circle cx="195" cy="170" r="2.5" fill="#003707" fill-opacity="0.5" />
                <text x="195" y="190" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.55">Saint-Vulbas</text>

                <!-- Ville GENEVE (référence est) -->
                <circle cx="355" cy="120" r="3.5" fill="#00491b" fill-opacity="0.4" />
                <text x="355" y="105" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#00491b" fill-opacity="0.55" font-weight="500">Genève</text>
                <text x="355" y="92" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="#003707" fill-opacity="0.4">90 km · 1h15</text>

                <!-- POINT MEXIMIEUX (mis en avant) -->
                <circle cx="170" cy="138" r="14" fill="url(#brandGrad)" fill-opacity="0.18" />
                <circle cx="170" cy="138" r="8" fill="url(#brandGrad)" fill-opacity="0.35" />
                <circle cx="170" cy="138" r="4.5" fill="url(#brandGrad)" />
                <circle cx="170" cy="138" r="1.6" fill="#F5F1EA" />
                <text x="170" y="125" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#003707" font-weight="700" letter-spacing="-0.01em">Meximieux</text>
                <text x="170" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="8.5" fill="#003707" fill-opacity="0.6" letter-spacing="0.06em">NOTRE BUREAU</text>
              </svg>
            </div>

            <!-- Liste villes -->
            <div class="border-t border-ink/10 pt-6">
              <p class="eyebrow text-ink/55 mb-4">Bassin d'intervention</p>
              <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                <a href="/seminaire-meximieux/" class="text-ink/75 hover:text-accent transition-colors">Meximieux</a>
                <a href="/seminaire-amberieu-en-bugey/" class="text-ink/75 hover:text-accent transition-colors">Ambérieu</a>
                <a href="/seminaire-perouges/" class="text-ink/75 hover:text-accent transition-colors">Pérouges</a>
                <a href="/seminaire-lagnieu/" class="text-ink/75 hover:text-accent transition-colors">Lagnieu</a>
                <a href="/seminaire-saint-vulbas/" class="text-ink/75 hover:text-accent transition-colors">Saint-Vulbas</a>
                <a href="/agence-evenementielle-lyon/" class="text-ink/55 hover:text-accent transition-colors">Lyon est</a>
                <a href="/agence-evenementielle-bourg-en-bresse/" class="text-ink/55 hover:text-accent transition-colors">Bourg-en-Bresse</a>
                <a href="/agence-evenementielle-geneve/" class="text-ink/55 hover:text-accent transition-colors">Pays de Gex</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CARNET D'ADRESSES : BENTO GRID -->
  <section id="carnet" class="bg-bone py-24 md:py-32 border-t border-ink/10 scroll-mt-20">
    <div class="container-wide">
      <div class="max-w-3xl mb-12 md:mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="eyebrow">Le carnet d'adresses</p>
          <h2 class="h2-hero mt-6">
            On vous conseille,<br /><span class="text-gradient">jamais on impose.</span>
          </h2>
        </div>
        <a href="/conseiller/" class="text-sm text-accent font-medium flex items-center gap-2 hover:gap-3 transition-all whitespace-nowrap">
          Voir l'introduction du carnet
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <p class="max-w-2xl text-base md:text-lg leading-relaxed text-ink/65 mb-12 md:mb-16">
        Pour chaque catégorie, les critères qui comptent, les questions à poser, les signaux d'alerte. Quand vous voulez un nom, vous nous appelez : on vous oriente vers les bons interlocuteurs locaux.
      </p>

      <!-- BENTO GRID 12 CATÉGORIES -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-px bg-ink/10">
        {carnet.map((cat) => (
          <a
            href={`/conseiller/${cat.slug}/`}
            class="group bg-bone hover:bg-bone-soft p-6 md:p-7 transition-all duration-300 flex flex-col gap-4"
          >
            <CarnetIcon name={cat.iconKey} class="text-accent" size={32} />
            <div class="flex-1">
              <p class="text-base md:text-lg font-semibold text-ink leading-tight">{cat.cardLabel}</p>
              <p class="text-xs text-ink/50 mt-2 leading-snug">{cat.criteria.length} critères · {cat.questions.length} questions</p>
            </div>
            <span class="text-xs text-accent font-medium flex items-center gap-1.5 opacity-60 group-hover:opacity-100 transition-opacity">
              Voir les critères
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <p class="mt-10 text-xs text-ink/45 leading-relaxed max-w-2xl">
        Recommandations gratuites, sans contrepartie. Si un prestataire nous reverse un avantage commercial, c'est mentionné explicitement dans le devis. Aucun nom n'est publié sur le site sans accord écrit du prestataire concerné.
      </p>
    </div>
  </section>

  <!-- NICHE DURE : ce qu'on fait, ce qu'on ne fait pas -->
  <section class="bg-bone py-24 md:py-32 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-16">
        <p class="eyebrow">Notre périmètre production</p>
        <h2 class="h2-hero mt-6">
          Ce qu'on produit.<br /><span class="text-gradient">Ce qu'on oriente.</span>
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/70 max-w-2xl">
          Sur la production complète, le périmètre est volontairement resserré. Sur le carnet d'adresses, on couvre plus large : on ne fait pas tout, mais on connaît qui le fait bien.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-ink/10">
        <div class="bg-bone p-10">
          <p class="eyebrow text-gradient">On produit en clé en main</p>
          <ul class="mt-6 space-y-4 text-ink/85 text-base leading-snug">
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <a href="/productions/pleniere-entreprise/" class="hover:text-accent transition-colors">Conférence, congrès, plénière</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <a href="/productions/gala-entreprise/" class="hover:text-accent transition-colors">Soirée d'entreprise et remise de prix</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <a href="/productions/concert-entreprise/" class="hover:text-accent transition-colors">Concert privé d'entreprise</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <a href="/productions/lancement-produit/" class="hover:text-accent transition-colors">Lancements de produits</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <a href="/productions/inauguration-site/" class="hover:text-accent transition-colors">Inaugurations de site</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <a href="/productions/evenement-recrutement/" class="hover:text-accent transition-colors">Événement de recrutement Plaine de l'Ain</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
