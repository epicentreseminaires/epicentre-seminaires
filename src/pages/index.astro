              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-3 gap-2">
          {carnet.slice(0, 6).map((cat) => (
            <a href={`/conseiller/${cat.slug}/`} class="group bg-bone border border-ink/8 hover:border-ink/20 p-4 flex flex-col gap-2 transition-colors">
              <CarnetIcon name={cat.iconKey} class="text-accent" size={22} />
              <p class="text-xs font-medium text-ink/75 leading-snug group-hover:text-ink transition-colors">{cat.cardLabel}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

