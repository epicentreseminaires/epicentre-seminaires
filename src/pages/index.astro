---
import Base from '@/layouts/Base.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import FAQ from '@/components/FAQ.astro';
import BeforeAfter3D from '@/components/BeforeAfter3D.astro';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

const title = "Agence événementielle Plaine de l'Ain | Epicentre Séminaires";
const description = "Agence événementielle dans la Plaine de l'Ain. Plénières, galas, conventions, lancements. Méthode 3D : vous voyez votre événement avant qu'il ait lieu.";

// Visuel hero : scène événementielle abstraite (lumière, fumée), sobre, premium.
const heroImg = 'https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=2000&q=85&auto=format&fit=crop';
---

<Base title={title} description={description} zone="brand" theme="light">
  <!-- HERO : H1 signature court, H2 SEO en sous-titre -->
  <section class="bg-bone pt-32 md:pt-40 pb-20 md:pb-28 relative overflow-hidden">
    <div class="container-wide">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7 relative z-10">
          <div class="flex items-center gap-3 mb-8">
            <span class="block w-8 h-px bg-ink/30"></span>
            <p class="text-[0.7rem] uppercase tracking-[0.22em] text-ink/55 font-medium">
              Plaine de l'Ain · Entre Lyon et Genève
            </p>
          </div>

          <h1 class="font-display font-semibold text-ink text-[3rem] sm:text-6xl md:text-7xl lg:text-[5.5rem] leading-[0.94] tracking-[-0.045em]">
            L'événement<br />avant l'événement.
          </h1>

          <p class="mt-8 text-lg md:text-xl leading-relaxed text-ink/65 max-w-xl">
            <strong class="text-ink/90">Agence événementielle dans la Plaine de l'Ain.</strong><br />
            Plénières, conventions, galas, lancements. Avant le devis, vous voyez votre événement modélisé en 3D, à l'échelle, dans le moindre détail.
          </p>

          <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="/contact/" class="btn-accent text-sm px-7 py-4">
              Demander un devis
              <span aria-hidden="true">→</span>
            </a>
            <a href={CONTACT_PHONE_HREF} class="text-ink/85 hover:text-ink text-sm font-semibold flex items-center gap-2 transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{CONTACT_PHONE_DISPLAY}</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative aspect-[4/5] overflow-hidden bg-ink-soft rounded-sm">
            <img
              src={heroImg}
              alt="Scène événementielle, mise en lumière et atmosphère technique"
              class="absolute inset-0 w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip variant="light" />

  <!-- SLIDER 3D ↔ PHOTO : signature visuelle unique -->
  <section class="py-24 md:py-32 bg-bone-soft">
    <div class="container-wide">
      <div class="max-w-3xl mb-16">
        <p class="eyebrow">Notre signature</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.03em]">
          Vous voyez votre événement<br /><span class="text-accent">avant qu'il ait lieu.</span>
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/70 max-w-2xl">
          Avant le devis, avant le brief technique, le pilotage commence par la modélisation 3D. À l'échelle. Tout le monde voit la même chose, à la même seconde. Faites glisser le curseur ci-dessous.
        </p>
      </div>

      <div class="max-w-5xl">
        <BeforeAfter3D
          context="Glissez pour comparer"
          caption="Du plan 3D modélisé en amont à la photo finale du jour J. Le client voit son événement avant de signer, les prestataires reçoivent un référentiel partagé à l'échelle, le jour J personne ne découvre le dispositif."
        />
      </div>

      <div class="mt-12 grid md:grid-cols-3 gap-px bg-ink/10 max-w-5xl">
        <div class="bg-bone-soft p-8">
          <p class="text-accent font-display text-xl">01</p>
          <h3 class="text-lg mt-3 leading-tight font-semibold">Validation client</h3>
          <p class="mt-3 text-ink/65 leading-relaxed text-sm">
            Le client voit son événement avant de signer. Les arbitrages se font sur du concret.
          </p>
        </div>
        <div class="bg-bone-soft p-8">
          <p class="text-accent font-display text-xl">02</p>
          <h3 class="text-lg mt-3 leading-tight font-semibold">Brief des prestataires</h3>
          <p class="mt-3 text-ink/65 leading-relaxed text-sm">
            Régie, sondiers, structure, traiteur reçoivent un référentiel à l'échelle. Plus d'interprétation.
          </p>
        </div>
        <div class="bg-bone-soft p-8">
          <p class="text-accent font-display text-xl">03</p>
          <h3 class="text-lg mt-3 leading-tight font-semibold">Coordination jour J</h3>
          <p class="mt-3 text-ink/65 leading-relaxed text-sm">
            Personne ne découvre le dispositif en arrivant. Tout a été vu, validé, ajusté en amont.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TROIS SERVICES -->
  <section id="services" class="bg-bone py-28 md:py-36">
    <div class="container-wide">
      <div class="max-w-3xl mb-20">
        <p class="eyebrow">Nos services</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.03em]">
          Trois façons<br />de travailler ensemble.
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/70 max-w-2xl">
          Selon votre besoin, l'agence intervient au bon niveau. Du conseil ponctuel à la production complète, sans intermédiaire commercial.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-px bg-ink/10">
        <div class="bg-bone p-10 hover:bg-bone-soft transition-colors duration-300">
          <p class="text-accent font-display text-2xl">01</p>
          <h3 class="text-2xl mt-5 leading-tight">Conseil</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Vous avez un projet d'événement et vous voulez en parler à quelqu'un qui connaît le métier. Format, budget, prestataires, lieux disponibles. Premier échange sans engagement.
          </p>
        </div>
        <div class="bg-bone p-10 hover:bg-bone-soft transition-colors duration-300">
          <p class="text-accent font-display text-2xl">02</p>
          <h3 class="text-2xl mt-5 leading-tight">Production complète</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Vous confiez la production de bout en bout : scénographie 3D, scène, son, lumière, vidéo, captation, régie, coordination des prestataires. Un événement piloté, sans intermédiaire.
          </p>
        </div>
        <div class="bg-bone p-10 hover:bg-bone-soft transition-colors duration-300">
          <p class="text-accent font-display text-2xl">03</p>
          <h3 class="text-2xl mt-5 leading-tight">Sourcing de lieu</h3>
          <p class="mt-4 text-ink/65 leading-relaxed">
            Vous cherchez le bon lieu pour votre événement : dans la Plaine de l'Ain, à Ambérieu, à Pérouges, à Lyon. Sourcing en amont du cadrage, sur la base d'une connaissance fine du territoire.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- NICHE DURE : ce qu'on fait, ce qu'on ne fait pas -->
  <section class="bg-bone-soft py-28 md:py-36">
    <div class="container-wide">
      <div class="max-w-3xl mb-20">
        <p class="eyebrow">Notre périmètre</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.03em]">
          Ce qu'on fait.<br /><span class="text-accent">Ce qu'on ne fait pas.</span>
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/70 max-w-2xl">
          Le périmètre est volontairement resserré. C'est ce qui permet de garder le niveau d'exigence sur chaque mission.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-ink/10">
        <div class="bg-bone-soft p-10">
          <p class="eyebrow text-accent">Notre métier</p>
          <ul class="mt-6 space-y-4 text-ink/85 text-lg leading-snug">
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <span>Plénières scénographiées et conventions</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <span>Galas, dîners assis, remises de prix</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <span>Lancements de produits et reveals presse</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <span>Inaugurations de sites industriels et institutionnels</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <span>Captation vidéo multicam et streaming live</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-2 inline-block w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
              <span>AG d'actionnaires et congrès</span>
            </li>
          </ul>
        </div>
        <div class="bg-bone-soft p-10">
          <p class="eyebrow text-ink/45">Hors périmètre</p>
          <ul class="mt-6 space-y-4 text-ink/55 text-lg leading-snug">
            <li class="flex items-start gap-3">
              <span class="text-ink/30 mt-2 inline-block w-3 h-px bg-ink/30 flex-shrink-0"></span>
              <span>Team building loisir, animations gadget</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-ink/30 mt-2 inline-block w-3 h-px bg-ink/30 flex-shrink-0"></span>
              <span>Salons et stands commerciaux</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-ink/30 mt-2 inline-block w-3 h-px bg-ink/30 flex-shrink-0"></span>
              <span>Soirées festives sans dispositif scénique</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-ink/30 mt-2 inline-block w-3 h-px bg-ink/30 flex-shrink-0"></span>
              <span>Mariages, événements privés (hors lieu Épinac)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-ink/30 mt-2 inline-block w-3 h-px bg-ink/30 flex-shrink-0"></span>
              <span>Location de matériel sec, régie sans pilotage</span>
            </li>
          </ul>
          <p class="mt-8 text-sm text-ink/55 leading-relaxed">
            Si votre projet est hors périmètre, dites-le franchement : nous orienterons vers un confrère mieux dimensionné pour vous.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPÉRIENCE : section sombre pour le contraste -->
  <section class="bg-ink text-bone py-28 md:py-36">
    <div class="container-wide grid md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-6">
        <p class="eyebrow text-bone/55">L'expérience</p>
        <h2 class="text-4xl md:text-6xl mt-6 leading-[1] tracking-[-0.03em]">
          Une production rodée<br /><span class="text-accent">sur les plus grandes scènes.</span>
        </h2>
      </div>
      <div class="md:col-span-6 space-y-6 text-lg leading-relaxed text-bone/75">
        <p>
          Epicentre apporte aux entreprises de la Plaine de l'Ain une culture de production technique forgée sur les plus grandes scènes lyonnaises du sport et du spectacle.
        </p>
        <p>
          La même exigence opérationnelle : doublage des éléments critiques, plans de prévention écrits, rétroplanning calé, équipe sur place. Un événement n'est jamais qu'un programme : c'est un dispositif technique vivant, où chaque détail compte.
        </p>
        <a href="/a-propos/" class="btn-outline border-bone/30 text-bone hover:bg-bone hover:text-ink mt-4 inline-flex">
          Notre histoire
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS & ASSURANCES : badges techniques en remplacement des logos clients -->
  <section class="bg-bone py-24 md:py-32 border-t border-ink/10">
    <div class="container-wide">
      <div class="max-w-3xl mb-16">
        <p class="eyebrow">Cadre & assurances</p>
        <h2 class="text-3xl md:text-5xl mt-6 leading-tight tracking-[-0.03em]">
          Le sérieux n'est pas une promesse.<br /><span class="text-accent">C'est un dossier.</span>
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-ink/65 max-w-2xl">
          Un événement à enjeu réclame un cadre réglementaire et assurantiel solide. Les références clients restent confidentielles ; le cadre du métier, lui, est public.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-ink/10">
        {[
          {
            label: 'Responsabilité civile pro',
            desc: 'Couverture événements recevant du public, dommages corporels et matériels. Attestation transmise sur demande.',
          },
          {
            label: 'Cadre ERP / CTS',
            desc: 'Maîtrise des Établissements Recevant du Public et des Chapiteaux, Tentes, Structures. Dossiers de sécurité rédigés en interne.',
          },
          {
            label: 'Plan de prévention industriel',
            desc: 'PPSPS rédigés pour les sites industriels (PIPA, plateformes énergie, halles de production). Coordination HSE en amont.',
          },
          {
            label: 'Accessibilité PMR',
            desc: 'Dispositifs conçus dès le brief avec parcours et points d\'accueil PMR intégrés. Pas une contrainte de dernière minute.',
          },
          {
            label: 'Bureau d\'études interne',
            desc: 'Modélisation 3D (SketchUp), plans 2D techniques (AutoCAD), dossiers d\'implantation pour prestataires partenaires.',
          },
          {
            label: 'Pilotage direct',
            desc: 'Pas d\'intermédiaire commercial entre le client et l\'opérationnel. Un seul interlocuteur de la signature au démontage.',
          },
          {
            label: 'Sourcing partenaires',
            desc: 'Réseau de prestataires son, lumière, structure, traiteur, sécurité. Local par défaut, top niveau quand le projet l\'exige.',
          },
          {
            label: 'Architecture budgétaire',
            desc: 'Devis ligne à ligne, équipement nommé, équipe identifiée par rôle. Aucune ligne fourre-tout, aucun forfait opaque.',
          },
        ].map((b) => (
          <div class="bg-bone p-7">
            <p class="text-sm font-semibold text-ink leading-tight">{b.label}</p>
            <p class="mt-3 text-xs text-ink/60 leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQ />

  <!-- CTA FINAL -->
  <section class="bg-bone py-28 md:py-36">
    <div class="container-wide text-center max-w-3xl mx-auto">
      <p class="eyebrow">Parlons de votre projet</p>
      <h2 class="text-4xl md:text-6xl lg:text-7xl max-w-4xl mx-auto mt-6 leading-[1] tracking-[-0.04em]">
        Un événement à produire ?<br /><span class="text-accent">Décrivez-le nous.</span>
      </h2>
      <p class="mt-10 text-lg text-ink/70 max-w-xl mx-auto leading-relaxed">
        Format, jauge, date pressentie, budget envisagé. Nous revenons vers vous, sans engagement.
      </p>
      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a href="/contact/" class="btn-accent text-base px-8 py-4">
          Demander un devis
          <span aria-hidden="true">→</span>
        </a>
        <a href={CONTACT_PHONE_HREF} class="btn-outline">
          {CONTACT_PHONE_DISPLAY}
        </a>
      </div>
    </div>
  </section>

  <!-- ACCÈS ÉPINAC : second site, sobre, séparé visuellement -->
  <section class="bg-epinac-deep text-bone py-16 md:py-20 border-t border-bone/5">
    <div class="container-wide">
      <a href="/epinac/" class="group grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-2">
          <p class="eyebrow text-bone/55">Autre site</p>
        </div>
        <div class="md:col-span-8">
          <p class="text-2xl md:text-3xl leading-tight tracking-[-0.02em]">
            Vous cherchez plutôt un lieu d'événement ?<br /><span class="text-bone/65">Découvrez le domaine d'Épinac, en Bourgogne.</span>
          </p>
        </div>
        <div class="md:col-span-2 md:text-right">
          <span class="inline-flex items-center gap-2 text-sm font-medium text-bone/85 group-hover:text-bone transition-colors">
            Y aller
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </span>
        </div>
      </a>
    </div>
  </section>
</Base>
