---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CarnetIcon from '@/components/CarnetIcon.astro';
import { formatsOnFait, formatsOnOriente } from '@/data/formats';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

const title = "Ce qu'on produit · Plénières, galas, lancements | Epicentre";
const description = "Productions événementielles d'entreprise : plénières, conventions, galas, lancements, inaugurations. Architecture événementielle, direction technique intégrale.";
---
<Base title={title} description={description} zone="plaine" theme="dark">
  <div class="container-wide pt-28 md:pt-32 pb-2">
    <Breadcrumb items={[{ name: 'Accueil', url: '/' }, { name: "Productions" }]} variant="light" />
  </div>

  <section class="bg-bone pt-6 md:pt-8 pb-16 md:pb-20">
    <div class="container-wide max-w-4xl">
      <p class="eyebrow">Architecture événementielle</p>
      <h1 class="h1-hero-lg mt-6">
        Ce qu'on conçoit<br /><span class="text-gradient">et produit.</span>
      </h1>
      <p class="mt-8 text-lg md:text-xl leading-relaxed text-ink/70 max-w-2xl">
        Six formats à enjeu où l'ingénierie de production fait la différence. Sur chacun, nous concevons l'espace éphémère, modélisons en 3D avant engagement, coordonnons les prestataires et pilotons la régie jour J.
      </p>
    </div>
  </section>

  <!-- ON FAIT : cards magazine-style (image en haut + bloc texte cream en dessous) -->
  <section class="bg-bone-soft py-20 md:py-24 border-t border-ink/10">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7">
        {formatsOnFait.map((f) => (
          <a
            href={`/productions/${f.slug}/`}
            class="group bg-bone hover:bg-bone-soft border border-ink/10 hover:border-ink/20 overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-ink/5"
          >
            <!-- Image en haut, ratio fixe + cinema-grade pour le grain -->
            <div class="relative overflow-hidden aspect-[4/3] cinema-grade">
              {f.cover ? (
                <img
                  src={f.cover}
                  alt={f.cardLabel}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-[1.04]"
                />
              ) : (
                <div class="absolute inset-0 bg-bone-soft flex items-center justify-center">
                  <CarnetIcon name={f.iconKey} class="text-ink/30" size={48} />
                </div>
              )}
              <!-- Overlay subtil bottom pour cohérence -->
              <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/15 pointer-events-none z-[3]"></div>
            </div>

            <!-- Bloc texte cream uni -->
            <div class="p-6 md:p-7 flex flex-col flex-1 gap-3">
              <div class="flex items-center gap-3">
                <CarnetIcon name={f.iconKey} class="text-accent" size={22} />
                <p class="eyebrow text-ink/55">Production</p>
              </div>
              <h2 class="text-xl md:text-[1.35rem] font-semibold leading-tight text-ink">{f.cardLabel}</h2>
              <p class="text-sm text-ink/65 leading-relaxed line-clamp-3 flex-1">{f.intro}</p>
              <span class="mt-2 text-xs text-accent font-semibold flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
                Voir le détail
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- POURQUOI CES FORMATS -->
  <section class="bg-bone py-20 md:py-28 border-t border-ink/10">
    <div class="container-wide max-w-5xl">
      <div class="max-w-3xl mb-12 md:mb-16">
        <p class="eyebrow">Pourquoi ces formats</p>
        <h2 class="h2-section mt-6">
          Six formats. <span class="text-gradient">Une logique commune.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-ink/10">
        <div class="bg-bone p-8 md:p-10">
          <p class="eyebrow text-gradient">Le critère de notre périmètre</p>
          <p class="mt-4 text-base md:text-lg leading-relaxed text-ink/75">
            Tous nos formats partagent un point commun : l'événement repose sur un dispositif technique scénique. Une scène, un public, une prise de parole, un message. La production audiovisuelle et scénographique conditionne directement la perception de l'événement.
          </p>
        </div>
        <div class="bg-bone p-8 md:p-10">
          <p class="eyebrow text-gradient">Ce qui change avec la jauge</p>
          <p class="mt-4 text-base md:text-lg leading-relaxed text-ink/75">
            Le passage de 100 à 500 puis à 1 000 personnes change tout : type de système son, dimensionnement scène, nombre de caméras, calculs ERP, dispositif logistique. On adapte le dispositif à la jauge réelle, pas à l'inverse.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HORS PÉRIMÈTRE -->
  <section class="bg-bone-soft py-20 md:py-28 border-t border-ink/10">
    <div class="container-wide max-w-5xl">
      <div class="max-w-3xl mb-12">
        <p class="eyebrow">Hors périmètre production</p>
        <h2 class="h2-section mt-6">
          Quatre formats qu'on n'aborde pas en production. <br /><span class="text-gradient">Mais qu'on connaît.</span>
        </h2>
        <p class="mt-6 text-base text-ink/65 leading-relaxed max-w-2xl">
          Sur ces formats, on n'est pas le bon interlocuteur en production complète. On vous oriente vers les confrères mieux dimensionnés, sans intermédiation commerciale.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-ink/10">
        {formatsOnOriente.map((f) => (
          <a href={`/orienter/${f.slug}/`} class="group bg-bone-soft hover:bg-bone p-6 md:p-7 transition-colors flex flex-col gap-4">
            <CarnetIcon name={f.iconKey} class="text-ink/60 group-hover:text-accent transition-colors" size={26} />
            <p class="text-base font-semibold text-ink leading-tight">{f.cardLabel}</p>
            <p class="text-xs text-ink/55 leading-relaxed line-clamp-3">{f.intro}</p>
            <span class="mt-auto text-xs text-accent font-medium flex items-center gap-1.5 opacity-70 group-hover:opacity-100 transition-opacity">
              Pourquoi on oriente
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-forest-gradient text-bone py-24 md:py-28">
    <div class="container-wide text-center max-w-3xl mx-auto">
      <p class="eyebrow text-bone/55">Production complète</p>
      <h2 class="h2-section mt-6">
        Un format qui vous correspond ?<br /><span class="text-gradient-bone">Décrivez le projet.</span>
      </h2>
      <p class="mt-8 text-lg text-bone/70 leading-relaxed">
        Trois minutes pour cadrer en questionnaire, ou un appel direct si vous préférez.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/construire-mon-projet/" class="btn-bone">Construire mon projet</a>
        <a href={CONTACT_PHONE_HREF} class="btn-outline border-bone/30 text-bone hover:bg-bone hover:text-ink">{CONTACT_PHONE_DISPLAY}</a>
      </div>
    </div>
  </section>
</Base>
