---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingCTA from '@/components/FloatingCTA.astro';
import SearchDialog from '@/components/SearchDialog.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  zone?: 'plaine' | 'brand';
  canonical?: string;
  noindex?: boolean;
  theme?: 'light' | 'dark';
  transparentTop?: boolean;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  zone = 'brand',
  canonical,
  noindex = false,
  theme = 'dark',
  transparentTop = false,
} = Astro.props;

const siteUrl = 'https://epicentre-seminaires.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F5F1EA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0F" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://enjoylife.b-cdn.net" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Epicentre Séminaires" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content="Epicentre Séminaires" />

    {zone === 'plaine' ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': ['LocalBusiness', 'ProfessionalService'],
            '@id': `${siteUrl}/#business`,
            name: 'Epicentre Séminaires',
            description: "Cabinet d'ingénierie de production événementielle B2B basé à Meximieux, Plaine de l'Ain. 12 ans d'expérience en production scénique. Modélisation 2D/3D avant engagement, plénières, galas, inaugurations industrielles, conventions. Partenaire des entreprises du PIPA, CEPA, Amblamex, CCPA.",
            slogan: "Ingénierie de production événementielle. Plaine de l'Ain.",
            foundingDate: '2014',
            url: `${siteUrl}/`,
            telephone: '+33744980015',
            address: {
              '@type': 'PostalAddress',
              streetAddress: 'Meximieux',
              addressLocality: 'Meximieux',
              addressRegion: 'Ain',
              postalCode: '01800',
              addressCountry: 'FR',
            },
            geo: {
              '@type': 'GeoCoordinates',
              latitude: 45.9075,
              longitude: 5.2018,
            },
            areaServed: [
              { '@type': 'AdministrativeArea', name: "Plaine de l'Ain" },
              { '@type': 'AdministrativeArea', name: 'Ain' },
              { '@type': 'AdministrativeArea', name: 'Est Lyonnais' },
              { '@type': 'AdministrativeArea', name: 'Pays de Gex' },
              { '@type': 'AdministrativeArea', name: 'PIPA - Parc Industriel de la Plaine de l\'Ain' },
              { '@type': 'City', name: 'Meximieux' },
              { '@type': 'City', name: 'Saint-Vulbas' },
              { '@type': 'City', name: 'Ambérieu-en-Bugey' },
              { '@type': 'City', name: 'Lagnieu' },
              { '@type': 'City', name: 'Pérouges' },
              { '@type': 'City', name: 'Montluel' },
              { '@type': 'City', name: 'Miribel' },
              { '@type': 'City', name: 'Oyonnax' },
              { '@type': 'City', name: 'Bellegarde-sur-Valserine' },
              { '@type': 'City', name: 'Bourg-en-Bresse' },
              { '@type': 'City', name: 'Mâcon' },
              { '@type': 'City', name: 'Lyon' },
              { '@type': 'City', name: 'Grenoble' },
              { '@type': 'City', name: 'Annecy' },
              { '@type': 'City', name: 'Genève' },
            ],
            knowsAbout: [
              'Production événementielle B2B',
              'Modélisation 2D/3D événementielle',
              'Ingénierie scénique et scénographie',
              'Plénière d\'entreprise grande jauge',
              'Gala et soirée d\'entreprise',
              'Inauguration industrielle',
              'Convention commerciale entreprise',
              'Captation vidéo événementielle multicam',
              'Sonorisation ligne array spectacle',
              'Coordination prestataires événementiels',
              'PIPA Parc Industriel de la Plaine de l\'Ain',
              'CEPA Club des Entreprises du PIPA',
              'Amblamex club entreprises Ambérieu Meximieux Lagnieu',
              'CCPA Communauté de Communes de la Plaine de l\'Ain',
              'Plaine de l\'Ain Tourisme',
              'Ainterexpo Ekinox Bourg-en-Bresse',
              'Valexpo Oyonnax Plastics Valley',
              'Groupama Stadium Décines',
              'LDLC Arena Décines',
              'Réunion confidentielle dirigeants',
              'Séminaire résidentiel Ain',
            ],
            hasOfferCatalog: {
              '@type': 'OfferCatalog',
              name: 'Services de production événementielle Epicentre Séminaires',
              itemListElement: [
                {
                  '@type': 'Offer',
                  itemOffered: {
                    '@type': 'Service',
                    name: 'Production événementielle complète',
                    description: 'Organisation et production d\'événements d\'entreprise de A à Z : scène, son, lumière, vidéo, captation, coordination prestataires, régie le jour J. De 80 à plus de 5 000 participants.',
                    provider: { '@id': `${siteUrl}/#business` },
                    areaServed: "Plaine de l'Ain, Ain, Est Lyonnais, corridor Lyon-Genève",
                  },
                },
                {
                  '@type': 'Offer',
                  itemOffered: {
                    '@type': 'Service',
                    name: 'Modélisation 2D/3D événementielle',
                    description: 'Visualisation immersive de l\'événement avant production : plan de flux, rendu 3D de la salle et de la scène, validation décisionnelle avant engagement de budget. Outil de réassurance pour les comités de direction.',
                    provider: { '@id': `${siteUrl}/#business` },
                  },
                },
                {
                  '@type': 'Offer',
                  itemOffered: {
                    '@type': 'Service',
                    name: 'Courtage de lieu et mise en relation prestataires',
                    description: 'Sourcing et mise en relation avec les lieux et prestataires qualifiés. Réseau Plaine de l\'Ain, Ain, Est Lyonnais, corridor Lyon-Genève. Accès aux grands espaces régionaux : Ekinox, Valexpo, LDLC Arena, Groupama Stadium.',
                    provider: { '@id': `${siteUrl}/#business` },
                  },
                },
                {
                  '@type': 'Offer',
                  itemOffered: {
                    '@type': 'Service',
                    name: 'Coordination événement confidentiel dirigeants',
                    description: 'Facilitation et coordination d\'événements confidentiels pour comités de direction et réunions stratégiques. Formats de 5 à 20 personnes, sourcing de lieu discret, logistique sur-mesure.',
                    provider: { '@id': `${siteUrl}/#business` },
                  },
                },
              ],
            },
          },
          {
            '@type': 'WebSite',
            '@id': `${siteUrl}/#website`,
            url: siteUrl,
            name: 'Epicentre Séminaires',
            publisher: { '@id': `${siteUrl}/#business` },
          },
        ],
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: 'Epicentre Séminaires',
        description: "Agence de production événementielle B2B basée à Meximieux, Plaine de l'Ain.",
        url: siteUrl,
        logo: `${siteUrl}/images/logo-epicentre-black.png`,
      })} />
    )}
  </head>
  <body data-zone={zone} data-theme={theme}>
    <Header zone={zone} theme={theme} transparentTop={transparentTop} />
    <main>
      <slot />
    </main>
    <FloatingCTA />
    <SearchDialog />
    <Footer />
  </body>
</html>
