---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingCTA from '@/components/FloatingCTA.astro';
import SearchDialog from '@/components/SearchDialog.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  zone?: 'plaine' | 'brand';
  canonical?: string;
  noindex?: boolean;
  theme?: 'light' | 'dark';
  transparentTop?: boolean;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  zone = 'brand',
  canonical,
  noindex = false,
  theme = 'dark',
  transparentTop = false,
} = Astro.props;

const siteUrl = 'https://epicentre-seminaires.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F5F1EA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B0B0F" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://enjoylife.b-cdn.net" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Epicentre Séminaires" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content="Epicentre Séminaires" />

    {zone === 'plaine' ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        '@id': `${siteUrl}/#business`,
        name: 'Epicentre Séminaires',
        description: "Agence événementielle dans la Plaine de l'Ain. Production technique d'événements d'entreprise : plénières, galas, conventions, lancements, captation vidéo.",
        url: `${siteUrl}/`,
        telephone: '+33744980015',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Meximieux',
          addressRegion: 'Ain',
          postalCode: '01800',
          addressCountry: 'FR',
        },
        areaServed: [
          "Plaine de l'Ain",
          'Ambérieu-en-Bugey',
          'Lagnieu',
          'Meximieux',
          'Saint-Vulbas',
          'Pérouges',
          'Montluel',
          'Miribel',
          'Oyonnax',
          'Bellegarde-sur-Valserine',
          'Bugey',
          'Bourg-en-Bresse',
          'Mâcon',
          'Lyon',
          'Pays de Gex',
        ],
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: 'Epicentre Séminaires',
        description: "Agence événementielle dans la Plaine de l'Ain.",
        url: siteUrl,
        logo: `${siteUrl}/images/logo-epicentre-black.png`,
      })} />
    )}
  </head>
  <body data-zone={zone} data-theme={theme}>
    <Header zone={zone} theme={theme} transparentTop={transparentTop} />
    <main>
      <slot />
    </main>
    <FloatingCTA />
    <SearchDialog />
    <Footer />
  </body>
</html>
