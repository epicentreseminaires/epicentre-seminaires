---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingCTA from '@/components/FloatingCTA.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  zone?: 'plaine' | 'brand';
  canonical?: string;
  noindex?: boolean;
  theme?: 'light' | 'dark';
}

const {
  title,
  description,
  image = '/og-default.jpg',
  zone = 'brand',
  canonical,
  noindex = false,
  theme = 'dark',
} = Astro.props;

const siteUrl = 'https://epicentre-seminaires.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Epicentre Séminaires" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content="Epicentre Séminaires" />

    {zone === 'plaine' ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        '@id': `${siteUrl}/#business`,
        name: 'Epicentre Séminaires',
        description: "Agence événementielle dans la Plaine de l'Ain. Production technique d'événements d'entreprise : plénières, galas, conventions, lancements, captation vidéo.",
        url: `${siteUrl}/`,
        address: {
          '@type': 'PostalAddress',
          addressRegion: 'Auvergne-Rhône-Alpes',
          addressCountry: 'FR',
        },
        areaServed: ["Plaine de l'Ain", 'Ambérieu-en-Bugey', 'Lagnieu', 'Meximieux', 'Saint-Vulbas', 'Pérouges', 'Bugey', 'Lyon est', 'Pays de Gex'],
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: 'Epicentre Séminaires',
        description: "Agence événementielle dans la Plaine de l'Ain.",
        url: siteUrl,
        logo: `${siteUrl}/images/logo-epicentre-black.png`,
      })} />
    )}
  </head>
  <body data-zone={zone} data-theme={theme}>
    <Header zone={zone} theme={theme} />
    <main>
      <slot />
    </main>
    <FloatingCTA />
    <Footer />
  </body>
</html>
