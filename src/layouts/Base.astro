---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  zone?: 'epinac' | 'plaine' | 'brand';
  canonical?: string;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  zone = 'brand',
  canonical,
} = Astro.props;

const siteUrl = 'https://epicentre-seminaires.fr';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Epicentre Séminaires" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />
    <meta name="author" content="Epicentre Séminaires" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'EventVenue',
      name: 'Epicentre Séminaires',
      description: 'Agence de production événementielle. Plénières, galas, congrès, lancements de produits, captation vidéo. Épinac (Bourgogne) et Plaine de l\'Ain.',
      url: siteUrl,
      areaServed: ['Plaine de l\'Ain', 'Ambérieu-en-Bugey', 'Épinac', 'Saône-et-Loire', 'Autun'],
      address: [
        {
          '@type': 'PostalAddress',
          addressLocality: 'Épinac',
          postalCode: '71360',
          addressRegion: 'Bourgogne-Franche-Comté',
          addressCountry: 'FR',
        },
        {
          '@type': 'PostalAddress',
          addressLocality: 'Ambérieu-en-Bugey',
          addressRegion: 'Auvergne-Rhône-Alpes',
          addressCountry: 'FR',
        },
      ],
    })} />
  </head>
  <body data-zone={zone}>
    <Header zone={zone} />
    <main>
      <slot />
    </main>
    <Footer zone={zone} />
  </body>
</html>
