---
import Logo from './Logo.astro';
import LegalModals from './LegalModals.astro';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-bone/70 relative">
  <!-- Filet de marque : signature visuelle gradient brand en haut du footer -->
  <div class="absolute top-0 left-0 right-0 h-px bg-forest-gradient"></div>

  <div class="container-wide py-16 grid md:grid-cols-12 gap-10">
    <div class="md:col-span-3">
      <Logo variant="light" height={64} />
      <p class="mt-6 max-w-md text-sm leading-relaxed">
        Agence événementielle dans la Plaine de l'Ain. Production clé en main et carnet d'adresses curaté.
      </p>
      <a href="/construire-mon-projet/" class="mt-6 inline-flex items-center gap-2 text-bone hover:text-accent transition-colors text-sm font-medium">
        Construire mon projet
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="md:col-span-2">
      <p class="eyebrow text-bone/50 mb-4">Productions</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/productions/" class="hover:text-bone">Vue d'ensemble</a></li>
        <li><a href="/productions/pleniere-entreprise/" class="hover:text-bone">Plénière</a></li>
        <li><a href="/productions/convention-entreprise/" class="hover:text-bone">Convention</a></li>
        <li><a href="/productions/gala-entreprise/" class="hover:text-bone">Gala</a></li>
        <li><a href="/productions/lancement-produit/" class="hover:text-bone">Lancement</a></li>
        <li><a href="/productions/inauguration-site/" class="hover:text-bone">Inauguration</a></li>
        <li><a href="/productions/captation-multicam/" class="hover:text-bone">Captation</a></li>
        <li><a href="/orienter/" class="hover:text-bone text-bone/55">+ ce qu'on oriente</a></li>
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow text-bone/50 mb-4">Carnet d'adresses</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/conseiller/" class="hover:text-bone">Vue d'ensemble</a></li>
        <li><a href="/conseiller/lieu/" class="hover:text-bone">Lieu</a></li>
        <li><a href="/conseiller/traiteur/" class="hover:text-bone">Traiteur</a></li>
        <li><a href="/conseiller/son-lumiere/" class="hover:text-bone">Son & lumière</a></li>
        <li><a href="/conseiller/scene/" class="hover:text-bone">Scène & structure</a></li>
        <li><a href="/conseiller/captation/" class="hover:text-bone">Captation vidéo</a></li>
        <li><a href="/conseiller/securite/" class="hover:text-bone">Sécurité ERP</a></li>
      </ul>
    </div>

    <div class="md:col-span-2">
      <p class="eyebrow text-bone/50 mb-4">L'agence</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/" class="hover:text-bone">Accueil</a></li>
        <li><a href="/process/" class="hover:text-bone">Méthode</a></li>
        <li><a href="/realisations/" class="hover:text-bone">Réalisations</a></li>
        <li><a href="/equipement/" class="hover:text-bone">Périmètre</a></li>
        <li><a href="/a-propos/" class="hover:text-bone">À propos</a></li>
        <li><a href="/contact/" class="hover:text-bone">Contact</a></li>
      </ul>
    </div>

    <div class="md:col-span-2">
      <p class="eyebrow text-bone/50 mb-4">Ressources</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/lexique/" class="hover:text-bone">Lexique FR / EN</a></li>
        <li><a href="/journal/" class="hover:text-bone">Le journal</a></li>
        <li><a href="/journal/combien-coute-pleniere-entreprise/" class="hover:text-bone">Combien coûte une plénière</a></li>
        <li><a href="/journal/scenographie-3d-evenement-entreprise/" class="hover:text-bone">Scénographie 3D</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-bone/10">
    <div class="container-wide py-6 flex flex-col md:flex-row justify-between gap-4 text-xs text-bone/40">
      <p>© {year} Epicentre Séminaires · Tous droits réservés</p>
      <div class="flex gap-6">
        <button type="button" data-open-dialog="dialog-legal" class="hover:text-bone underline-offset-2 hover:underline">Mentions légales</button>
        <button type="button" data-open-dialog="dialog-privacy" class="hover:text-bone underline-offset-2 hover:underline">Confidentialité</button>
        <a href="/contact/" class="hover:text-bone">Contact</a>
      </div>
    </div>
  </div>
</footer>

<LegalModals />
