---
export interface Props {
  href?: string;
  label?: string;
}
const { href = '/contact/', label = 'Demander un devis' } = Astro.props;
---

<a
  href={href}
  class="md:hidden fixed bottom-4 left-4 right-4 z-50 bg-ink text-bone py-4 rounded-full text-center text-sm font-medium shadow-2xl shadow-ink/30 backdrop-blur-sm"
>
  {label} →
</a>
