---
import type { IconKey } from '@/data/carnet';

export interface Props {
  name: IconKey;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 28 } = Astro.props;

// Icônes monochromes line-art, style Apple. Largeur de trait 1.4, currentColor.
const paths: Record<IconKey, string> = {
  lieu: 'M3 21h18M5 21V8.5L12 4l7 4.5V21M9 12h2M13 12h2M9 16h2M13 16h2',
  traiteur: 'M5 8h14M7 8c0-2 2-4 5-4s5 2 5 4M5 8v6a3 3 0 003 3h8a3 3 0 003-3V8M9 17v3M15 17v3',
  'son-lumiere': 'M5 13a4 4 0 014-4h6a4 4 0 014 4v0a4 4 0 01-4 4H9a4 4 0 01-4-4zM12 9V4M9 4h6M12 17v3',
  scene: 'M3 7h18M3 7v10h18V7M7 11l3 3 7-7',
  captation: 'M3 7h11v10H3zM14 10l5-3v10l-5-3z',
  photobooth: 'M5 6h14a1 1 0 011 1v12a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1zM12 16a4 4 0 100-8 4 4 0 000 8zM16 4l-1 2H9L8 4',
  mobilier: 'M4 8h16M4 8v8M20 8v8M4 16h16M8 16v3M16 16v3',
  animation: 'M12 3v3M5.6 5.6l2.1 2.1M3 12h3M5.6 18.4l2.1-2.1M12 21v-3M16.3 16.3l2.1 2.1M21 12h-3M16.3 7.7l2.1-2.1M9 12a3 3 0 116 0 3 3 0 01-6 0z',
  securite: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z',
  hotesses: 'M5 21v-2a4 4 0 014-4h6a4 4 0 014 4v2M12 11a4 4 0 100-8 4 4 0 000 8z',
  communication: 'M4 5h16v10H7l-3 3V5z',
  logistique: 'M3 7h11v10H3zM14 10h4l3 3v4h-7zM7 19a2 2 0 100-4 2 2 0 000 4zM18 19a2 2 0 100-4 2 2 0 000 4z',
};

const path = paths[name];
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={path} />
</svg>
