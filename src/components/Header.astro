---
import Logo from './Logo.astro';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';

export interface Props {
  zone?: 'epinac' | 'plaine' | 'brand';
}
const { zone = 'brand' } = Astro.props;

// Chaque univers a sa propre navigation : on est dans une "agence" à la fois.
// La marque (home, journal, à propos) propose les 2 portes d'entrée.
const navByZone = {
  brand: [
    { label: 'Épinac', href: '/epinac/' },
    { label: "Plaine de l'Ain", href: '/plaine-de-lain/' },
    { label: 'Journal', href: '/journal/' },
    { label: 'À propos', href: '/a-propos/' },
    { label: 'Contact', href: '/contact/' },
  ],
  epinac: [
    { label: 'Le domaine', href: '/epinac/le-domaine/' },
    { label: 'Productions', href: '/epinac/productions/' },
    { label: 'Journal', href: '/journal/' },
    { label: 'À propos', href: '/a-propos/' },
    { label: 'Contact', href: '/epinac/contact/' },
  ],
  plaine: [
    { label: "L'agence", href: '/plaine-de-lain/agence/' },
    { label: 'Productions', href: '/plaine-de-lain/productions/' },
    { label: 'Notre approche', href: '/plaine-de-lain/realisations/' },
    { label: 'Journal', href: '/journal/' },
    { label: 'Contact', href: '/plaine-de-lain/contact/' },
  ],
};

const nav = navByZone[zone];
const ctaHref = zone === 'epinac'
  ? '/epinac/contact/'
  : zone === 'plaine'
  ? '/plaine-de-lain/contact/'
  : '/contact/';

// Indicateur de "sous-marque" : on sait clairement dans quelle agence on est.
const zoneTag = zone === 'epinac'
  ? 'Épinac · Bourgogne'
  : zone === 'plaine'
  ? "Plaine de l'Ain"
  : null;

const phone = CONTACT_PHONE_DISPLAY;
const phoneHref = CONTACT_PHONE_HREF;
---

<header
  id="siteHeader"
  class="fixed top-0 left-0 right-0 z-50 transition-[background-color,backdrop-filter,padding] duration-300 bg-ink/60 backdrop-blur-md border-b border-bone/5"
  data-scrolled="false"
>
  <div class="container-wide flex items-center justify-between py-4 md:py-5">
    <div class="flex items-center gap-4">
      <Logo variant="light" height={72} />
      {zoneTag && (
        <span class="hidden md:flex items-center gap-3 text-bone/60 text-[0.7rem] uppercase tracking-[0.2em] border-l border-bone/20 pl-4 ml-1">
          {zoneTag}
        </span>
      )}
    </div>

    <nav class="hidden lg:flex items-center gap-7 text-sm text-bone/85 font-medium">
      {nav.map((item) => (
        <a href={item.href} class="hover:text-bone transition-colors">{item.label}</a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-5">
      <a href={phoneHref} class="text-bone hover:text-bone/80 text-sm font-semibold flex items-center gap-2 transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{phone}</span>
      </a>
      <a href={ctaHref} class="btn-bone text-sm py-2.5 px-5">
        Demander un devis
      </a>
    </div>

    <button class="lg:hidden text-bone" aria-label="Menu" id="mobileMenuBtn">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <line x1="3" y1="7" x2="21" y2="7" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="17" x2="21" y2="17" />
      </svg>
    </button>
  </div>

  <div id="mobileMenu" class="hidden lg:hidden bg-ink text-bone border-t border-bone/10">
    <nav class="container-wide py-6 flex flex-col gap-4">
      {zoneTag && (
        <p class="eyebrow text-bone/50 mb-2">{zoneTag}</p>
      )}
      {nav.map((item) => (
        <a href={item.href} class="text-base">{item.label}</a>
      ))}
      <a href={phoneHref} class="text-base font-semibold text-bone flex items-center gap-2 mt-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {phone}
      </a>
      <a href={ctaHref} class="btn-bone text-sm mt-2 w-fit">Demander un devis</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');

  // Mobile menu toggle
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Header bg adapts on scroll : transparent over hero, opaque after scroll
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 60) {
      header.classList.remove('bg-ink/60');
      header.classList.add('bg-ink/95');
      header.dataset.scrolled = 'true';
    } else {
      header.classList.remove('bg-ink/95');
      header.classList.add('bg-ink/60');
      header.dataset.scrolled = 'false';
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
