---
import Logo from './Logo.astro';
import CarnetIcon from './CarnetIcon.astro';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_HREF } from '@/config';
import { formatsOnFait } from '@/data/formats';
import { carnet } from '@/data/carnet';

export interface Props {
  zone?: 'plaine' | 'brand';
  theme?: 'light' | 'dark';
  transparentTop?: boolean;
}
const { zone = 'brand', theme = 'dark', transparentTop = false } = Astro.props;

// Navigation unifiée. Productions et Carnet ouvrent des mega-menus.
const nav = [
  { label: 'Productions', href: '/productions/', mega: 'productions' as const },
  { label: 'Carnet', href: '/conseiller/', mega: 'carnet' as const },
  { label: 'Méthode', href: '/process/' },
  { label: 'Lexique', href: '/lexique/' },
];

const ctaHref = '/construire-mon-projet/';
const ctaLabel = 'Construire mon projet';
const zoneTag = zone === 'plaine' ? "Plaine de l'Ain" : null;

const phone = CONTACT_PHONE_DISPLAY;
const phoneHref = CONTACT_PHONE_HREF;

// Theme adaptable : light pour fond clair (home premium), dark pour heros sombres
const isLight = theme === 'light';
const logoVariant = isLight ? 'dark' : 'light';
const headerBgInitial = isLight
  ? 'bg-bone/0'
  : (transparentTop ? 'bg-transparent' : 'bg-forest-gradient');
const headerBgScrolled = isLight ? 'bg-bone/90 backdrop-blur-md' : 'bg-forest-gradient';
const borderClass = isLight ? 'border-ink/5' : 'border-bone/5';
const textBase = isLight ? 'text-ink/85' : 'text-bone/85';
const textHover = isLight ? 'hover:text-ink' : 'hover:text-bone';
const textZoneTag = isLight ? 'text-ink/55' : 'text-bone/60';
const borderZoneTag = isLight ? 'border-ink/15' : 'border-bone/20';
const phoneText = isLight ? 'text-ink hover:text-ink/70' : 'text-bone hover:text-bone/80';
const ctaClass = isLight ? 'btn-accent' : 'btn-bone';
const burgerColor = isLight ? 'text-ink' : 'text-bone';
const mobileMenuBg = isLight ? 'bg-bone border-ink/10' : 'bg-forest-gradient border-bone/10';
const mobileTextColor = isLight ? 'text-ink/80' : 'text-bone/80';
---

<header
  id="siteHeader"
  class={`fixed top-0 left-0 right-0 z-50 transition-[background-color,backdrop-filter,padding] duration-300 ${headerBgInitial} border-b ${borderClass}`}
  data-scrolled="false"
  data-theme={theme}
  data-transparent-top={transparentTop ? 'true' : 'false'}
  data-bg-initial={headerBgInitial}
  data-bg-scrolled={headerBgScrolled}
>
  <div class="container-wide flex items-center justify-between header-row">
    <div class="flex items-center gap-4">
      <span class="header-logo inline-flex items-center transition-transform duration-300 origin-left">
        <Logo variant={logoVariant} height={56} />
      </span>
      {zoneTag && (
        <span class={`hidden md:flex items-center gap-3 ${textZoneTag} text-[0.7rem] uppercase tracking-[0.2em] border-l ${borderZoneTag} pl-4 ml-1`}>
          {zoneTag}
        </span>
      )}
    </div>

    <nav class={`hidden lg:flex items-center gap-7 text-sm ${textBase} font-medium`} id="primaryNav">
      {nav.map((item) => (
        item.mega ? (
          <div class="nav-item-mega" data-mega={item.mega}>
            <a href={item.href} class={`nav-mega-link ${textHover} transition-colors flex items-center gap-1`}>
              {item.label}
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="opacity-60 transition-transform">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        ) : (
          <a href={item.href} class={`${textHover} transition-colors`}>{item.label}</a>
        )
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-4">
      <button
        type="button"
        data-search-trigger
        aria-label="Rechercher sur le site"
        class={`group flex items-center gap-2.5 px-3.5 py-2 rounded-full border transition-all duration-200 ${isLight ? 'border-ink/12 hover:border-ink/30 bg-bone/40 hover:bg-bone' : 'border-bone/15 hover:border-bone/35 bg-forest-deep/60 hover:bg-forest-deep'}`}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class={isLight ? 'text-ink/55 group-hover:text-ink/75' : 'text-bone/55 group-hover:text-bone/75'}>
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.35-4.35" stroke-linecap="round" />
        </svg>
        <span class={`text-xs ${isLight ? 'text-ink/55 group-hover:text-ink/75' : 'text-bone/55 group-hover:text-bone/75'} pr-2`}>Rechercher</span>
      </button>
      <a href={phoneHref} class={`${phoneText} text-sm font-semibold flex items-center gap-2 transition-colors`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{phone}</span>
      </a>
      <a href={ctaHref} class={`${ctaClass} header-cta text-sm py-2.5 px-5`}>
        {ctaLabel}
      </a>
    </div>

    <div class="lg:hidden flex items-center gap-3">
      <button type="button" data-search-trigger aria-label="Rechercher" class={`${burgerColor}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.35-4.35" stroke-linecap="round" />
        </svg>
      </button>
      <button class={`${burgerColor}`} aria-label="Menu" id="mobileMenuBtn">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <line x1="3" y1="7" x2="21" y2="7" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="17" x2="21" y2="17" />
      </svg>
    </button>
  </div>

  <!-- MEGA-MENU PANELS (desktop) -->
  <div class="mega-panel" data-mega-target="productions" aria-hidden="true">
    <div class="container-wide py-8 md:py-10">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
        <!-- Liste formats (gauche, dense) -->
        <div class="lg:col-span-8">
          <p class="eyebrow text-ink/55 mb-5">Show d'entreprise</p>
          <div class="grid grid-cols-2 gap-x-6 gap-y-2 mb-7">
            {formatsOnFait.filter((f) => f.slug !== 'reunion-strategique' && f.slug !== 'evenement-sur-mesure').map((f) => (
              <a href={`/productions/${f.slug}/`} class="group flex items-center gap-3 py-2 pr-2 -mx-2 px-2 rounded-sm hover:bg-bone-soft transition-colors">
                <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 text-accent">
                  <CarnetIcon name={f.iconKey} size={18} />
                </span>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-ink leading-tight group-hover:text-accent transition-colors">{f.cardLabel}</p>
                  <p class="text-xs text-ink/55 mt-0.5 leading-snug line-clamp-1">{f.shortLabel}</p>
                </div>
              </a>
            ))}
          </div>
          <p class="eyebrow text-ink/55 mb-5">Petits formats et sur-mesure</p>
          <div class="grid grid-cols-2 gap-x-6 gap-y-2">
            {formatsOnFait.filter((f) => f.slug === 'reunion-strategique' || f.slug === 'evenement-sur-mesure').map((f) => (
              <a href={`/productions/${f.slug}/`} class="group flex items-center gap-3 py-2 pr-2 -mx-2 px-2 rounded-sm hover:bg-bone-soft transition-colors">
                <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 text-accent">
                  <CarnetIcon name={f.iconKey} size={18} />
                </span>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-ink leading-tight group-hover:text-accent transition-colors">{f.cardLabel}</p>
                  <p class="text-xs text-ink/55 mt-0.5 leading-snug line-clamp-1">{f.shortLabel}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="mt-7 pt-5 border-t border-ink/10 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
            <a href="/productions/" class="text-accent font-semibold flex items-center gap-1.5 hover:gap-2.5 transition-all">
              Voir toutes les productions
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a href="/process/" class="text-ink/65 hover:text-accent transition-colors">Notre méthode 3D</a>
            <a href="/orienter/" class="text-ink/65 hover:text-accent transition-colors">Formats hors périmètre</a>
          </div>
        </div>

        <!-- Featured card (droite) : signature 3D -->
        <div class="lg:col-span-4">
          <a href="/process/" class="group block relative overflow-hidden rounded-sm aspect-[4/5] cinema-grade">
            <img
              src="https://enjoylife.b-cdn.net/Epicentre/photofinal.jpg"
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent z-[3]"></div>
            <div class="absolute bottom-5 left-5 right-5 z-[4] text-bone">
              <p class="text-[0.6rem] uppercase tracking-[0.22em] text-bone/70 font-medium">Notre signature</p>
              <p class="mt-2 text-base font-semibold leading-tight">Vous voyez votre événement avant qu'il ait lieu.</p>
              <span class="mt-3 inline-flex items-center gap-1.5 text-xs text-bone/85 group-hover:gap-2.5 transition-all">
                Découvrir la méthode 3D
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="mega-panel" data-mega-target="carnet" aria-hidden="true">
    <div class="container-wide py-8 md:py-10">
      <div class="flex items-end justify-between gap-6 mb-6 md:mb-8">
        <div>
          <p class="eyebrow text-ink/55">Carnet d'adresses</p>
          <h3 class="font-display text-xl md:text-2xl font-semibold text-ink mt-2 leading-tight">Douze catégories. Les bons interlocuteurs locaux.</h3>
        </div>
        <a href="/conseiller/" class="text-sm text-accent font-semibold flex items-center gap-1.5 hover:gap-2.5 transition-all whitespace-nowrap">
          Voir le carnet
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-2">
        {carnet.map((c) => (
          <a href={`/conseiller/${c.slug}/`} class="group flex items-center gap-3 p-3 rounded-sm hover:bg-bone-soft transition-colors">
            <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-sm bg-bone-soft group-hover:bg-bone text-accent transition-colors">
              <CarnetIcon name={c.iconKey} size={20} />
            </span>
            <p class="text-sm font-medium text-ink/85 group-hover:text-accent transition-colors leading-tight">{c.cardLabel}</p>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div id="mobileMenu" class={`hidden lg:hidden ${mobileMenuBg} border-t`}>
    <nav class="container-wide py-6 flex flex-col gap-4">
      {zoneTag && (
        <p class={`eyebrow ${isLight ? 'text-ink/45' : 'text-bone/50'} mb-2`}>{zoneTag}</p>
      )}
      {nav.map((item) => (
        <a href={item.href} class={`text-base ${mobileTextColor}`}>{item.label}</a>
      ))}
      <a href={phoneHref} class={`text-base font-semibold ${isLight ? 'text-ink' : 'text-bone'} flex items-center gap-2 mt-2`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {phone}
      </a>
      <a href={ctaHref} class={`${ctaClass} text-sm mt-2 w-fit`}>{ctaLabel}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');

  // Mobile menu toggle
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Header bg adapts on scroll : initial vs scrolled, depending on theme
  const onScroll = () => {
    if (!header) return;
    const initial = header.dataset.bgInitial?.split(' ') ?? [];
    const scrolled = header.dataset.bgScrolled?.split(' ') ?? [];
    if (window.scrollY > 60) {
      initial.forEach((c) => header.classList.remove(c));
      scrolled.forEach((c) => header.classList.add(c));
      header.dataset.scrolled = 'true';
    } else {
      scrolled.forEach((c) => header.classList.remove(c));
      initial.forEach((c) => header.classList.add(c));
      header.dataset.scrolled = 'false';
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mega-menu : hover sur nav-item ouvre le panel correspondant. Délai de 150ms
  // sur fermeture pour ne pas perdre le menu en passant la souris vers le panel.
  const navItems = document.querySelectorAll<HTMLElement>('.nav-item-mega');
  const panels = document.querySelectorAll<HTMLElement>('.mega-panel');
  let closeTimer: number | null = null;

  const openPanel = (key: string) => {
    if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    panels.forEach((p) => {
      const isTarget = p.dataset.megaTarget === key;
      p.classList.toggle('mega-panel--open', isTarget);
      p.setAttribute('aria-hidden', isTarget ? 'false' : 'true');
    });
    navItems.forEach((it) => {
      it.classList.toggle('nav-item-mega--active', it.dataset.mega === key);
    });
  };
  const closeAll = () => {
    panels.forEach((p) => {
      p.classList.remove('mega-panel--open');
      p.setAttribute('aria-hidden', 'true');
    });
    navItems.forEach((it) => it.classList.remove('nav-item-mega--active'));
  };
  const scheduleClose = () => {
    if (closeTimer) clearTimeout(closeTimer);
    closeTimer = window.setTimeout(closeAll, 150);
  };

  navItems.forEach((it) => {
    const key = it.dataset.mega;
    if (!key) return;
    it.addEventListener('mouseenter', () => openPanel(key));
    it.addEventListener('mouseleave', scheduleClose);
    it.addEventListener('focusin', () => openPanel(key));
  });
  panels.forEach((p) => {
    p.addEventListener('mouseenter', () => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
    });
    p.addEventListener('mouseleave', scheduleClose);
  });
  // Échap ferme tout
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>

<style>
  .header-row {
    padding-top: 1rem;
    padding-bottom: 1rem;
    transition: padding 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 768px) {
    .header-row { padding-top: 1.25rem; padding-bottom: 1.25rem; }
  }
  /* État scrollé : compactage marqué */
  #siteHeader[data-scrolled="true"] .header-row {
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }
  #siteHeader[data-scrolled="true"] .header-logo {
    transform: scale(0.7);
  }
  /* Bouton search : monochrome quand header transparent au top, redevient vert/sombre quand scrolled */
  #siteHeader [data-search-trigger] {
    transition: padding 0.3s cubic-bezier(0.22, 1, 0.36, 1), font-size 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
  }
  #siteHeader[data-scrolled="false"][data-transparent-top="true"] [data-search-trigger] {
    background-color: transparent !important;
    border-color: rgba(245, 241, 234, 0.4) !important;
  }
  #siteHeader[data-scrolled="false"][data-transparent-top="true"] [data-search-trigger]:hover {
    background-color: rgba(245, 241, 234, 0.08) !important;
    border-color: rgba(245, 241, 234, 0.7) !important;
  }
  /* Boutons et CTA se resserrent aussi pour que la row diminue vraiment */
  #siteHeader .header-cta,
  #siteHeader .header-phone {
    transition: padding 0.3s cubic-bezier(0.22, 1, 0.36, 1), font-size 0.3s ease;
  }
  #siteHeader[data-scrolled="true"] [data-search-trigger] {
    padding-top: 0.3rem;
    padding-bottom: 0.3rem;
  }
  #siteHeader[data-scrolled="true"] .header-cta {
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .header-row, .header-logo, #siteHeader [data-search-trigger], #siteHeader .header-cta { transition: none; }
  }

  /* ============== MEGA-MENU ============== */
  .nav-item-mega {
    position: static;
    cursor: pointer;
  }
  .nav-item-mega .nav-mega-link svg {
    transition: transform 0.2s ease;
  }
  .nav-item-mega--active .nav-mega-link svg {
    transform: rotate(180deg);
  }
  .mega-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #F5F1EA;
    border-top: 1px solid rgba(11, 11, 15, 0.08);
    box-shadow: 0 16px 40px -20px rgba(11, 11, 15, 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.25s cubic-bezier(0.22, 1, 0.36, 1), transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.25s;
    pointer-events: none;
    z-index: 49;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }
  .mega-panel--open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .mega-panel { transition: none; }
  }
</style>
