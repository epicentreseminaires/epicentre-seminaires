---
const sectors = [
  { l: 'Industrie', s: 'Aéronautique · Automobile' },
  { l: 'Énergie', s: 'Nucléaire · ENR' },
  { l: 'Tech & Scale-up', s: 'SaaS · Hardware' },
  { l: 'Tertiaire', s: 'Banque · Assurance' },
  { l: 'Collectivités', s: 'Inaugurations · Institutions' },
  { l: 'Santé & Pharma', s: 'Conventions · Lancements' },
];
---

<section class="bg-bone py-16 border-y border-ink/10">
  <div class="container-wide">
    <p class="eyebrow text-center text-ink/40">Secteurs accompagnés</p>
    <p class="text-center text-2xl md:text-3xl mt-6 max-w-3xl mx-auto leading-tight">
      Nous produisons pour les entreprises qui ont un événement à hauteur de leur trajectoire.
    </p>
    <div class="mt-12 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-8">
      {sectors.map((sector) => (
        <div class="text-center">
          <p class="text-sm font-semibold text-ink/80">{sector.l}</p>
          <p class="text-xs text-ink/40 mt-1">{sector.s}</p>
        </div>
      ))}
    </div>
  </div>
</section>
